# Copy to .env, edit the absolute paths, then: source .env
# Use a Linux x86_64 build user and paths without spaces.
export POPSICLE_PROJECT=/absolute/path/to/pixelos/project
export POPSICLE_WORKSPACE=/absolute/path/to/pixelos
export ANDROID_TREE="$POPSICLE_WORKSPACE/android"
export POPSICLE_OUT="$ANDROID_TREE/out-pixelos-user"
export OFFICIAL_ROM=/absolute/path/to/official-full-ota.zip
export AICORE_ORIGINALS=/absolute/path/to/aicore-six-apks
export OFFICIAL_PAYLOAD="$POPSICLE_WORKSPACE/work/firmware/OS4.0.0.23.XPBCNXM/payload.bin"
export OFFICIAL_IMAGES="$POPSICLE_WORKSPACE/work/firmware/OS4.0.0.23.XPBCNXM/images"
export OFFICIAL_FILESYSTEMS="$POPSICLE_WORKSPACE/work/firmware/OS4.0.0.23.XPBCNXM/filesystems"
export PAYLOAD_DUMPER="$POPSICLE_WORKSPACE/tools/bin/payload-dumper-go"
export FSCK_EROFS="$POPSICLE_WORKSPACE/tools/erofs/bin/fsck.erofs"
export PATH="$POPSICLE_WORKSPACE/tools/bin:$PATH"
# Raise these after checking the machine's RAM and CPU capacity.
export BUILD_JOBS=8
export NINJA_HIGHMEM_NUM_JOBS=2
# Soong Go heap target for a build host with at least 64 GiB RAM.
export GOMEMLIMIT=40GiB
