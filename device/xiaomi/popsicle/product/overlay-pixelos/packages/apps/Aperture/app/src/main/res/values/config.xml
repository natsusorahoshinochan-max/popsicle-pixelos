        <item>0</item> <item>0.7</item> <item>0.7</item>
        <item>0</item> <item>2.0</item> <item>2.0</item>
        <item>0</item> <item>5.0</item> <item>5.0</item>
        <item>0</item> <item>10.0</item> <item>10.0</item>
    </string-array>
</resources>
