// SPDX-License-Identifier: Apache-2.0
aidl_interface {
    name: "popsicle-ims-audio-string",
    srcs: ["qti/audio/core/VString.aidl"],
    local_include_dir: ".",
    stability: "vintf",
    frozen: false,
    backend: {
        java: { enabled: false },
        cpp: { enabled: false },
        ndk: { enabled: true },
    },
}

cc_binary {
    name: "popsicle_ims_audio_adapter",
    system_ext_specific: true,
    init_rc: ["popsicle_ims_audio_adapter.rc"],
    srcs: ["AudioAdapter.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "av-audio-types-aidl-ndk",
        "android.hardware.audio.core-V4-ndk",
    ],
    static_libs: ["popsicle-ims-audio-string-V1-ndk"],
    cflags: ["-Wall", "-Werror"],
}
