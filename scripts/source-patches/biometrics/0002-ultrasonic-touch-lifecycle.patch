+package com.android.server.biometrics.sensors.fingerprint.aidl;
+
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Slog;
+
+import com.android.server.biometrics.sensors.BaseClientMonitor;
+import com.android.server.biometrics.sensors.ClientMonitorCallback;
+
+import java.util.Objects;
+
+/** Per-sensor ownership of the selected Xiaomi 2.0 ultrasonic touch-polling contract. */
+final class XiaomiFingerprintTouchController {
+    private static final String TAG = "XiaomiFingerprintTouch";
+    private static final String DESCRIPTOR =
+            "vendor.xiaomi.hardware.fingerprintextension.IXiaomiFingerprint";
+
+    interface Command {
+        int send(int command, int parameter) throws RemoteException;
+    }
+
+    private final Command mCommand;
+    private Object mOwner;
+    private boolean mEnrollment;
+    private boolean mRunning;
+
+    XiaomiFingerprintTouchController() {
+        this(XiaomiFingerprintTouchController::sendExtensionCommand);
+    }
+
+    XiaomiFingerprintTouchController(Command command) {
+        mCommand = Objects.requireNonNull(command);
+    }
+
+    // Calls arrive on the sensor's biometric handler. Synchronization also protects cleanup
+    // against callbacks dispatched from another thread; a stale client cannot stop its successor.
+    synchronized boolean start(Object owner, boolean enrollment, boolean keyguard) {
+        Objects.requireNonNull(owner);
+        if (mOwner == owner && mRunning) {
+            return true;
+        }
+        if (mOwner != null && !stop(mOwner)) {
+            return false;
+        }
+        mOwner = owner;
+        mEnrollment = enrollment;
+        if (!send(4, enrollment ? 1 : 3) || !send(7, keyguard ? 1 : 0)) {
+            stop(owner);
+            return false;
+        }
+        mRunning = true;
+        return true;
+    }
+
+    synchronized boolean onEnrollmentProgress(Object owner, int remaining) {
+        if (mOwner != owner || !mEnrollment || !mRunning || remaining < 0) {
+            return false;
+        }
+        // This HAL stops polling after each accepted sample, not just at session completion.
+        return remaining == 0 ? stop(owner) : send(4, 1);
+    }
+
+    synchronized boolean stop(Object owner) {
+        if (mOwner == null || mOwner != owner) {
+            return true; // The caller has no ownership of the current sensor operation.
+        }
+        mRunning = false;
+        boolean stopped = send(4, mEnrollment ? 2 : 4);
+        boolean keyguardCleared = send(7, 0);
+        if (stopped && keyguardCleared) {
+            mOwner = null;
+            return true;
+        }
+        // Retain ownership so a following start must retry cleanup before taking over.
+        return false;
+    }
+
+    synchronized void stopCurrent() {
+        if (mOwner != null && !stop(mOwner)) {
+            Slog.e(TAG, "Unable to clear touch polling after sensor shutdown");
+        }
+    }
+
+    ClientMonitorCallback wrapCallback(Object owner, ClientMonitorCallback callback) {
+        return new ClientMonitorCallback() {
+            @Override
+            public void onClientStarted(BaseClientMonitor client) {
+                callback.onClientStarted(client);
+            }
+
+            @Override
+            public void onBiometricAction(int action) {
+                callback.onBiometricAction(action);
+            }
+
+            @Override
+            public void onClientFinished(BaseClientMonitor client, boolean success) {
+                // Cleanup precedes scheduler completion; it must not stop a successor.
+                boolean stopped = stop(owner);
+                callback.onClientFinished(client, success && stopped);
+            }
+        };
+    }
+
+    private boolean send(int command, int parameter) {
+        try {
+            int result = mCommand.send(command, parameter);
+            if (result == 0) {
+                return true;
+            }
+            Slog.e(TAG, "Extension rejected " + command + "/" + parameter + ": " + result);
+        } catch (RemoteException | RuntimeException e) {
+            Slog.e(TAG, "Extension failed " + command + "/" + parameter, e);
+        }
+        return false;
+    }
+
+    private static int sendExtensionCommand(int command, int parameter) throws RemoteException {
+        // Resolve each operation instead of retaining a Binder across a HAL service restart.
+        IBinder binder = ServiceManager.checkService(DESCRIPTOR + "/default");
+        if (binder == null) {
+            throw new RemoteException("Fingerprint touch extension is unavailable");
+        }
+        return sendExtensionCommand(binder, command, parameter);
+    }
+
+    static int sendExtensionCommand(IBinder binder, int command, int parameter)
+            throws RemoteException {
+        Parcel data = Parcel.obtain(binder);
+        Parcel reply = Parcel.obtain();
+        try {
+            // Verified V1 extCmd ABI: transaction 1, two int inputs, exception header then int.
+            data.writeInterfaceToken(DESCRIPTOR);
+            data.writeInt(command);
+            data.writeInt(parameter);
+            if (!binder.transact(IBinder.FIRST_CALL_TRANSACTION, data, reply, 0)) {
+                throw new RemoteException("Fingerprint touch extension rejected transaction");
+            }
+            reply.readException();
+            return reply.readInt();
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+}
