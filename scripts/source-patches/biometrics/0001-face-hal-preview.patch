+package com.android.settings.biometrics.face;
+
+import android.graphics.SurfaceTexture;
+import android.view.Surface;
+
+/** Holds the preview producer and, after view destruction, its consumer until HAL completion. */
+final class FaceEnrollPreviewSurface {
+    private final SurfaceTexture mTexture;
+    private final Surface mSurface;
+    private boolean mInUse;
+    private boolean mClosed;
+    private boolean mTextureDetached;
+    private boolean mSurfaceReleased;
+    private boolean mTextureReleased;
+
+    FaceEnrollPreviewSurface(SurfaceTexture texture) {
+        this(texture, new Surface(texture));
+    }
+
+    FaceEnrollPreviewSurface(SurfaceTexture texture, Surface surface) {
+        mTexture = texture;
+        mSurface = surface;
+    }
+
+    boolean reopen() {
+        if (mTextureDetached || mSurfaceReleased) {
+            return false;
+        }
+        mClosed = false;
+        return true;
+    }
+
+    boolean isAvailable() {
+        return !mClosed && !mInUse && mSurface.isValid();
+    }
+
+    Surface acquire() {
+        if (!isAvailable()) {
+            throw new IllegalStateException("Preview is closed or already in use");
+        }
+        mInUse = true;
+        return mSurface;
+    }
+
+    void finish() {
+        mInUse = false;
+        releaseIfUnused();
+    }
+
+    void close() {
+        mClosed = true;
+        releaseIfUnused();
+    }
+
+    /** TextureView returned false from onSurfaceTextureDestroyed; this owner now releases it. */
+    void detachTexture() {
+        mTextureDetached = true;
+        mClosed = true;
+        releaseIfUnused();
+    }
+
+    private void releaseIfUnused() {
+        if (mInUse || !mClosed) {
+            return;
+        }
+        if (!mSurfaceReleased) {
+            mSurface.release();
+            mSurfaceReleased = true;
+        }
+        if (mTextureDetached && !mTextureReleased) {
+            mTexture.release();
+            mTextureReleased = true;
+        }
+    }
+}
