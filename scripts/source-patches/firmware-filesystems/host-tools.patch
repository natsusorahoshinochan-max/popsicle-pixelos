@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Restore the fixed A17 AVF vendor launcher contract in a separate OEM candidate.
+
+Update four old transition rules to the real *_vendor domains. Add the fixed
+vendor-use macro's process-group cleanup and crashdump-read permissions. All
+existing communication, mappings and neverallow rules remain. The complementary
+platform HAL client macros live in the device product policy and must be built;
+this transform alone is not a complete AVF or strict-policy acceptance result.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+CALLER = "vendor_avf_qcvm_manager"
+MANAGERS = ("virtualizationmanager", "early_virtmgr")
+ADDITIONS = (
+    f"(allow {CALLER} crosvm_domain (process (sigkill)))\n".encode(),
+    f"(allow {CALLER} virtualizationservice_data_file (file (read getattr)))\n".encode(),
+)
+
+
+def validate_producer(m4: Path, globals_file: Path, macros: Path) -> None:
+    result = subprocess.run([str(m4), "-Dtarget_build_variant=userdebug",
+                             "-Dtarget_full_treble=true", str(globals_file), str(macros), "-"],
+        input=f"virtualizationservice_vendor_use({CALLER})\nearly_virtmgr_vendor_use({CALLER})\n",
+        capture_output=True, text=True, check=True)
+    source = re.sub(r"#[^\n]*", "", result.stdout)
+    statements = [" ".join(statement.split()) for statement in source.split(";")]
+    expected = [f"allow {CALLER} crosvm_domain:process sigkill",
+                f"allow {CALLER} virtualizationservice_data_file:file {{ getattr read }}"]
+    for manager in MANAGERS:
+        expected.extend([f"allow {CALLER} {manager}_vendor:process transition",
+            f"type_transition {CALLER} {manager}_exec:process {manager}_vendor"])
+    if any(statements.count(statement) != 1 for statement in expected):
+        raise ValueError("fixed AVF vendor-use producer contract changed")
+
+
+def adapt(data: bytes) -> tuple[bytes, int]:
+    if not data.endswith(b"\n"):
+        raise ValueError("OEM CIL must end with a newline")
+    lines = data.splitlines(keepends=True)
+    replacements = {}
+    for manager in MANAGERS:
+        allow = f"(allow {CALLER} {manager}_202504 (process (transition)))\n".encode()
+        transition = f"(typetransition {CALLER} {manager}_exec_202504 process {manager})\n".encode()
+        if lines.count(allow) != 1 or lines.count(transition) != 1:
+            raise ValueError(f"unexpected OEM launcher transition: {manager}")
+        replacements[allow] = allow.replace(f"{manager}_202504".encode(), f"{manager}_vendor".encode())
+        replacements[transition] = transition.replace(f"process {manager})".encode(),
+                                                      f"process {manager}_vendor)".encode())
+    if any(rule in lines for rule in ADDITIONS):
+        raise ValueError("AVF supplementary contract already present")
+    return b"".join(replacements.get(line, line) for line in lines) + b"".join(ADDITIONS), 4
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--m4", required=True, type=Path)
+    parser.add_argument("--global-macros", required=True, type=Path)
+    parser.add_argument("--macros", required=True, type=Path)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    validate_producer(args.m4, args.global_macros, args.macros)
+    result, count = adapt(args.source.read_bytes())
+    with args.output.open("xb") as output:
+        output.write(result)
+    print(json.dumps({"changed_transition_rules": count, "added_macro_rules": len(ADDITIONS),
+                      "status": "candidate; platform HAL macros, strict and runtime checks required"}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/popsicle/policy/adapt_vendor_property_policy.py b/popsicle/policy/adapt_vendor_property_policy.py
new file mode 100644
--- /dev/null
+++ b/popsicle/policy/adapt_vendor_property_policy.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Adapt four old public property guards to their actual current providers.
+
+The current platform grants init_dev_config three configuration-property writes
+and vendor_init the 16-KiB property write. Old versioned guards predate those
+providers. Preserve every guard, its target/permission, and shared source sets;
+only four guards receive private source sets excluding the proven new writer.
+No allow rule is added. This changes writer restrictions and is only a candidate.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+
+
+CONTRACTS = {
+    "apexd_select_prop": ("base_typeattr_233_202504", "init_dev_config",
+                          "popsicle_config_prop_forbidden_writers"),
+    "media_variant_prop": ("base_typeattr_233_202504", "init_dev_config",
+                           "popsicle_config_prop_forbidden_writers"),
+    "telephony_config_prop": ("base_typeattr_233_202504", "init_dev_config",
+                              "popsicle_config_prop_forbidden_writers"),
+    "enable_16k_pages_prop": ("base_typeattr_232_202504", "vendor_init",
+                              "popsicle_16k_prop_forbidden_writers"),
+}
+SOURCE_SETS = (
+    b"(typeattributeset base_typeattr_233_202504 (and (domain) (not (init_202504 vendor_init_202504))))\n",
+    b"(typeattributeset base_typeattr_232_202504 (and (domain) (not (coredomain))))\n",
+)
+
+
+def sole_set(data: bytes, attribute: str, expected: bytes) -> bool:
+    # CIL accepts multiple additive definitions. Inspect every occurrence of the
+    # named set, including noncanonical whitespace and comments between tokens.
+    # Preserve strings while removing line comments from this parsing view only.
+    parsing = re.sub(rb'"(?:\\.|[^"\\])*"|;[^\n]*',
+                     lambda match: b" " if match[0].startswith(b";") else match[0], data)
+    definitions = re.findall(rb"\(\s*typeattributeset\s+" + re.escape(attribute.encode())
+                             + rb"(?=[\s()])", parsing)
+    return len(definitions) == 1 and data.splitlines(keepends=True).count(expected) == 1
+
+
+def adapt(data: bytes, platform: bytes, mapping: bytes) -> tuple[bytes, int]:
+    if not data.endswith(b"\n"):
+        raise ValueError("OEM CIL must end with a newline before new definitions")
+    lines = data.splitlines(keepends=True)
+    platform_lines = platform.splitlines(keepends=True)
+    if any(not sole_set(data, expression.split()[1].decode(), expression)
+           for expression in SOURCE_SETS):
+        raise ValueError("old public property source sets changed")
+    replacements = {}
+    declarations = {}
+    for prop, (source, writer, private) in CONTRACTS.items():
+        if private.encode() in data:
+            raise ValueError("derived property source set already exists")
+        allow = f"(allow {writer} {prop} (property_service (set)))\n".encode()
+        mapped = f"(typeattributeset {prop}_202504 ({prop}))\n".encode()
+        if platform_lines.count(allow) != 1 or not sole_set(mapping, prop + "_202504", mapped):
+            raise ValueError(f"actual provider or 202504 property mapping changed: {prop}")
+        guard = f"(neverallow {source} {prop}_202504 (property_service (set)))\n".encode()
+        if lines.count(guard) != 1:
+            raise ValueError(f"old property guard changed: {prop}")
+        replacements[guard] = guard.replace(source.encode(), private.encode(), 1)
+        declarations[private] = (
+            f"(typeattribute {private})\n"
+            f"(typeattributeset {private} (and ({source}) (not ({writer}))))\n"
+        ).encode()
+    # Definitions can follow their references in CIL. The old shared sets and all
+    # other guards retain their bytes, including restrictions on other properties.
+    result = b"".join(replacements.get(line, line) for line in lines)
+    return result + b"".join(declarations.values()), len(replacements)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--platform-cil", required=True, type=Path)
+    parser.add_argument("--mapping", required=True, type=Path)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    result, count = adapt(args.source.read_bytes(), args.platform_cil.read_bytes(),
+                          args.mapping.read_bytes())
+    with args.output.open("xb") as output:
+        output.write(result)
+    print(json.dumps({"adapted_property_guards": count,
+                      "status": "candidate; full strict and device validation pending"}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/popsicle/policy/derive_vendor_app_debug_policy.py b/popsicle/policy/derive_vendor_app_debug_policy.py
new file mode 100644
--- /dev/null
+++ b/popsicle/policy/derive_vendor_app_debug_policy.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Derive the fixed OEM app_domain ptrace guards for the actual build variant.
+
+Every neverallow remains intact. Only fifteen private, unshared source-set
+expressions may acquire the llkd exclusion produced by the fixed AOSP macro for
+userdebug/eng. This expands debug watchdog access and is not a strict-policy pass.
+The original firmware is never modified; output creation is exclusive.
+"""
+
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+APPS = {
+    "278": "vendor_cacertservice_app", "288": "vendor_cs_app",
+    "309": "vendor_embmssl_app", "342": "vendor_imshelper_app",
+    "352": "vendor_poweroffalarm_app", "358": "vendor_qtidataservices_app",
+    "367": "vendor_timeservice_app", "371": "vendor_tzas_app",
+    "451": "vendor_perfdump_app", "455": "vendor_powerservice_app",
+    "472": "vendor_qms_app", "513": "vendor_powermodule_app",
+    "518": "theme", "544": "mslg_app", "571": "cameramind_app",
+}
+MACRO_APP = "popsicle_contract_app"
+
+
+def macro_exclusions(m4: Path, macros: Path, variant: str) -> set[str]:
+    """Read the actual m4 producer, including its user-build suppression markers."""
+    if variant not in {"user", "userdebug", "eng"}:
+        raise ValueError("unknown build variant")
+    result = subprocess.run(
+        [str(m4), "-Dtarget_build_variant=" + variant, str(macros), "-"],
+        input=f"app_domain({MACRO_APP})\n", capture_output=True, text=True, check=True,
+    )
+    policy = re.sub(r"#[^\n]*", "", result.stdout)
+    guards = re.findall(
+        r"neverallow\s*\{([^{}]+)\}\s*" + MACRO_APP + r":process\s+ptrace\s*;",
+        policy,
+    )
+    if len(guards) != 1:
+        raise ValueError("app_domain must produce exactly one ptrace guard")
+    tokens = guards[0].split()
+    expected = {"domain", "-" + MACRO_APP, "-crash_dump", "-runas_app", "-simpleperf"}
+    if variant != "user":
+        expected.add("-llkd")
+    if set(tokens) != expected or len(tokens) != len(expected):
+        raise ValueError("fixed app_domain ptrace contract changed")
+    return {token[1:] for token in tokens if token.startswith("-")}
+
+
+def derive(data: bytes, variant: str) -> tuple[bytes, int]:
+    if variant not in {"user", "userdebug", "eng"}:
+        raise ValueError("unknown build variant")
+    lines = data.splitlines(keepends=True)
+    tokens = Counter(re.findall(rb"[A-Za-z_][A-Za-z_0-9]*", data))
+    replacements = {}
+    for number, app in APPS.items():
+        attribute = f"base_typeattr_{number}_202504"
+        declaration = f"(typeattribute {attribute})\n".encode()
+        expression = (f"(typeattributeset {attribute} (and (domain) (not "
+                      f"(crash_dump_202504 runas_app_202504 simpleperf_202504 {app}))))\n").encode()
+        guard = f"(neverallow {attribute} {app} (process (ptrace)))\n".encode()
+        # Exactly the declaration, set definition and single guard may refer to
+        # this attribute. Never broaden a set also used by another policy rule.
+        if tokens[attribute.encode()] != 3 or any(lines.count(line) != 1 for line in
+                                                (declaration, expression, guard)):
+            raise ValueError(f"unexpected or shared OEM app guard: {app}")
+        if variant != "user":
+            replacements[expression] = expression.replace(b"(not (", b"(not (llkd ", 1)
+    return b"".join(replacements.get(line, line) for line in lines), len(replacements)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--m4", type=Path, required=True)
+    parser.add_argument("--macros", type=Path, required=True)
+    parser.add_argument("--build-variant", choices=("user", "userdebug", "eng"), required=True)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    # Verify both sides of the producer contract, not just the requested variant.
+    macro_exclusions(args.m4, args.macros, "user")
+    macro_exclusions(args.m4, args.macros, "userdebug")
+    if args.build_variant == "eng":
+        macro_exclusions(args.m4, args.macros, "eng")
+    candidate, changed = derive(args.source.read_bytes(), args.build_variant)
+    with args.output.open("xb") as output:
+        output.write(candidate)
+    print(json.dumps({"changed_private_sets": changed, "variant": args.build_variant,
+                      "status": "candidate; full strict and device validation pending"}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/popsicle/policy/derive_vendor_codec_debug_policy.py b/popsicle/policy/derive_vendor_codec_debug_policy.py
new file mode 100644
--- /dev/null
+++ b/popsicle/policy/derive_vendor_codec_debug_policy.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Preserve the OEM codec network guards while restoring its debug su exception.
+
+The same-version QSSI mediacodec.te is the producer: user forbids all TCP peers,
+userdebug/eng excludes su for Binder-over-TCP debugging. No permission is added;
+all existing neverallow permissions, UDP/raw-IP and execution guards remain.
+Only separate candidate output is permitted. Full strict/runtime checks follow.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+PEERS = "popsicle_mediacodec_tcp_peers"
+PERMISSIONS = ("ioctl read write create getattr setattr lock relabelfrom relabelto append map "
+               "bind connect listen accept getopt setopt shutdown recvfrom sendto name_bind "
+               "node_bind name_connect")
+GUARD = f"(neverallow mediacodec domain (tcp_socket ({PERMISSIONS})))\n".encode()
+
+
+def validate_producer(m4: Path, macros: Path, codec: Path, variant: str) -> None:
+    if variant not in {"user", "userdebug", "eng"}:
+        raise ValueError("unknown build variant")
+    result = subprocess.run([str(m4), "-Dtarget_build_variant=" + variant,
+                             str(macros), str(codec)], capture_output=True, text=True, check=True)
+    policy = re.sub(r"#[^\n]*", "", result.stdout)
+    guards = re.findall(r"neverallow\s+mediacodec\s*\{([^{}]*)\}:tcp_socket\s*\*\s*;", policy)
+    expected = ["domain"] if variant == "user" else ["domain", "-su"]
+    if len(guards) != 1 or guards[0].split() != expected:
+        raise ValueError("same-version codec network producer contract changed")
+
+
+def derive(data: bytes, variant: str) -> tuple[bytes, int]:
+    if variant not in {"user", "userdebug", "eng"}:
+        raise ValueError("unknown build variant")
+    if data.splitlines(keepends=True).count(GUARD) != 1 or PEERS.encode() in data:
+        raise ValueError("unexpected OEM codec guard or existing derived peer attribute")
+    if variant == "user":
+        return data, 0
+    declaration = (f"(typeattribute {PEERS})\n"
+                   f"(typeattributeset {PEERS} (and (domain) (not (su))))\n").encode()
+    guard = GUARD.replace(b"mediacodec domain ", f"mediacodec {PEERS} ".encode(), 1)
+    return b"".join(declaration + guard if line == GUARD else line
+                    for line in data.splitlines(keepends=True)), 1
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--m4", required=True, type=Path)
+    parser.add_argument("--macros", required=True, type=Path)
+    parser.add_argument("--codec-source", required=True, type=Path)
+    parser.add_argument("--build-variant", choices=("user", "userdebug", "eng"), required=True)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    for variant in {"user", "userdebug", args.build_variant}:
+        validate_producer(args.m4, args.macros, args.codec_source, variant)
+    data, changed = derive(args.source.read_bytes(), args.build_variant)
+    with args.output.open("xb") as output:
+        output.write(data)
+    print(json.dumps({"changed_peer_guards": changed, "variant": args.build_variant,
+                      "status": "candidate; full strict and device validation pending"}))
+
+
+if __name__ == "__main__":
+    main()
