+static jintArray nativeGetArrDisplayModeIds(JNIEnv* env, jclass, jlong displayId) {
+    std::vector<int32_t> modeIds;
+    const auto service = interface_cast<gui::ISurfaceComposer>(
+            defaultServiceManager()->checkService(String16("SurfaceFlinger")));
+    if (service == nullptr || !service->getArrDisplayModeIds(displayId, &modeIds).isOk()) {
+        modeIds.clear();
+    }
+    jintArray result = env->NewIntArray(modeIds.size());
+    if (result != nullptr && !modeIds.empty()) {
+        env->SetIntArrayRegion(result, 0, modeIds.size(), modeIds.data());
+    }
+    return result;
+}
