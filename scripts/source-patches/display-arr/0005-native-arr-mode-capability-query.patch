+binder::Status SurfaceComposerAIDL::getArrDisplayModeIds(
+        int64_t displayId, std::vector<int32_t>* modeIds) {
+    status_t status = checkAccessPermission();
+    if (status != OK) return binderStatusFromStatusT(status);
+    Mutex::Autolock lock(mFlinger->mStateLock);
+    const auto id = PhysicalDisplayId::fromValue(static_cast<uint64_t>(displayId));
+    const auto displayOpt = mFlinger->mPhysicalDisplays.get(id).and_then(
+            mFlinger->getDisplayDeviceAndSnapshot());
+    if (!displayOpt) return binderStatusFromStatusT(NAME_NOT_FOUND);
+    modeIds->clear();
+    for (const auto& [modeId, mode] : displayOpt->second.get().displayModes()) {
+        if (mode->getVrrConfig().has_value()) {
+            modeIds->push_back(ftl::to_underlying(modeId));
+        }
+    }
+    return binder::Status::ok();
+}
