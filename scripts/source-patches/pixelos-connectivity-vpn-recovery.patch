+    /**
+     * Atomically replace the VPN ingress rules owned by PermissionMonitor for one UID.
+     *
+     * IIF_MATCH takes precedence over LOCKDOWN_VPN_MATCH in the packet filter, including a
+     * wildcard interface. Updating both fields together prevents a failed second write from
+     * leaving a wildcard rule that bypasses the requested lockdown. Other chains retain their
+     * bits. The interface name is resolved on every attempt, including after interface recreation.
+     */
+    public void setUidVpnRules(final int uid, final boolean lockdown,
+            final boolean hasInterfaceRule, @Nullable final String ifName) {
+        throwIfPreT("setUidVpnRules is not available on pre-T devices");
+        final int ifIndex = hasInterfaceRule && ifName != null ? mDeps.getIfIndex(ifName) : 0;
+        if (hasInterfaceRule && ifName != null && ifIndex == 0) {
+            throw new ServiceSpecificException(ENODEV,
+                    "Failed to get index of interface " + ifName);
+        }
+        try {
+            synchronized (sUidOwnerMap) {
+                final S32 key = new S32(uid);
+                final UidOwnerValue oldValue = sUidOwnerMap.getValue(key);
+                final long otherRules = oldValue == null ? 0
+                        : oldValue.rule & ~(IIF_MATCH | LOCKDOWN_VPN_MATCH);
+                final long rules = otherRules | (hasInterfaceRule ? IIF_MATCH : 0)
+                        | (lockdown ? LOCKDOWN_VPN_MATCH : 0);
+                if (rules == 0) {
+                    if (oldValue != null) sUidOwnerMap.deleteEntry(key);
+                } else {
+                    sUidOwnerMap.updateEntry(key, new UidOwnerValue(ifIndex, rules));
+                }
+            }
+        } catch (ErrnoException e) {
+            throw new ServiceSpecificException(e.errno,
+                    "setUidVpnRules failed for uid " + uid + ": " + Os.strerror(e.errno));
+        }
+    }
