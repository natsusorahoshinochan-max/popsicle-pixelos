+  // Only provider codecs negotiate an audio-context hint. Legacy codecs (including
+  // hardware-offloaded AAC) do not consume it; restarting their session interrupts
+  // playback without changing the codec. Keep the independent latency request above.
+  void UpdateAudioContext(const RawAddress& peer_address, bool low_latency) {
+    A2dpCodecConfig* codec = bta_av_get_a2dp_current_codec();
+    if (codec == nullptr || !codec->isHardwareProviderCodec()) {
+      return;
+    }
+    auto config = codec->getCodecUserConfig();
+    const auto context = low_latency ? BTAV_A2DP_CODEC_AUDIO_CONTEXT_GAME
+                                     : BTAV_A2DP_CODEC_AUDIO_CONTEXT_MEDIA;
+    // Compare against the codec's committed preference, not an optimistic peer bit.
+    // A failed negotiation restores this preference and remains eligible for retry.
+    if (config.audio_context == context) {
+      return;
+    }
+    config.codec_type = codec->codecIndex();
+    config.audio_context = context;
+    // Retain the user's priority, sample rate, depth, channels and codec specifics.
+    std::promise<void> ready;
+    UpdateCodecConfig(peer_address, {config}, std::move(ready));
   }
 
