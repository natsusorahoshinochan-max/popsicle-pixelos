+package android.util;
+
+import android.content.res.Resources;
+import android.os.SystemProperties;
+
+/**
+ * Density contract used by the original MAML resource loader.
+ *
+ * @hide
+ */
+public final class MiuiDisplayMetrics {
+    public static final int DENSITY_NXHGITH = 440;
+    public static final String PROP_MIUI_DENSITY = "persist.miui.density_v2";
+
+    @Deprecated
+    public static int DENSITY_DEVICE = getMiuiDeviceDensity();
+
+    public MiuiDisplayMetrics() {}
+
+    public static int getFactoryDeviceDensity() {
+        return SystemProperties.getInt("ro.sf.lcd_density", DisplayMetrics.DENSITY_DEFAULT);
+    }
+
+    private static int getMiuiDeviceDensity() {
+        return SystemProperties.getInt(PROP_MIUI_DENSITY, getFactoryDeviceDensity());
+    }
+
+    public static final int getNxhdpiDensity() {
+        return DENSITY_NXHGITH;
+    }
+
+    public static boolean setOverlayDensity(int overlayDensity) {
+        final int factoryDensity = getFactoryDeviceDensity();
+        if (factoryDensity / 1.5f > overlayDensity
+                || overlayDensity > factoryDensity * 1.5d
+                || Resources.getSystem().getDisplayMetrics().densityDpi == overlayDensity) {
+            return false;
+        }
+        // Preserve the property service's permission checks and read-back.
+        SystemProperties.set(PROP_MIUI_DENSITY, Integer.toString(overlayDensity));
+        return SystemProperties.getInt(PROP_MIUI_DENSITY, -1) == overlayDensity;
+    }
+}
