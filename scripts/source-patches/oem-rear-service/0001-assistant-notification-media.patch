+package com.android.systemui.subscreen;
+
+import android.os.Bundle;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Original top-media ordering, independent of the main screen carousel's presentation order. */
+public final class OemRearMediaState {
+    private static final class Entry {
+        final Bundle data;
+        final boolean resumption;
+        final long updated;
+        final long lastActive;
+        Entry(Bundle data, boolean resumption, long updated, long lastActive) {
+            this.data = new Bundle(data);
+            this.resumption = resumption;
+            this.updated = updated;
+            this.lastActive = lastActive;
+        }
+    }
+
+    private final Map<String, Entry> mEntries = new HashMap<>();
+    private String mDismissedPackage;
+
+    public void clear() {
+        mEntries.clear();
+        mDismissedPackage = null;
+    }
+
+    public void retainKeys(java.util.Set<String> keys) {
+        mEntries.keySet().retainAll(keys);
+    }
+
+    public void update(String key, String oldKey, Bundle data, boolean resumption,
+            long updated, long lastActive) {
+        if (oldKey != null && !oldKey.equals(key)) mEntries.remove(oldKey);
+        String pkg = data.getString("packageName");
+        boolean active = data.getBoolean("active");
+        if (pkg != null && pkg.equals(mDismissedPackage) && active
+                && data.getBoolean("isPlaying")) mDismissedPackage = null;
+        if (active && !java.util.Objects.equals(pkg, mDismissedPackage)) {
+            mEntries.put(key, new Entry(data, resumption, updated, lastActive));
+        } else {
+            mEntries.remove(key);
+        }
+    }
+
+    public void remove(String key, boolean userInitiated) {
+        Entry removed = mEntries.remove(key);
+        if (userInitiated && removed != null) {
+            mDismissedPackage = removed.data.getString("packageName");
+            mEntries.values().removeIf(e -> java.util.Objects.equals(
+                    mDismissedPackage, e.data.getString("packageName")));
+        }
+    }
+
+    public Bundle top() {
+        Entry top = null;
+        for (Entry entry : mEntries.values()) {
+            if (top == null || compare(entry, top) > 0) top = entry;
+        }
+        return top == null ? null : new Bundle(top.data);
+    }
+
+    private static int compare(Entry a, Entry b) {
+        for (int location = 0; location <= 1; location++) {
+            int c = Boolean.compare(playingAt(a, location), playingAt(b, location));
+            if (c != 0) return c;
+        }
+        int c = Boolean.compare(a.data.getBoolean("active"), b.data.getBoolean("active"));
+        if (c != 0) return c;
+        c = Boolean.compare(!a.resumption, !b.resumption);
+        if (c != 0) return c;
+        c = Boolean.compare(a.data.getInt("playbackLocation") != 2,
+                b.data.getInt("playbackLocation") != 2);
+        if (c != 0) return c;
+        c = Long.compare(a.updated, b.updated);
+        if (c != 0) return c;
+        c = Long.compare(a.lastActive, b.lastActive);
+        if (c != 0) return c;
+        String ak = a.data.getString("notificationKey");
+        String bk = b.data.getString("notificationKey");
+        return ak == null ? (bk == null ? 0 : -1) : bk == null ? 1 : ak.compareTo(bk);
+    }
+
+    private static boolean playingAt(Entry entry, int location) {
+        return entry.data.getBoolean("isPlaying")
+                && entry.data.getInt("playbackLocation") == location;
+    }
+}
