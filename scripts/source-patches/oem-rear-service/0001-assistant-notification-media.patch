+package com.android.systemui.subscreen;
+
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.Parcelable;
+import android.os.RemoteException;
+
+/** Wire boundary of the original APK. The assistant owns card parsing and actions. */
+public final class OemRearServiceProtocol {
+    public static final String DESCRIPTOR = "com.xiaomi.subscreencenter.service.ISubScreen";
+
+    private OemRearServiceProtocol() {}
+
+    public static Bundle filterExtras(Bundle source) {
+        Bundle result = new Bundle();
+        for (String key : source.keySet()) {
+            if (!key.startsWith("miui.")) continue;
+            Object value = source.get(key);
+            if (value == null || value instanceof String) result.putString(key, (String) value);
+            else if (value instanceof Bundle) result.putBundle(key, new Bundle((Bundle) value));
+            else if (value instanceof Parcelable) result.putParcelable(key, (Parcelable) value);
+            else if (value instanceof CharSequence) {
+                result.putCharSequence(key, (CharSequence) value);
+            } else if (value instanceof Integer) result.putInt(key, (Integer) value);
+            else if (value instanceof Long) result.putLong(key, (Long) value);
+            else if (value instanceof Boolean) result.putBoolean(key, (Boolean) value);
+            else if (value instanceof Float) result.putFloat(key, (Float) value);
+            else if (value instanceof Double) result.putDouble(key, (Double) value);
+            else result.putString(key, value.toString());
+        }
+        return result;
+    }
+
+    public static void notification(IBinder service, int id, String pkg, String key,
+            Bundle extras, boolean removed) throws RemoteException {
+        Parcel data = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            data.writeInt(id);
+            data.writeString(pkg);
+            data.writeString(key);
+            if (!removed) data.writeTypedObject(extras, 0);
+            send(service, removed ? 4 : 3, data);
+        } finally {
+            data.recycle();
+        }
+    }
+
+    public static void media(IBinder service, Bundle media) throws RemoteException {
+        Parcel data = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            data.writeTypedObject(media, 0);
+            send(service, 6, data);
+        } finally {
+            data.recycle();
+        }
+    }
+
+    private static void send(IBinder service, int code, Parcel data) throws RemoteException {
+        if (!service.transact(code, data, null, IBinder.FLAG_ONEWAY)) {
+            throw new RemoteException("ISubScreen rejected transaction " + code);
+        }
+    }
+}
