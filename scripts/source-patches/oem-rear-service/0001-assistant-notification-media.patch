+
+package com.android.systemui.subscreen
+
+import android.content.BroadcastReceiver
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.ServiceConnection
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.content.pm.UserInfo
+import android.os.Bundle
+import android.os.Handler
+import android.os.IBinder
+import android.os.RemoteException
+import android.os.UserHandle
+import android.service.notification.NotificationListenerService.RankingMap
+import android.service.notification.StatusBarNotification
+import android.util.Log
+import com.android.systemui.CoreStartable
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Background
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.media.controls.domain.pipeline.MediaDataManager
+import com.android.systemui.media.controls.shared.model.MediaData
+import com.android.systemui.settings.UserTracker
+import com.android.systemui.statusbar.NotificationListener
+import java.util.concurrent.Executor
+import javax.inject.Inject
+
+/** Feeds the original assistant. All connection and wire state is owned by [worker]. */
+@SysUISingleton
+class OemRearService @Inject constructor(
+    private val context: Context,
+    private val userTracker: UserTracker,
+    private val notifications: NotificationListener,
+    private val media: MediaDataManager,
+    @Main private val mainExecutor: Executor,
+    @Background private val worker: Handler,
+) : CoreStartable {
+    private data class Notice(val user: Int, val id: Int, val pkg: String, val key: String,
+        val extras: Bundle)
+
+    private var user = UserHandle.USER_NULL
+    private var profiles = emptySet<Int>()
+    private val notices = linkedMapOf<String, Notice>()
+    private val delivered = linkedMapOf<String, Notice>()
+    private val mediaState = OemRearMediaState()
+    private var connection: Connection? = null
+    private var retryDelay = 1000L
+    private val retry = Runnable { bind() }
+
+    override fun start() {
+        if (!context.resources.getBoolean(
+                com.android.internal.R.bool.config_oemRearSmartAssistantSupported)) return
+        userTracker.addCallback(userCallback, mainExecutor)
+        notifications.addNotificationHandler(notificationHandler)
+        media.addListener(mediaListener)
+        val packages = IntentFilter().apply {
+            addAction(Intent.ACTION_PACKAGE_ADDED)
+            addAction(Intent.ACTION_PACKAGE_REMOVED)
+            addAction(Intent.ACTION_PACKAGE_CHANGED)
+            addAction(Intent.ACTION_PACKAGE_REPLACED)
+            addDataScheme("package")
+        }
+        context.registerReceiverAsUser(packageReceiver, UserHandle.ALL, packages, null, worker)
+        context.registerReceiverAsUser(unlockReceiver, UserHandle.ALL,
+            IntentFilter(Intent.ACTION_USER_UNLOCKED), null, worker)
+        refreshUser()
+    }
+
+    private val userCallback = object : UserTracker.Callback {
+        override fun onBeforeUserSwitching(newUser: Int) {
+            worker.post { switchUser(UserHandle.USER_NULL, emptySet()) }
+        }
+        override fun onUserChanged(newUser: Int, userContext: Context) = refreshUser()
+        override fun onProfilesChanged(profiles: List<UserInfo>) = refreshUser()
+    }
+
+    // Capture on the main executor, after producer callbacks already queued by UserTracker.
+    private fun refreshUser() {
+        mainExecutor.execute {
+            if (userTracker.isUserSwitching) return@execute
+            val nextUser = userTracker.userId
+            val nextProfiles = userTracker.userProfiles
+                .filter { it.isEnabled && !it.isQuietModeEnabled }.map { it.id }.toSet()
+            val active = try { notifications.activeNotifications } catch (e: SecurityException) {
+                Log.w(TAG, "Notification snapshot unavailable", e)
+                null
+            }
+            val initial = active?.mapNotNull { snapshot(it) }
+            val entries = media.getCurrentUserMedia()
+            worker.post {
+                switchUser(nextUser, nextProfiles)
+                if (initial != null) {
+                    val activeKeys = active.filter { allowed(it.userId) }.map { it.key }.toSet()
+                    notices.keys.retainAll(activeKeys)
+                    initial.filter { allowed(it.user) && !it.extras.isEmpty }
+                        .forEach { notices[it.key] = it }
+                }
+                mediaState.retainKeys(entries.keys)
+                entries.forEach { (key, data) ->
+                    if (allowed(data.userId)) updateMedia(key, null, data)
+                }
+                flush()
+                bind()
+            }
+        }
+    }
+
+    private fun snapshot(sbn: StatusBarNotification): Notice? = try {
+        Notice(sbn.userId, sbn.id, sbn.packageName, sbn.key,
+            OemRearServiceProtocol.filterExtras(sbn.notification.extras).deepCopy())
+    } catch (e: RuntimeException) {
+        Log.w(TAG, "Cannot decode rear notification " + sbn.key, e)
+        null
+    }
+
+    private fun allowed(id: Int) = id == UserHandle.USER_ALL || id in profiles
+
+    private val notificationHandler = object : NotificationListener.NotificationHandler {
+        override fun onNotificationPosted(sbn: StatusBarNotification, ranking: RankingMap) {
+            val owner = userTracker.userId
+            val notice = snapshot(sbn) ?: return
+            worker.post {
+                if (user != owner || !allowed(notice.user) || notice.extras.isEmpty) return@post
+                notices[notice.key] = notice
+                send { OemRearServiceProtocol.notification(it, notice.id, notice.pkg,
+                    notice.key, notice.extras, false); delivered[notice.key] = notice }
+            }
+        }
+        override fun onNotificationRemoved(sbn: StatusBarNotification, ranking: RankingMap) =
+            onNotificationRemoved(sbn, ranking, 0)
+        override fun onNotificationRemoved(sbn: StatusBarNotification, ranking: RankingMap,
+            reason: Int) {
+            val owner = userTracker.userId
+            worker.post {
+                if (user != owner || !allowed(sbn.userId)) return@post
+                notices.remove(sbn.key)
+                send { OemRearServiceProtocol.notification(it, sbn.id, sbn.packageName,
+                    sbn.key, null, true); delivered.remove(sbn.key) }
+            }
+        }
+        override fun onNotificationRankingUpdate(ranking: RankingMap) {}
+        override fun onNotificationsInitialized() = refreshUser()
+    }
+
+    private val mediaListener = object : MediaDataManager.Listener {
+        override fun onMediaDataLoaded(key: String, oldKey: String?, data: MediaData,
+            immediately: Boolean) {
+            val owner = userTracker.userId
+            val copy = data.copy()
+            worker.post {
+                if (user != owner || !allowed(copy.userId)) return@post
+                updateMedia(key, oldKey, copy)
+                send { OemRearServiceProtocol.media(it, mediaState.top()) }
+            }
+        }
+        override fun onMediaDataRemoved(key: String, userInitiated: Boolean) {
+            val owner = userTracker.userId
+            worker.post {
+                if (user != owner) return@post
+                mediaState.remove(key, userInitiated)
+                send { OemRearServiceProtocol.media(it, mediaState.top()) }
+            }
+        }
+    }
+
+    private fun updateMedia(key: String, oldKey: String?, data: MediaData) {
+        val bundle = Bundle().apply {
+            putInt("userId", data.userId)
+            putString("app", data.app)
+            putCharSequence("artist", data.artist)
+            putCharSequence("song", data.song)
+            putString("packageName", data.packageName)
+            putBoolean("active", data.active)
+            putInt("playbackLocation", data.playbackLocation)
+            putString("notificationKey", data.notificationKey)
+            putInt("appUid", data.appUid)
+            data.isPlaying?.let { putBoolean("isPlaying", it) }
+            data.appIcon?.let { putParcelable("appIcon", it) }
+            data.artwork?.let { putParcelable("artwork", it) }
+            data.token?.let { putParcelable("token", it) }
+            data.clickIntent?.let { putParcelable("clickIntent", it) }
+        }
+        mediaState.update(key, oldKey, bundle, data.resumption,
+            System.currentTimeMillis(), data.lastActive)
+    }
+
+    private fun switchUser(next: Int, nextProfiles: Set<Int>) {
+        if (user == next && profiles == nextProfiles) return
+        // Clear data from the previous profile set before its connection is released.
+        notices.clear()
+        mediaState.clear()
+        flush()
+        disconnect()
+        delivered.clear()
+        user = next
+        profiles = nextProfiles
+        retryDelay = 1000
+    }
+
+    private fun flush() {
+        send { binder ->
+            delivered.values.toList().filter { it.key !in notices }.forEach {
+                OemRearServiceProtocol.notification(binder, it.id, it.pkg, it.key, null, true)
+                delivered.remove(it.key)
+            }
+            notices.values.forEach {
+                OemRearServiceProtocol.notification(binder, it.id, it.pkg, it.key, it.extras, false)
+                delivered[it.key] = it
+            }
+            OemRearServiceProtocol.media(binder, mediaState.top())
+        }
+    }
+
+    private fun send(action: (IBinder) -> Unit) {
+        val binder = connection?.binder ?: return
+        try {
+            action(binder)
+        } catch (e: RemoteException) {
+            Log.w(TAG, "Assistant transaction failed", e)
+            reconnect()
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "Assistant payload rejected", e)
+        }
+    }
+
+    private fun bind() {
+        if (connection != null || user == UserHandle.USER_NULL) return
+        worker.removeCallbacks(retry)
+        val userContext = context.createContextAsUser(UserHandle.of(user), 0)
+        val intent = Intent(SERVICE).setComponent(ComponentName(PACKAGE, SERVICE))
+        val pm = userContext.packageManager
+        val service = pm.resolveService(intent, PackageManager.MATCH_DIRECT_BOOT_AWARE
+            or PackageManager.MATCH_DIRECT_BOOT_UNAWARE)?.serviceInfo
+        if (service == null || !service.enabled || !service.applicationInfo.enabled || !service.exported
+            || service.permission != PERMISSION
+            || service.applicationInfo.flags and ApplicationInfo.FLAG_SYSTEM == 0
+            || pm.checkSignatures(PACKAGE, "android") != PackageManager.SIGNATURE_MATCH) return
+        val next = Connection(userContext)
+        connection = next
+        try {
+            next.bound = userContext.bindService(intent, next, Context.BIND_AUTO_CREATE)
+            if (next.bound) worker.postDelayed(next.timeout, 10000) else reconnect()
+        } catch (e: SecurityException) {
+            Log.e(TAG, "Assistant binding permission denied", e)
+            disconnect()
+        }
+    }
+
+    private fun disconnect() {
+        worker.removeCallbacks(retry)
+        val old = connection ?: return
+        connection = null
+        worker.removeCallbacks(old.timeout)
+        old.binder?.unlinkToDeath(old, 0)
+        if (old.bound) old.owner.unbindService(old)
+    }
+
+    private fun reconnect() {
+        disconnect()
+        if (user == UserHandle.USER_NULL) return
+        worker.postDelayed(retry, retryDelay)
+        retryDelay = (retryDelay * 2).coerceAtMost(60000)
+    }
+
+    private inner class Connection(val owner: Context) : ServiceConnection, IBinder.DeathRecipient {
+        var bound = false
+        var binder: IBinder? = null
+        val timeout = Runnable { if (connection === this) reconnect() }
+        override fun onServiceConnected(name: ComponentName, service: IBinder) {
+            worker.post {
+                if (connection !== this) return@post
+                try {
+                    service.linkToDeath(this, 0)
+                    binder = service
+                    worker.removeCallbacks(timeout)
+                    retryDelay = 1000
+                    flush()
+                } catch (e: RemoteException) {
+                    reconnect()
+                }
+            }
+        }
+        override fun onServiceDisconnected(name: ComponentName) = binderDied()
+        override fun onBindingDied(name: ComponentName) = binderDied()
+        override fun onNullBinding(name: ComponentName) = binderDied()
+        override fun binderDied() {
+            worker.post { if (connection === this) reconnect() }
+        }
+    }
+
+    private val packageReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            if (intent.data?.schemeSpecificPart == PACKAGE) reconnect()
+        }
+    }
+    private val unlockReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            if (intent.getIntExtra(Intent.EXTRA_USER_HANDLE, UserHandle.USER_NULL) == user) bind()
+        }
+    }
+
+    companion object {
+        private const val TAG = "OemRearService"
+        private const val PACKAGE = "com.xiaomi.subscreencenter"
+        private const val SERVICE = "com.xiaomi.subscreencenter.service.SubScreenService"
+        private const val PERMISSION = "com.xiaomi.subscreencenter.SubScreenService.BIND_SERVICE"
+    }
+}
