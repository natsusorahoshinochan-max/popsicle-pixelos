+inline int checkStorageLink(int parent, const std::string& expected) {
+    struct stat st {};
+    if (fstatat(parent, "subscreencenter", &st, AT_SYMLINK_NOFOLLOW) != 0) return -1;
+    if (!S_ISLNK(st.st_mode) || st.st_uid != AID_SYSTEM) {
+        errno = EPERM;
+        return -1;
+    }
+    std::string target(expected.size() + 1, '\0');
+    const ssize_t size = readlinkat(parent, "subscreencenter", target.data(), target.size());
+    if (size < 0) return -1;
+    if (static_cast<size_t>(size) != expected.size()
+            || target.compare(0, expected.size(), expected) != 0) {
+        errno = EINVAL;
+        return -1;
+    }
+    return 0;
+}
+
+inline int prepareStorageLink(int parent, const std::string& target) {
+    if (symlinkat(target.c_str(), parent, "subscreencenter") == 0) {
+        if (fchownat(parent, "subscreencenter", AID_SYSTEM, AID_SYSTEM,
+                     AT_SYMLINK_NOFOLLOW) != 0) return -1;
+    } else if (errno != EEXIST) {
+        return -1;
+    }
+    // Never replace an existing directory or redirect an unexpected link.
+    return checkStorageLink(parent, target);
+}
