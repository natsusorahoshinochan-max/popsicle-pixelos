         }
 
+        /** OEM batch query using the same permission and user checks as individual queries. */
+        @Override
+        public void areNotificationsEnabledList(List<String> packages,
+                List<String> outPackages, List<String> outEnabledFlags, int userId) {
+            if (packages == null || packages.isEmpty()) return;
+            for (String pkg : packages) {
+                if (pkg == null) continue;
+                enforceSystemOrSystemUIOrSamePackage(pkg,
+                        "Caller not system or systemui or same package");
+                if (UserHandle.getCallingUserId() != userId) {
+                    getContext().enforceCallingPermission(
+                            android.Manifest.permission.INTERACT_ACROSS_USERS,
+                            "areNotificationsEnabledList for user " + userId);
+                }
+                // Resolve the requested user's installed UID after checking the real caller.
+                final int uid;
+                final long identity = Binder.clearCallingIdentity();
+                try {
+                    uid = getContext().getPackageManager().getPackageUidAsUser(pkg, 0, userId);
+                } catch (PackageManager.NameNotFoundException e) {
+                    Slog.w(TAG, "areNotificationsEnabledList package not found: " + pkg);
+                    continue;
+                } finally {
+                    Binder.restoreCallingIdentity(identity);
+                }
+                boolean enabled = areNotificationsEnabledForPackage(pkg, uid);
+                outPackages.add(pkg);
+                outEnabledFlags.add(Boolean.toString(enabled));
+            }
+        }
+
         /**
          * Use this when you just want to know if notifications are OK for this package.
          */
