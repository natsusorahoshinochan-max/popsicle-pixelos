+package com.android.systemui.statusbar.notification;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.SharedPreferences;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.util.Log;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Objects;
+
+/** The original rear assistant's persisted Focus switches and URI update protocol. */
+public final class OemFocusNotificationProvider extends ContentProvider {
+    private static final String TAG = "OemFocusNotification";
+    private static final String PERMISSION = "com.android.systemui.permission.NOTIFICATION";
+    private static final Uri FOCUS_URI = Uri.parse(
+            "content://statusbar.notification/canShowFocus");
+    private SharedPreferences mPreferences;
+    private ContentObserver mObserver;
+
+    @Override
+    public boolean onCreate() {
+        // Match the OEM preference file, including its historical multi-process mode.
+        mPreferences = requireContext().getSharedPreferences("app_notification", 4);
+        mObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                if (uri == null) return;
+                try {
+                    updateFocus(mPreferences, uri);
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "Cannot update Focus preference from " + uri, e);
+                }
+            }
+        };
+        requireContext().getContentResolver().registerContentObserver(
+                FOCUS_URI, false, mObserver);
+        return true;
+    }
+
+    @Override
+    public Bundle call(String method, String arg, Bundle extras) {
+        // ContentProvider.call does not apply the manifest's read/write permissions.
+        requireContext().enforceCallingOrSelfPermission(PERMISSION, "Read Focus settings");
+        if (!"canShowAllFocus".equals(method)) {
+            throw new UnsupportedOperationException("Unsupported Focus method: " + method);
+        }
+        ArrayList<String> packages = Objects.requireNonNull(extras, "extras")
+                .getStringArrayList("packages");
+        Bundle result = new Bundle();
+        result.putSerializable("canShowAllFocus", readFocus(mPreferences, packages));
+        return result;
+    }
+
+    static HashMap<String, Boolean> readFocus(SharedPreferences preferences,
+            ArrayList<String> packages) {
+        HashMap<String, Boolean> result = new HashMap<>();
+        if (packages == null) return result;
+        for (String packageName : packages) {
+            String key = packageName + "_focus";
+            result.put(packageName, !preferences.contains(key)
+                    || getFocusState(preferences, key) != 0);
+        }
+        return result;
+    }
+
+    static int getFocusState(SharedPreferences preferences, String key) {
+        if (!preferences.contains(key)) return -1;
+        try {
+            return preferences.getInt(key, 1);
+        } catch (ClassCastException e) {
+            boolean oldValue = preferences.getBoolean(key, false);
+            preferences.edit().putInt(key, oldValue ? 1 : 0).apply();
+            return oldValue ? 1 : 0;
+        } catch (Exception e) {
+            Log.w(TAG, "Cannot read Focus preference " + key, e);
+            return -1;
+        }
+    }
+
+    static void updateFocus(SharedPreferences preferences, Uri uri) {
+        String packageName = uri.getQueryParameter("package");
+        if (TextUtils.isEmpty(packageName)) return;
+        boolean enabled = Boolean.parseBoolean(uri.getQueryParameter("canShowFocus"));
+        preferences.edit().putInt(packageName + "_focus", enabled ? 1 : 0).apply();
+    }
+
+    @Override
+    public void shutdown() {
+        if (mObserver != null) {
+            requireContext().getContentResolver().unregisterContentObserver(mObserver);
+            mObserver = null;
+        }
+        super.shutdown();
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection,
+            String[] selectionArgs, String sortOrder) {
+        throw new UnsupportedOperationException("Focus settings use call()");
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        throw new UnsupportedOperationException("Focus settings have no row MIME type");
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException("Focus settings use URI notifications");
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("Focus settings use URI notifications");
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        throw new UnsupportedOperationException("Focus settings use URI notifications");
+    }
+}
