+inline int checkSystemDataLabel(int fd) {
+    char* context = nullptr;
+    if (fgetfilecon(fd, &context) < 0) return -1;
+    const bool matches = std::string(context) == "u:object_r:system_data_file:s0";
+    freecon(context);
+    if (!matches) {
+        errno = EINVAL;
+        return -1;
+    }
+    return 0;
+}
