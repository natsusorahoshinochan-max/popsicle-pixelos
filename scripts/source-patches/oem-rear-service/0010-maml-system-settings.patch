+package android.provider;
+
+import android.content.ContentResolver;
+
+/**
+ * Settings contracts used by the original rear MAML notifier.
+ * @hide
+ */
+public class SystemSettings {
+    /** Original system-setting namespace; reads retain SettingsProvider behavior. */
+    public static class System {
+        public static final String DARKEN_WALLPAPER_UNDER_DARK_MODE =
+                "darken_wallpaper_under_dark_mode";
+
+        public static boolean getBoolean(ContentResolver resolver, String name,
+                boolean defValue) {
+            return Settings.System.getInt(resolver, name, defValue ? 1 : 0) != 0;
+        }
+    }
+}
