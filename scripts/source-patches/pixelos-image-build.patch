@@ -0,0 +1,249 @@
+# SPDX-License-Identifier: Apache-2.0
+# Included only for the explicit managed OEM vendor derivation.
+ifeq ($(filter user userdebug,$(TARGET_BUILD_VARIANT)),)
+  $(error Managed OEM vendor derivation requires user or userdebug)
+endif
+ifneq ($(BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE),erofs)
+  $(error Managed OEM vendor derivation requires EROFS)
+endif
+ifneq ($(BOARD_AVB_ENABLE),true)
+  $(error Managed OEM vendor derivation requires AVB)
+endif
+ifneq ($(strip $(BOARD_PREBUILT_VENDORIMAGE)),)
+  $(error Managed OEM vendor derivation conflicts with BOARD_PREBUILT_VENDORIMAGE)
+endif
+ifneq ($(strip $(BOARD_AVB_VENDOR_KEY_PATH)$(BOARD_AVB_VENDOR_ALGORITHM)),)
+  $(error Managed standalone vendor must not request a standard top-level vendor AVB chain)
+endif
+ifeq ($(strip $(BOARD_VENDOR_EROFS_FSTAB)),)
+  $(error Managed OEM vendor derivation requires BOARD_VENDOR_EROFS_FSTAB)
+endif
+ifeq ($(strip $(BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY)),)
+  $(error Managed OEM vendor derivation requires BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY)
+endif
+ifeq ($(strip $(BOARD_VENDOR_EROFS_AVB_KEY_PATH)),)
+  $(error Managed OEM vendor derivation requires a vendor signing key)
+endif
+ifeq ($(filter-out NONE,$(BOARD_VENDOR_EROFS_AVB_ALGORITHM)),)
+  $(error Managed OEM vendor derivation requires a signed vendor algorithm)
+endif
+
+POPSICLE_VENDOR_TOOL := $(HOST_OUT_EXECUTABLES)/popsicle_derive_vendor
+POPSICLE_VENDOR_READER := $(HOST_OUT_EXECUTABLES)/popsicle_erofs_readback
+POPSICLE_VENDOR_DESCRIPTOR := $(TARGET_OUT_VENDOR)/etc/tracing_descriptors.gz
+POPSICLE_VENDOR_RAW := $(vendorimage_intermediates)/vendor.erofs
+POPSICLE_VENDOR_HOST_DEPS := $(POPSICLE_VENDOR_TOOL) $(POPSICLE_VENDOR_READER) \
+    $(HOST_OUT_EXECUTABLES)/mkfs.erofs $(HOST_OUT_EXECUTABLES)/fsck.erofs \
+    $(AVBTOOL) $(HOST_OUT_EXECUTABLES)/avb_openssl $(HOST_OUT_EXECUTABLES)/fec
+POPSICLE_VENDOR_INPUTS := $(BOARD_VENDOR_EROFS_STOCK_IMAGE) $(POPSICLE_VENDOR_DESCRIPTOR) \
+    $(BOARD_VENDOR_EROFS_FSTAB) $(BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY) $(BOARD_VENDOR_EROFS_AVB_KEY_PATH)
+POPSICLE_VENDOR_SOURCE_ARGS = --reader $(POPSICLE_VENDOR_READER) \
+    --stock $(BOARD_VENDOR_EROFS_STOCK_IMAGE) --descriptor $(POPSICLE_VENDOR_DESCRIPTOR) \
+    --fstab $(BOARD_VENDOR_EROFS_FSTAB)
+
+# The retained init service and policy already require this exact entrypoint
+# label. Use the same checked derivation for raw images and target-files gates.
+ifeq ($(BOARD_VENDOR_EROFS_REPAIR_AMBIENT_LABEL),true)
+POPSICLE_VENDOR_SOURCE_ARGS += --repair-ambient-label
+endif
+
+ifeq ($(BOARD_VENDOR_EROFS_MERGE_NOTICE),true)
+POPSICLE_VENDOR_SOURCE_ARGS += --source-notice $(TARGET_OUT_VENDOR)/etc/NOTICE.xml.gz
+POPSICLE_VENDOR_INPUTS += $(TARGET_OUT_VENDOR)/etc/NOTICE.xml.gz
+endif
+
+# Resolve only the actual product file list against reviewed module outputs.
+ifeq ($(BOARD_VENDOR_EROFS_PRODUCT_STAGE),true)
+POPSICLE_VENDOR_STAGE_ARGS := --stage $(TARGET_OUT_VENDOR) \
+    --stage-file-list $(vendorimage_intermediates)/file_list.txt \
+    --stage-fs-config $(HOST_OUT_EXECUTABLES)/fs_config --stage-target-out $(TARGET_OUT) \
+    --stage-selabel-lookup $(HOST_OUT_EXECUTABLES)/popsicle_selabel_lookup \
+    --stage-file-contexts $(SELINUX_FC)
+POPSICLE_VENDOR_HOST_DEPS += $(HOST_OUT_EXECUTABLES)/fs_config $(HOST_OUT_EXECUTABLES)/popsicle_selabel_lookup
+POPSICLE_VENDOR_INPUTS += $(SELINUX_FC) \
+    $(filter %/etc/fs_config_dirs %/etc/fs_config_files,$(ALL_DEFAULT_INSTALLED_MODULES))
+# Each entry is an exact product path and its reviewed module, not a path exemption.
+# CAS V1 manifest/rc/VINTF and signing identities match the reviewed product
+# contract. Its sole CAS plugin and both protobuf outputs stay on the same source ABI.
+POPSICLE_VENDOR_STAGE_MODULES := \
+    etc/build_flags.json:build_flag_vendor \
+    etc/vintf/compatibility_matrix.xml:vendor_compatibility_matrix.xml \
+    bin/sh:sh_vendor \
+    bin/awk:awk_vendor \
+    bin/boringssl_self_test64:boringssl_self_test_vendor \
+    bin/dumpsys:dumpsys_vendor \
+    bin/logwrapper:logwrapper_vendor \
+    bin/toolbox:toolbox_vendor \
+    bin/toybox_vendor:toybox_vendor \
+    lib64/libz.so:libz.vendor \
+    lib64/libc++.so:libc++.vendor \
+    lib64/libbinder.so:libbinder.vendor \
+    lib64/libbinderdebug.so:libbinderdebug.vendor \
+    lib64/libcutils.so:libcutils.vendor \
+    lib64/libutils.so:libutils.vendor \
+    lib64/libhidlbase.so:libhidlbase.vendor \
+    lib64/libaconfig_storage_read_api_cc.so:libaconfig_storage_read_api_cc.vendor \
+    lib64/server_configurable_flags.so:server_configurable_flags.vendor \
+    lib64/libspeexresampler.so:libspeexresampler.vendor \
+    lib64/libmedia_helper.so:libmedia_helper.vendor \
+    lib64/libtinyxml2.so:libtinyxml2.vendor \
+    lib64/libeffectsconfig.so:libeffectsconfig.vendor \
+    lib64/android.hardware.radio@1.0.so:android.hardware.radio@1.0.vendor \
+    lib64/android.hardware.radio@1.1.so:android.hardware.radio@1.1.vendor \
+    lib64/libril.so:libril \
+    lib64/librilutils.so:librilutils \
+    lib64/libreference-ril.so:libreference-ril \
+    lib64/libhardware_legacy.so:libhardware_legacy.vendor \
+    lib64/android.system.suspend-V1-ndk.so:android.system.suspend-V1-ndk.vendor \
+    lib64/libstagefright_foundation.so:libstagefright_foundation.vendor \
+    lib64/mediadrm/libdrmclearkeyplugin.so:libdrmclearkeyplugin \
+    lib64/libeffects.so:libeffects \
+    lib64/libvibratorutils.so:libvibratorutils.vendor \
+    lib64/soundfx/libhapticgenerator.so:libhapticgenerator \
+    lib64/soundfx/libaudiopreprocessing.so:libaudiopreprocessing \
+    lib64/soundfx/libeffectproxy.so:libeffectproxy \
+    lib64/hw/audio.primary.default.so:audio.primary.default \
+    lib64/hw/gralloc.default.so:gralloc.default \
+    lib64/hw/local_time.default.so:local_time.default \
+    lib64/hw/power.default.so:power.default \
+    lib64/hw/vibrator.default.so:vibrator.default \
+    etc/bpf/filterPowerSupplyEvents.o:filterPowerSupplyEvents.o_filterPowerSupplyEvents.o \
+    lib64/soundfx/libbundlewrapper.so:libbundlewrapper \
+    lib64/soundfx/libreverbwrapper.so:libreverbwrapper \
+    lib64/soundfx/libvisualizer.so:libvisualizer \
+    lib64/soundfx/libdownmix.so:libdownmix \
+    lib64/soundfx/libdynproc.so:libdynproc \
+    lib64/soundfx/libldnhncr.so:libldnhncr \
+    apex/com.android.hardware.cas.apex:com.android.hardware.cas \
+    lib64/mediacas/libclearkeycasplugin.so:libclearkeycasplugin \
+    lib64/libprotobuf-cpp-full-6.33.5.so:libprotobuf-cpp-full.vendor \
+    lib64/libprotobuf-cpp-lite-6.33.5.so:libprotobuf-cpp-lite.vendor \
+    etc/res/values/charger/animation.txt:custom_charger_animation_vendor \
+    etc/res/images/charger/battery_fail.png:charger_battery_fail_vendor \
+    etc/res/images/charger/battery_scale.png:charger_battery_scale_vendor \
+    etc/res/images/charger/main_font.png:charger_font_vendor
+
+# Match base_vendor.mk: this performance setup script belongs to debug builds.
+ifeq ($(TARGET_BUILD_VARIANT),userdebug)
+POPSICLE_VENDOR_STAGE_MODULES += bin/perf-setup.sh:perf-setup-sh
+else
+ifneq ($(filter $(TARGET_OUT_VENDOR)/bin/perf-setup.sh,$(INTERNAL_VENDORIMAGE_FILES)),)
+$(error The user vendor stage must not install debug perf-setup-sh)
+endif
+endif
+
+define popsicle-register-stage-module
+$(if $(filter $(TARGET_OUT_VENDOR)/$(1),$(INTERNAL_VENDORIMAGE_FILES)),,$(error Reviewed stage module $(2) is not installed at $(1)))
+$(if $(filter 1,$(words $(filter %:$(TARGET_OUT_VENDOR)/$(1),$(ALL_MODULES.$(2).BUILT_INSTALLED)))),,$(error Expected one build/install edge for $(2) at $(1)))
+POPSICLE_VENDOR_STAGE_ARGS += --stage-source $(1)=$(word 1,$(subst :, ,$(filter %:$(TARGET_OUT_VENDOR)/$(1),$(ALL_MODULES.$(2).BUILT_INSTALLED))))
+POPSICLE_VENDOR_INPUTS += $(word 1,$(subst :, ,$(filter %:$(TARGET_OUT_VENDOR)/$(1),$(ALL_MODULES.$(2).BUILT_INSTALLED))))
+endef
+$(foreach entry,$(POPSICLE_VENDOR_STAGE_MODULES),$(eval $(call popsicle-register-stage-module,$(word 1,$(subst :, ,$(entry))),$(word 2,$(subst :, ,$(entry))))))
+POPSICLE_VENDOR_SOURCE_ARGS += $(POPSICLE_VENDOR_STAGE_ARGS)
+endif
+
+# This opt-in must match the Soong policy provider. Metadata and AVB production
+# remain available for trees without this policy provider.
+ifeq ($(SOONG_CONFIG_popsicle_managed_vendor_policy),true)
+POPSICLE_POLICY_WORKSPACE := $(vendorimage_intermediates)/strict-policy-work
+POPSICLE_POLICY_SELINUX := $(TARGET_OUT)/etc/selinux
+POPSICLE_POLICY_SYSTEM_EXT := $(TARGET_OUT_SYSTEM_EXT)/etc/selinux
+POPSICLE_POLICY_PRODUCT := $(TARGET_OUT_PRODUCT)/etc/selinux
+POPSICLE_POLICY_NAMED_INPUTS := \
+    plat=$(POPSICLE_POLICY_SELINUX)/plat_sepolicy.cil \
+    plat-map=$(POPSICLE_POLICY_SELINUX)/mapping/202504.cil \
+    plat-compat=$(POPSICLE_POLICY_SELINUX)/mapping/202504.compat.cil \
+    system-ext=$(POPSICLE_POLICY_SYSTEM_EXT)/system_ext_sepolicy.cil \
+    system-ext-map=$(POPSICLE_POLICY_SYSTEM_EXT)/mapping/202504.cil \
+    system-ext-compat=$(POPSICLE_POLICY_SYSTEM_EXT)/mapping/202504.compat.cil \
+    product=$(POPSICLE_POLICY_PRODUCT)/product_sepolicy.cil \
+    product-map=$(POPSICLE_POLICY_PRODUCT)/mapping/202504.cil \
+    genfs=$(POPSICLE_POLICY_SELINUX)/plat_sepolicy_genfs_202504.cil \
+    plat-hash=$(POPSICLE_POLICY_SELINUX)/plat_sepolicy_and_mapping.sha256 \
+    system-ext-hash=$(POPSICLE_POLICY_SYSTEM_EXT)/system_ext_sepolicy_and_mapping.sha256 \
+    product-hash=$(POPSICLE_POLICY_PRODUCT)/product_sepolicy_and_mapping.sha256 \
+    odm-stock=$(if $(BOARD_ODM_EROFS_STOCK_IMAGE),$(BOARD_ODM_EROFS_STOCK_IMAGE),$(BOARD_PREBUILT_ODMIMAGE)) \
+    macros=system/sepolicy/public/te_macros \
+    global-macros=system/sepolicy/public/global_macros \
+    codec-source=external/erofs-utils/popsicle/policy-producers/mediacodec.te \
+    m4=prebuilts/build-tools/$(HOST_PREBUILT_TAG)/bin/m4 secilc=$(HOST_OUT_EXECUTABLES)/secilc
+POPSICLE_POLICY_DEPS := $(foreach input,$(POPSICLE_POLICY_NAMED_INPUTS),$(word 2,$(subst =, ,$(input))))
+POPSICLE_VENDOR_POLICY_ARGS = --build-variant $(TARGET_BUILD_VARIANT) $(foreach input,$(POPSICLE_POLICY_NAMED_INPUTS),--policy-input $(input)) \
+    --policy-input workspace=$(POPSICLE_POLICY_WORKSPACE)
+POPSICLE_VENDOR_SOURCE_ARGS += $(POPSICLE_VENDOR_POLICY_ARGS)
+POPSICLE_VENDOR_INPUTS += $(POPSICLE_POLICY_DEPS)
+endif
+POPSICLE_VENDOR_AVB_ARGS = --reader $(POPSICLE_VENDOR_READER) \
+    --stock $(BOARD_VENDOR_EROFS_STOCK_IMAGE) --raw $(POPSICLE_VENDOR_RAW) \
+    --key $(BOARD_VENDOR_EROFS_AVB_KEY_PATH) --public-key $(BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY) \
+    --algorithm $(BOARD_VENDOR_EROFS_AVB_ALGORITHM) --fec $(HOST_OUT_EXECUTABLES)/fec
+
+# These remain untouched official images. Their filesystem views are read from
+# the same raw inputs, rather than from the incomplete generated staging trees.
+POPSICLE_PREBUILT_PARTITIONS := $(foreach p,ODM SYSTEM_DLKM VENDOR_DLKM,$(if $(BOARD_PREBUILT_$(p)IMAGE),$(p)))
+POPSICLE_PREBUILT_NAME_ODM := odm
+POPSICLE_PREBUILT_NAME_SYSTEM_DLKM := system_dlkm
+POPSICLE_PREBUILT_NAME_VENDOR_DLKM := vendor_dlkm
+# Installed image targets are declared later in core/Makefile. Keep these lazy.
+POPSICLE_PREBUILT_INPUTS = $(foreach p,$(POPSICLE_PREBUILT_PARTITIONS),\
+    $(BOARD_PREBUILT_$(p)IMAGE) $(INSTALLED_$(p)IMAGE_TARGET) \
+    $(filter $(TARGET_OUT_$(p))/%,$(ALL_DEFAULT_INSTALLED_MODULES)))
+
+define popsicle-prebuilt-source-args
+  --reader $(POPSICLE_VENDOR_READER) --fsck $(HOST_OUT_EXECUTABLES)/fsck.erofs \
+      --partition $(POPSICLE_PREBUILT_NAME_$(1)) --stock $(BOARD_PREBUILT_$(1)IMAGE) \
+      --image $(INSTALLED_$(1)IMAGE_TARGET) --stage $(TARGET_OUT_$(1))
+endef
+
+define export-prebuilt-target-files
+  mkdir -p $(2)/META
+  $(POPSICLE_VENDOR_TOOL) export-prebuilt $(call popsicle-prebuilt-source-args,$(1)) --target-files $(2)
+endef
+
+define verify-prebuilt-target-files
+  $(POPSICLE_VENDOR_TOOL) verify-prebuilt-target-files $(call popsicle-prebuilt-source-args,$(1)) $(2)
+endef
+
+$(POPSICLE_VENDOR_RAW): $(POPSICLE_VENDOR_HOST_DEPS) $(POPSICLE_VENDOR_INPUTS) \
+    $(INTERNAL_VENDORIMAGE_FILES) $(vendorimage_intermediates)/file_list.txt
+	@mkdir -p $(dir $@)
+	$(if $(POPSICLE_POLICY_WORKSPACE),mkdir -p $(POPSICLE_POLICY_WORKSPACE))
+	$(POPSICLE_VENDOR_TOOL) audit-stage $(POPSICLE_VENDOR_SOURCE_ARGS) $(if $(POPSICLE_VENDOR_STAGE_ARGS),,--stage $(TARGET_OUT_VENDOR))
+	rm -f $@.tmp
+	$(POPSICLE_VENDOR_TOOL) derive $(POPSICLE_VENDOR_SOURCE_ARGS) \
+	    --mkfs $(HOST_OUT_EXECUTABLES)/mkfs.erofs --fsck $(HOST_OUT_EXECUTABLES)/fsck.erofs --output $@.tmp
+	mv $@.tmp $@
+
+$(call declare-container-license-metadata,$(POPSICLE_VENDOR_RAW),legacy_proprietary,proprietary,,"Managed Vendor Filesystem",vendor)
+$(call declare-container-license-deps,$(POPSICLE_VENDOR_RAW),$(POPSICLE_VENDOR_INPUTS) $(POPSICLE_VENDOR_HOST_DEPS),$(PRODUCT_OUT)/:/)
+
+define build-managed-vendorimage-target
+  $(call pretty,"Target managed vendor image: $(INSTALLED_VENDORIMAGE_TARGET)")
+  @mkdir -p $(vendorimage_intermediates)
+  @rm -f $(vendorimage_intermediates)/vendor_image_info.txt $(INSTALLED_VENDORIMAGE_TARGET).avb.tmp
+  $(call generate-image-prop-dictionary,$(vendorimage_intermediates)/vendor_image_info.txt,vendor)
+  echo "avb_enable=$(BOARD_AVB_ENABLE)" >> $(vendorimage_intermediates)/vendor_image_info.txt
+  echo "avb_vendor_key_path=$(BOARD_VENDOR_EROFS_AVB_KEY_PATH)" >> $(vendorimage_intermediates)/vendor_image_info.txt
+  echo "avb_vendor_algorithm=$(BOARD_VENDOR_EROFS_AVB_ALGORITHM)" >> $(vendorimage_intermediates)/vendor_image_info.txt
+  PATH=$(INTERNAL_USERIMAGES_BINARY_PATHS):$$PATH \
+      $(POPSICLE_VENDOR_TOOL) seal $(POPSICLE_VENDOR_AVB_ARGS) --avbtool $(AVBTOOL) \
+          --image-info $(vendorimage_intermediates)/vendor_image_info.txt \
+          --output $(INSTALLED_VENDORIMAGE_TARGET).avb.tmp
+  mv $(INSTALLED_VENDORIMAGE_TARGET).avb.tmp $(INSTALLED_VENDORIMAGE_TARGET)
+  $(call assert-max-image-size,$(INSTALLED_VENDORIMAGE_TARGET),$(BOARD_VENDORIMAGE_PARTITION_SIZE))
+endef
+
+define verify-managed-vendor-target-files
+  $(POPSICLE_VENDOR_TOOL) audit-stage $(POPSICLE_VENDOR_SOURCE_ARGS) $(if $(POPSICLE_VENDOR_STAGE_ARGS),,--stage $(TARGET_OUT_VENDOR))
+  $(POPSICLE_VENDOR_TOOL) verify $(POPSICLE_VENDOR_SOURCE_ARGS) \
+      --fsck $(HOST_OUT_EXECUTABLES)/fsck.erofs --output $(POPSICLE_VENDOR_RAW)
+  $(POPSICLE_VENDOR_TOOL) verify-avb $(POPSICLE_VENDOR_AVB_ARGS) --image $(INSTALLED_VENDORIMAGE_TARGET)
+  $(POPSICLE_VENDOR_TOOL) verify-target-files --reader $(POPSICLE_VENDOR_READER) \
+      --stock $(BOARD_VENDOR_EROFS_STOCK_IMAGE) --image $(INSTALLED_VENDORIMAGE_TARGET) --key $(BOARD_VENDOR_EROFS_AVB_KEY_PATH) \
+      --public-key $(BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY) --fec $(HOST_OUT_EXECUTABLES)/fec \
+      $(POPSICLE_VENDOR_POLICY_ARGS) $(1)
+  $(if $(BOARD_ODM_EROFS_STOCK_IMAGE),$(call verify-managed-odm-target-files,$(1)))
+  $(if $(filter ODM,$(POPSICLE_PREBUILT_PARTITIONS)),$(call verify-prebuilt-target-files,ODM,$(1)))
+  $(if $(filter SYSTEM_DLKM,$(POPSICLE_PREBUILT_PARTITIONS)),$(call verify-prebuilt-target-files,SYSTEM_DLKM,$(1)))
+  $(if $(filter VENDOR_DLKM,$(POPSICLE_PREBUILT_PARTITIONS)),$(call verify-prebuilt-target-files,VENDOR_DLKM,$(1)))
+endef
diff --git a/core/popsicle_odm_filesystems.mk b/core/popsicle_odm_filesystems.mk
new file mode 100644
index 0000000..4344e2b
--- /dev/null
+++ b/core/popsicle_odm_filesystems.mk
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+# Included at the normal ODM image target after its actual install list exists.
+ifeq ($(filter user:erofs:true userdebug:erofs:true,$(TARGET_BUILD_VARIANT):$(BOARD_ODMIMAGE_FILE_SYSTEM_TYPE):$(BOARD_AVB_ENABLE)),)
+  $(error Managed camera ODM requires user or userdebug EROFS and AVB)
+endif
+ifeq ($(strip $(BOARD_VENDOR_EROFS_STOCK_IMAGE)),)
+  $(error Managed camera ODM requires the matching managed vendor trust contract)
+endif
+ifneq ($(strip $(BOARD_PREBUILT_ODMIMAGE)$(BOARD_AVB_ODM_KEY_PATH)$(BOARD_AVB_ODM_ALGORITHM)),)
+  $(error Managed camera ODM conflicts with prebuilt copy or top-level AVB chaining)
+endif
+ifeq ($(strip $(BOARD_ODM_EROFS_ID_BUFFER_PATCH)),)
+  $(error Managed camera ODM requires its original guarded ID-buffer transform)
+endif
+ifeq ($(strip $(BOARD_ODM_EROFS_DEVICE_CONFIG_PATCH)),)
+  $(error Managed camera ODM requires its original guarded device-config transform)
+endif
+
+ifeq ($(strip $(BOARD_ODM_EROFS_EXTENSION_CONFIG_PATCH)),)
+  $(error Managed camera ODM requires its guarded extension-config transform)
+endif
+
+POPSICLE_ODM_TOOL := $(HOST_OUT_EXECUTABLES)/popsicle_derive_odm
+POPSICLE_ODM_RAW := $(odmimage_intermediates)/odm.erofs
+POPSICLE_ODM_HOST_DEPS := $(POPSICLE_ODM_TOOL) $(POPSICLE_VENDOR_READER) \
+    $(HOST_OUT_EXECUTABLES)/mkfs.erofs $(HOST_OUT_EXECUTABLES)/fsck.erofs \
+    $(AVBTOOL) $(HOST_OUT_EXECUTABLES)/avb_openssl $(HOST_OUT_EXECUTABLES)/fec \
+    $(HOST_OUT_EXECUTABLES)/fs_config $(HOST_OUT_EXECUTABLES)/popsicle_selabel_lookup
+POPSICLE_ODM_INPUTS := $(BOARD_ODM_EROFS_STOCK_IMAGE) \
+    $(BOARD_ODM_EROFS_ID_BUFFER_PATCH) $(BOARD_ODM_EROFS_DEVICE_CONFIG_PATCH) \
+    $(BOARD_ODM_EROFS_EXTENSION_CONFIG_PATCH) \
+    $(BOARD_VENDOR_EROFS_AVB_KEY_PATH) $(BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY) \
+    $(odmimage_intermediates)/file_list.txt $(SELINUX_FC) \
+    $(filter %/etc/fs_config_dirs %/etc/fs_config_files,$(ALL_DEFAULT_INSTALLED_MODULES))
+# Every product path consumes the same selected-stage contract. Camera/NOTICE
+# are the only guarded differences; there is no generic ODM source allowlist.
+POPSICLE_ODM_STAGE_ARGS := --stage $(TARGET_OUT_ODM) \
+    --stage-file-list $(odmimage_intermediates)/file_list.txt \
+    --stage-fs-config $(HOST_OUT_EXECUTABLES)/fs_config --stage-target-out $(TARGET_OUT) \
+    --stage-selabel-lookup $(HOST_OUT_EXECUTABLES)/popsicle_selabel_lookup \
+    --stage-file-contexts $(SELINUX_FC)
+POPSICLE_ODM_SOURCE_ARGS := --reader $(POPSICLE_VENDOR_READER) \
+    --fsck $(HOST_OUT_EXECUTABLES)/fsck.erofs --stock $(BOARD_ODM_EROFS_STOCK_IMAGE) \
+    --id-buffer-patch $(BOARD_ODM_EROFS_ID_BUFFER_PATCH) \
+    --device-config-patch $(BOARD_ODM_EROFS_DEVICE_CONFIG_PATCH) \
+    --extension-config-patch $(BOARD_ODM_EROFS_EXTENSION_CONFIG_PATCH) $(POPSICLE_ODM_STAGE_ARGS)
+ifeq ($(BOARD_ODM_EROFS_MERGE_NOTICE),true)
+POPSICLE_ODM_SOURCE_ARGS += --source-notice $(TARGET_OUT_ODM)/etc/NOTICE.xml.gz
+POPSICLE_ODM_INPUTS += $(TARGET_OUT_ODM)/etc/NOTICE.xml.gz
+endif
+POPSICLE_ODM_SIGNING_ARGS := --key $(BOARD_VENDOR_EROFS_AVB_KEY_PATH) \
+    --public-key $(BOARD_VENDOR_EROFS_AVB_PUBLIC_KEY) \
+    --algorithm $(BOARD_VENDOR_EROFS_AVB_ALGORITHM) --fec $(HOST_OUT_EXECUTABLES)/fec
+POPSICLE_ODM_VERIFY_ARGS = $(POPSICLE_ODM_SOURCE_ARGS) $(POPSICLE_ODM_SIGNING_ARGS) \
+    --raw $(POPSICLE_ODM_RAW) --image $(INSTALLED_ODMIMAGE_TARGET)
+
+$(POPSICLE_ODM_RAW): $(POPSICLE_ODM_HOST_DEPS) $(POPSICLE_ODM_INPUTS) $(INTERNAL_ODMIMAGE_FILES)
+	@mkdir -p $(dir $@)
+	$(POPSICLE_ODM_TOOL) audit-stage $(POPSICLE_ODM_SOURCE_ARGS)
+	rm -f $@.tmp
+	$(POPSICLE_ODM_TOOL) derive $(POPSICLE_ODM_SOURCE_ARGS) \
+	    --mkfs $(HOST_OUT_EXECUTABLES)/mkfs.erofs --output $@.tmp
+	mv $@.tmp $@
+
+$(call declare-container-license-metadata,$(POPSICLE_ODM_RAW),legacy_proprietary,proprietary,,"Managed Camera ODM Filesystem",odm)
+$(call declare-container-license-deps,$(POPSICLE_ODM_RAW),$(POPSICLE_ODM_INPUTS) $(POPSICLE_ODM_HOST_DEPS),$(PRODUCT_OUT)/:/)
+
+define build-managed-odmimage-target
+  $(call pretty,"Target managed camera ODM image: $(INSTALLED_ODMIMAGE_TARGET)")
+  @mkdir -p $(odmimage_intermediates)
+  @rm -f $(odmimage_intermediates)/odm_image_info.txt $(INSTALLED_ODMIMAGE_TARGET).avb.tmp
+  $(call generate-image-prop-dictionary,$(odmimage_intermediates)/odm_image_info.txt,odm)
+  echo "avb_enable=$(BOARD_AVB_ENABLE)" >> $(odmimage_intermediates)/odm_image_info.txt
+  echo "avb_odm_key_path=$(BOARD_VENDOR_EROFS_AVB_KEY_PATH)" >> $(odmimage_intermediates)/odm_image_info.txt
+  echo "avb_odm_algorithm=$(BOARD_VENDOR_EROFS_AVB_ALGORITHM)" >> $(odmimage_intermediates)/odm_image_info.txt
+  PATH=$(INTERNAL_USERIMAGES_BINARY_PATHS):$$PATH \
