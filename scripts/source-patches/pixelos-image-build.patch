diff --git a/tools/verify_prebuilt_boot_image.py b/tools/verify_prebuilt_boot_image.py
new file mode 100644
index 0000000..b3c8502
--- /dev/null
+++ b/tools/verify_prebuilt_boot_image.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Validate an immutable boot-family prebuilt without changing its AVB footer."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--avbtool", required=True)
+    parser.add_argument("--image", required=True, type=Path)
+    parser.add_argument("--partition", required=True, choices=("boot", "dtbo", "vendor_boot"))
+    parser.add_argument("--partition-size", required=True, type=int)
+    args = parser.parse_args()
+    if args.image.name != args.partition + ".img":
+        parser.error("Validate the canonical output filename used by AVB descriptors")
+    size = args.image.stat().st_size
+    if args.partition_size <= 0 or not 0 < size <= args.partition_size:
+        parser.error("Prebuilt does not fit the declared partition size")
+    magic = {"boot": b"ANDROID!", "vendor_boot": b"VNDRBOOT", "dtbo": bytes.fromhex("d7b7ab1e")}
+    expected = magic[args.partition]
+    with args.image.open("rb") as stream:
+        if stream.read(len(expected)) != expected:
+            parser.error("Prebuilt header does not match the declared partition type")
+    info = subprocess.run(
+        [args.avbtool, "info_image", "--image", str(args.image)],
+        check=True, stdout=subprocess.PIPE, text=True,
+    ).stdout
+    # The pinned avbtool prints this field for both hash and chain descriptors.
+    # Boot-family inputs must describe exactly the partition being installed.
+    names = re.findall(r"^\s+Partition Name:\s+(\S+)\s*$", info, re.MULTILINE)
+    if names != [args.partition]:
+        parser.error("AVB descriptors do not identify exactly the declared partition")
+    subprocess.run(
+        [args.avbtool, "verify_image", "--image", str(args.image)], check=True,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/verify_prebuilt_vbmeta.py b/tools/verify_prebuilt_vbmeta.py
new file mode 100644
index 0000000..4faf839
--- /dev/null
+++ b/tools/verify_prebuilt_vbmeta.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check a pinned signed top-level vbmeta and exact copies, not its image chain."""
+
+import argparse
+from pathlib import Path
+import struct
+import zipfile
+
+import avbtool
+
+
+def validate_reference(data, algorithm, partition_size):
+    if len(data) < 256 or len(data) > partition_size:
+        raise ValueError("top-level vbmeta exceeds its partition or lacks a complete header")
+    header = avbtool.AvbVBMetaHeader(data[:256])
+    name, _ = avbtool.lookup_algorithm_by_type(header.algorithm_type)
+    if name == "NONE" or name != algorithm:
+        raise ValueError("unexpected or unsigned vbmeta algorithm")
+    if header.flags != 0:
+        raise ValueError("verification/hashtree disabling flags are not permitted")
+    auth = header.authentication_data_block_size
+    aux = header.auxiliary_data_block_size
+    if auth % 64 or aux % 64 or 256 + auth + aux > len(data):
+        raise ValueError("invalid authentication/auxiliary block bounds")
+    for offset, size, bound in (
+        (header.hash_offset, header.hash_size, auth),
+        (header.signature_offset, header.signature_size, auth),
+        (header.public_key_offset, header.public_key_size, aux),
+        (header.public_key_metadata_offset, header.public_key_metadata_size, aux),
+        (header.descriptors_offset, header.descriptors_size, aux),
+    ):
+        if offset + size > bound:
+            raise ValueError("vbmeta field exceeds its block")
+    if not avbtool.verify_vbmeta_signature(header, data):
+        raise ValueError("vbmeta signature verification failed")
+
+
+def validate_metadata(text, algorithm):
+    fields = {}
+    for line in text.splitlines():
+        if not line or line.startswith("#"):
+            continue
+        key, separator, value = line.partition("=")
+        if separator and key.startswith("avb_"):
+            if key in fields:
+                raise ValueError("duplicate AVB metadata key")
+            fields[key] = value
+    if (fields.get("avb_prebuilt_vbmeta") != "true"
+            or fields.get("avb_enable") != "true"
+            or fields.get("avb_building_vbmeta_image") != "true"
+            or fields.get("avb_vbmeta_algorithm") != algorithm):
+        raise ValueError("target_files does not describe the pinned AVB image")
+    if "avb_vbmeta_key_path" in fields or "avb_vbmeta_args" in fields:
+        raise ValueError("target_files incorrectly describes a locally signed top-level image")
+
+
+def verify(args):
+    if args.reference.samefile(args.witness):
+        raise ValueError("reference must be an independent copy of the immutable official witness")
+    reference = args.reference.read_bytes()
+    if reference != args.witness.read_bytes():
+        raise ValueError("reference differs from the immutable official witness")
+    validate_reference(reference, args.algorithm, args.partition_size)
+    if args.image and args.image.read_bytes() != reference:
+        raise ValueError("installed vbmeta differs from the pinned reference")
+    if args.target_files:
+        validate_metadata((args.target_files / "META/misc_info.txt").read_text(), args.algorithm)
+        actual = (args.target_files / "IMAGES/vbmeta.img").read_bytes()
+        if actual != reference:
+            raise ValueError("target_files vbmeta differs from the pinned reference")
+    if args.target_files_zip:
+        with zipfile.ZipFile(args.target_files_zip) as archive:
+            metadata = [i for i in archive.infolist() if i.filename == "META/misc_info.txt"]
+            if len(metadata) != 1 or metadata[0].file_size > 1024 * 1024:
+                raise ValueError("missing, duplicate or oversized target_files metadata")
+            validate_metadata(archive.read(metadata[0]).decode("utf-8"), args.algorithm)
+            entries = [i for i in archive.infolist() if i.filename == "IMAGES/vbmeta.img"]
+            if len(entries) != 1 or entries[0].file_size != len(reference):
+                raise ValueError("target_files ZIP has missing, duplicate or invalid vbmeta")
+            if archive.read(entries[0]) != reference:
+                raise ValueError("target_files ZIP vbmeta differs from the pinned reference")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--reference", type=Path, required=True)
+    parser.add_argument("--witness", type=Path, required=True)
+    parser.add_argument("--algorithm", required=True)
+    parser.add_argument("--partition-size", type=int, required=True)
+    parser.add_argument("--image", type=Path)
+    parser.add_argument("--target-files", type=Path)
+    parser.add_argument("--target-files-zip", type=Path)
+    args = parser.parse_args()
+    try:
+        verify(args)
+    except (OSError, ValueError, struct.error, zipfile.BadZipFile, avbtool.AvbError) as error:
+        parser.exit(1, f"Pinned vbmeta verification failed: {error}\n")
+    print("Pinned vbmeta signature and requested full-byte copies verified; image chain not checked.")
+
+
+if __name__ == "__main__":
+    main()
