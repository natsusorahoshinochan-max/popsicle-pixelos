+    /** Only the identified, isolated physical rear display may use this doze session. */
+    @GuardedBy("mLock")
+    private int getRearDisplayIdLocked(int groupId) {
+        if (groupId == Display.DEFAULT_DISPLAY_GROUP || mDisplayManagerInternal == null) {
+            return Display.INVALID_DISPLAY;
+        }
+        int rearDisplayId = Display.INVALID_DISPLAY;
+        int displayCount = 0;
+        for (int i = 0; i < mDisplayGroupIds.size(); i++) {
+            if (mDisplayGroupIds.valueAt(i) != groupId) {
+                continue;
+            }
+            displayCount++;
+            final int displayId = mDisplayGroupIds.keyAt(i);
+            final DisplayInfo info = mDisplayManagerInternal.getDisplayInfo(displayId);
+            if (OemRearDisplay.isRearDisplay(mContext.getResources(), info)) {
+                rearDisplayId = displayId;
+            }
+        }
+        return displayCount == 1 ? rearDisplayId : Display.INVALID_DISPLAY;
+    }
+
+    private void handleRearSandman(int groupId) {
+        final RearDreamManagerInternal rear = LocalServices.getService(
+                RearDreamManagerInternal.class);
+        final int displayId;
+        final boolean start;
+        synchronized (mLock) {
+            mSandmanScheduled = false;
+            final PowerGroup group = mPowerGroups.get(groupId);
+            displayId = getRearDisplayIdLocked(groupId);
+            if (group != null && displayId != Display.INVALID_DISPLAY
+                    && group.getWakefulnessLocked() == WAKEFULNESS_DOZING) {
+                if (!group.isReadyLocked()) {
+                    return;
+                }
+                start = group.isSandmanSummonedLocked();
+                group.setSandmanSummonedLocked(false);
+                if (start) {
+                    group.setDreamManagerAttemptedDozingLocked(true);
+                }
+            } else {
+                start = false;
+            }
+        }
+        if (rear != null && start) {
+            rear.startDream(groupId, displayId);
+        }
+        final boolean dreaming = rear != null && rear.isDreaming(groupId);
+        boolean keepDream = false;
+        synchronized (mLock) {
+            final PowerGroup group = mPowerGroups.get(groupId);
+            if (group != null && getRearDisplayIdLocked(groupId) != Display.INVALID_DISPLAY
+                    && group.getWakefulnessLocked() == WAKEFULNESS_DOZING) {
+                if (group.isSandmanSummonedLocked()) {
+                    return; // A newer sleep transition owns the next attempt.
+                }
+                keepDream = dreaming;
+                if (!dreaming) {
+                    sleepPowerGroupLocked(group, mClock.uptimeMillis(),
+                            PowerManager.GO_TO_SLEEP_REASON_TIMEOUT, Process.SYSTEM_UID);
+                    updatePowerStateLocked();
+                }
+            }
+        }
+        if (!keepDream && rear != null) {
+            rear.stopDream(groupId, "rear power state changed");
+        }
+    }
