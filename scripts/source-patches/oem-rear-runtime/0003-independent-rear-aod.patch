+    void startDream(int groupId, int displayId);
+    void stopDream(int groupId, String reason);
+    boolean isDreaming(int groupId);
+
+    /** Calls into power must never call back into dreams while holding the power lock. */
+    interface Power {
+        void setDozeOverride(int groupId, int state, int reason, float brightness,
+                boolean useNormalBrightness);
+        void dreamStopped(int groupId);
+    }
+}
