+package com.android.systemui.recents;
+
+import android.os.Binder;
+import android.os.DeadObjectException;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import java.util.Objects;
+
+/** Revocable access to the real recents transition entry consumed by the official rear APK. */
+public final class OemRearRecentTasks extends Binder {
+    private static final String DESCRIPTOR = "com.android.wm.shell.recents.IRecentTasks";
+    private volatile IBinder mDelegate;
+    private final int mCallerUid;
+    private volatile boolean mActive = true;
+    private volatile boolean mSuspended;
+    private final Object mStateLock = new Object();
+
+    public OemRearRecentTasks(IBinder delegate, int callerUid) {
+        mDelegate = Objects.requireNonNull(delegate);
+        mCallerUid = callerUid;
+        attachInterface(null, DESCRIPTOR);
+    }
+
+    public void suspendDelegate() {
+        synchronized (mStateLock) {
+            mSuspended = true;
+        }
+    }
+
+    public void setDelegate(IBinder delegate) {
+        synchronized (mStateLock) {
+            if (!mActive) throw new IllegalStateException("Rear connection already revoked");
+            mDelegate = Objects.requireNonNull(delegate);
+            mSuspended = false;
+            mStateLock.notifyAll();
+        }
+    }
+
+    public void invalidate() {
+        synchronized (mStateLock) {
+            mActive = false;
+            mStateLock.notifyAll();
+        }
+    }
+
+    @Override
+    protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        if (code == INTERFACE_TRANSACTION) {
+            reply.writeString(DESCRIPTOR);
+            return true;
+        }
+        // startRecentsTransitionX has the platform's transaction 6 / six-argument layout.
+        // Do not expose listener registration: Shell has a single listener owned by main Launcher.
+        if (code != 6) return super.onTransact(code, data, reply, flags);
+        if (Binder.getCallingUid() != mCallerUid) {
+            throw new SecurityException("Caller is not the bound rear launcher");
+        }
+        synchronized (mStateLock) {
+            while (mActive && mSuspended) {
+                try {
+                    mStateLock.wait();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    throw new RemoteException("Interrupted waiting for rear Shell interface");
+                }
+            }
+            if (!mActive) throw new DeadObjectException("Rear launcher connection closed");
+            // Shell's oneway start entry posts to its executor without calling the runner here.
+            return mDelegate.transact(code, data, reply, flags);
+        }
+    }
+}
