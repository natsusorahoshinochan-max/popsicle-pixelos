+package com.android.systemui.recents;
+
+import android.Manifest;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.ServiceConnection;
+import android.content.pm.PackageManager;
+import android.content.pm.ServiceInfo;
+import android.hardware.display.DisplayManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.PatternMatcher;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.Display;
+import android.view.DisplayInfo;
+
+import java.io.PrintWriter;
+
+/** Main-thread owner of the official rear launcher's independent service connection. */
+public final class OemRearLauncherConnection {
+    private static final String TAG = "OemRearLauncher";
+    private static final String PACKAGE = "com.xiaomi.subscreencenter";
+    private static final ComponentName COMPONENT = new ComponentName(PACKAGE,
+            PACKAGE + ".gesture.TouchInteractionService");
+    private static final String LAUNCHER = "com.android.systemui.shared.recents.ILauncherProxy";
+    private static final String RECENTS = "com.android.wm.shell.recents.IRecentTasks";
+    private static final String TRANSITIONS = "com.android.wm.shell.shared.IShellTransitions";
+    private static final long BIND_TIMEOUT_MS = 10000;
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final DisplayManager mDisplays;
+    private final String mDisplayUniqueId;
+    private final Runnable mRetry = this::refresh;
+    private int mUserId;
+    private long mRetryDelay = 1000;
+    private IBinder mRecentTasks;
+    private IBinder mTransitions;
+    private Connection mConnection;
+    private OemRearRecentTasks mRecentAccess;
+    private OemRearShellTransitions mTransitionAccess;
+
+    public OemRearLauncherConnection(Context context, Handler handler, int userId,
+            String displayUniqueId) {
+        mContext = context;
+        mHandler = handler;
+        mUserId = userId;
+        mDisplayUniqueId = displayUniqueId;
+        mDisplays = context.getSystemService(DisplayManager.class);
+        if (!isConfigured()) return;
+        mDisplays.registerDisplayListener(new DisplayManager.DisplayListener() {
+            @Override public void onDisplayAdded(int displayId) { refresh(); }
+            @Override public void onDisplayChanged(int displayId) { refresh(); }
+            @Override public void onDisplayRemoved(int displayId) { refresh(); }
+        }, handler);
+        IntentFilter filter = new IntentFilter(Intent.ACTION_PACKAGE_ADDED);
+        filter.addAction(Intent.ACTION_PACKAGE_CHANGED);
+        filter.addAction(Intent.ACTION_PACKAGE_REPLACED);
+        filter.addAction(Intent.ACTION_PACKAGE_REMOVED);
+        filter.addDataScheme("package");
+        filter.addDataSchemeSpecificPart(PACKAGE, PatternMatcher.PATTERN_LITERAL);
+        context.registerReceiver(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                mRetryDelay = 1000;
+                refresh();
+            }
+        }, filter, null, handler, Context.RECEIVER_EXPORTED);
+    }
+
+    public boolean isConfigured() {
+        return !mDisplayUniqueId.isEmpty() && mDisplays != null;
+    }
+
+    public void setUser(int userId) {
+        if (mUserId != userId) {
+            disconnect();
+            mUserId = userId;
+            mRetryDelay = 1000;
+        }
+        refresh();
+    }
+
+    /** Pause access before replacing the shared facade, without removing live registrations. */
+    public void beforeShellInterfacesChanged() {
+        if (mRecentAccess != null) mRecentAccess.suspendDelegate();
+        if (mTransitionAccess != null) mTransitionAccess.suspendDelegate();
+        mRecentTasks = null;
+        mTransitions = null;
+    }
+
+    public void setShellInterfaces(Bundle interfaces) {
+        mRecentTasks = interfaces.getBinder(RECENTS);
+        mTransitions = interfaces.getBinder(TRANSITIONS);
+        if (mConnection != null && mConnection.service != null) initialize(mConnection);
+        refresh();
+    }
+
+    private boolean hasRearDisplay() {
+        if (!isConfigured()) return false;
+        for (Display display : mDisplays.getDisplays()) {
+            DisplayInfo info = new DisplayInfo();
+            if (display.getDisplayId() != Display.DEFAULT_DISPLAY && display.getDisplayInfo(info)
+                    && info.type == Display.TYPE_INTERNAL
+                    && mDisplayUniqueId.equals(info.uniqueId)) return true;
+        }
+        return false;
+    }
+
+    private ServiceInfo resolveService() {
+        try {
+            PackageManager pm = mContext.createContextAsUser(UserHandle.of(mUserId), 0)
+                    .getPackageManager();
+            ServiceInfo service = pm.getServiceInfo(COMPONENT,
+                    PackageManager.MATCH_DIRECT_BOOT_AWARE
+                            | PackageManager.MATCH_DIRECT_BOOT_UNAWARE);
+            if (!service.enabled || !service.applicationInfo.enabled || !service.exported
+                    || !service.applicationInfo.isSystemApp()
+                    || !Manifest.permission.STATUS_BAR_SERVICE.equals(service.permission)
+                    || pm.checkSignatures("android", PACKAGE) != PackageManager.SIGNATURE_MATCH) {
+                Log.w(TAG, "Official rear service does not meet the system identity contract");
+                return null;
+            }
+            return service;
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    public void refresh() {
+        mHandler.removeCallbacks(mRetry);
+        if (!hasRearDisplay() || mRecentTasks == null || mTransitions == null) {
+            disconnect();
+            return;
+        }
+        ServiceInfo service = resolveService();
+        if (service == null) {
+            disconnect();
+            return;
+        }
+        if (mConnection != null) {
+            if (mConnection.uid == service.applicationInfo.uid) return;
+            disconnect();
+        }
+        Connection connection = new Connection(service.applicationInfo.uid);
+        mConnection = connection;
+        try {
+            connection.bound = mContext.bindServiceAsUser(
+                    new Intent("android.intent.action.QUICKSTEP_SERVICE").setComponent(COMPONENT),
+                    connection, Context.BIND_AUTO_CREATE | Context.BIND_FOREGROUND_SERVICE_WHILE_AWAKE,
+                    UserHandle.of(mUserId));
+        } catch (SecurityException e) {
+            Log.w(TAG, "Rear service binding rejected", e);
+        }
+        if (connection.bound) mHandler.postDelayed(connection.timeout, BIND_TIMEOUT_MS);
+        else failed(connection, "bind failed");
+    }
+
+    private void initialize(Connection connection) {
+        if (mConnection != connection || mRecentTasks == null || mTransitions == null) return;
+        if (mRecentAccess == null) {
+            mRecentAccess = new OemRearRecentTasks(mRecentTasks, connection.uid);
+            mTransitionAccess = new OemRearShellTransitions(mTransitions, connection.uid);
+        } else {
+            // The APK retains its registration flag across onInitialize. Shell facade replacement
+            // does not remove its remote filters, so retain both registrations and wrapper identity.
+            mRecentAccess.setDelegate(mRecentTasks);
+            mTransitionAccess.setDelegate(mTransitions);
+        }
+        Bundle parameters = new Bundle();
+        parameters.putBinder(RECENTS, mRecentAccess);
+        parameters.putBinder(TRANSITIONS, mTransitionAccess);
+        Parcel data = Parcel.obtain(connection.service);
+        try {
+            // Both the original and platform ILauncherProxy define onInitialize as transaction 13.
+            data.writeInterfaceToken(LAUNCHER);
+            data.writeTypedObject(parameters, 0);
+            if (!connection.service.transact(13, data, null, IBinder.FLAG_ONEWAY)) {
+                throw new RemoteException("Rear launcher rejected onInitialize");
+            }
+            mRetryDelay = 1000;
+        } catch (RemoteException e) {
+            Log.w(TAG, "Rear initialization failed", e);
+            failed(connection, "initialization failed");
+        } finally {
+            data.recycle();
+        }
+    }
+
+    private void revokeAccess() {
+        if (mRecentAccess != null) mRecentAccess.invalidate();
+        if (mTransitionAccess != null) mTransitionAccess.invalidate();
+        mRecentAccess = null;
+        mTransitionAccess = null;
+    }
+
+    private void disconnect() {
+        mHandler.removeCallbacks(mRetry);
+        revokeAccess();
+        Connection old = mConnection;
+        mConnection = null;
+        if (old == null) return;
+        mHandler.removeCallbacks(old.timeout);
+        if (old.service != null) old.service.unlinkToDeath(old.death, 0);
+        if (old.bound) mContext.unbindService(old);
+    }
+
+    private void failed(Connection connection, String reason) {
+        if (connection != mConnection) return;
+        Log.w(TAG, "Rear connection lost: " + reason);
+        disconnect();
+        mHandler.postDelayed(mRetry, mRetryDelay);
+        mRetryDelay = Math.min(60000, mRetryDelay * 2);
+    }
+
+    public void dump(PrintWriter pw) {
+        pw.println("  rearLauncher: configured=" + isConfigured() + " user=" + mUserId
+                + " bound=" + (mConnection != null && mConnection.bound)
+                + " connected=" + (mConnection != null && mConnection.service != null)
+                + " shellReady=" + (mRecentTasks != null && mTransitions != null));
+    }
+
+    private final class Connection implements ServiceConnection {
+        final int uid;
+        boolean bound;
+        IBinder service;
+        final Runnable timeout = () -> failed(this, "binding timeout");
+        final IBinder.DeathRecipient death = () -> mHandler.post(() -> failed(this, "binder death"));
+
+        Connection(int uid) { this.uid = uid; }
+
+        @Override
+        public void onServiceConnected(ComponentName name, IBinder binder) {
+            if (mConnection != this) return;
+            mHandler.removeCallbacks(timeout);
+            try {
+                if (!COMPONENT.equals(name) || !LAUNCHER.equals(binder.getInterfaceDescriptor())) {
+                    throw new RemoteException("Unexpected rear service interface");
+                }
+                binder.linkToDeath(death, 0);
+                service = binder;
+                initialize(this);
+            } catch (RemoteException e) {
+                Log.w(TAG, "Rear service connection failed", e);
+                failed(this, "service interface failed");
+            }
+        }
+
+        @Override public void onServiceDisconnected(ComponentName name) {
+            failed(this, "service disconnected");
+        }
+        @Override public void onBindingDied(ComponentName name) { failed(this, "binding died"); }
+        @Override public void onNullBinding(ComponentName name) { failed(this, "null binding"); }
+    }
+}
