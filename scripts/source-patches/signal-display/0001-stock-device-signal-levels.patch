+package android.telephony;
+
+import android.os.Build;
+
+/** Device display policy, separate from the modem's reporting criteria. */
+final class DeviceSignalStrengthLevels {
+    // OS4.0.0.23.XPBCNXM cust_features.xml display arrays, not report arrays.
+    private static final int[] GSM = {-113, -103, -97, -91};
+    private static final int[] WCDMA = {-113, -105, -99, -91};
+    private static final int[] TDSCDMA = {-120, -110, -100, -90};
+    private static final int[] CDMA = {-109, -101, -97, -93};
+    private static final int[] RSRP = {-140, -120, -115, -105};
+
+    private DeviceSignalStrengthLevels() {}
+
+    static boolean isEnabled(ServiceState serviceState) {
+        return "popsicle".equals(Build.DEVICE)
+                && (serviceState == null || !serviceState.isUsingNonTerrestrialNetwork());
+    }
+
+    static int gsm(int rssi) {
+        return level(rssi, GSM, -113, -51);
+    }
+
+    static int wcdma(int rscp) {
+        return level(rscp, WCDMA, -120, -25);
+    }
+
+    static int tdscdma(int rscp) {
+        return level(rscp, TDSCDMA, -120, -25);
+    }
+
+    static int cdma(int dbm) {
+        return dbm == -1 ? CellSignalStrength.SIGNAL_STRENGTH_NONE_OR_UNKNOWN
+                : level(dbm, CDMA, -120, 0);
+    }
+
+    static int lte(int rsrp, int rssi, ServiceState serviceState) {
+        // Do not turn an unavailable measurement into a valid one by applying a boost.
+        long boosted = rsrp == CellInfo.UNAVAILABLE ? CellInfo.UNAVAILABLE
+                : (long) rsrp + (serviceState == null ? 0 : serviceState.getArfcnRsrpBoost());
+        if (boosted < -140 || boosted > -44) {
+            return gsm(rssi);
+        }
+        return level((int) boosted, RSRP, -140, -44);
+    }
+
+    static int nr(int ssRsrp) {
+        // Stock NR display uses SS-RSRP directly; its LTE-only boost is not applied here.
+        return level(ssRsrp, RSRP, -140, -44);
+    }
+
+    private static int level(int value, int[] thresholds, int min, int max) {
+        // Match the stock display boundary: the minimum itself is unknown/zero bars.
+        if (value == CellInfo.UNAVAILABLE || value <= min || value > max) {
+            return CellSignalStrength.SIGNAL_STRENGTH_NONE_OR_UNKNOWN;
+        }
+        int level = thresholds.length;
+        while (level > 0 && value < thresholds[level - 1]) {
+            level--;
+        }
+        return level;
+    }
+}
