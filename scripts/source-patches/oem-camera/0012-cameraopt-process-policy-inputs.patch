+package com.android.server.am;
+
+import android.os.Process;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Loads the ordinary-edition lists extracted from the matching original firmware. */
+final class OemProcessPolicyConfig {
+    static final File SYSTEM_CONFIG = new File("/system_ext/etc/popsicle-process-policy.json");
+
+    private OemProcessPolicyConfig() {}
+
+    static OemProcessProtectionState load(File file, boolean onePushEnabled)
+            throws IOException, JSONException {
+        JSONObject root = new JSONObject(Files.readString(file.toPath(), StandardCharsets.UTF_8));
+        if (!(root.get("format") instanceof Integer) || root.getInt("format") != 1) {
+            throw new JSONException("Unsupported process-policy format");
+        }
+        JSONObject arrays = root.getJSONObject("arrays");
+        List<String> packages = readList(arrays, "package_static_white_list_base");
+        packages.addAll(readList(arrays, "package_static_white_list"));
+        List<String> processes = readList(arrays, "process_static_white_list_base");
+        processes.addAll(readList(arrays, "process_static_white_list"));
+        List<String> secret = readList(arrays, "process_secretly_protect_list");
+        if (arrays.length() != 5) {
+            throw new JSONException("Expected only ordinary-edition process-policy arrays");
+        }
+        return new OemProcessProtectionState(packages, processes, secret, onePushEnabled,
+                Process.getTotalMemory());
+    }
+
+    private static List<String> readList(JSONObject arrays, String name) throws JSONException {
+        JSONArray values = arrays.getJSONArray(name);
+        List<String> result = new ArrayList<>(values.length());
+        for (int i = 0; i < values.length(); i++) {
+            Object value = values.get(i);
+            if (!(value instanceof String)) {
+                throw new JSONException("Expected process-policy string in " + name);
+            }
+            result.add((String) value);
+        }
+        return result;
+    }
+}
