+package com.android.server.am;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Mutable original process-protection lists; the caller supplies the real boot inputs. */
+final class OemProcessProtectionState {
+    private final Set<String> mStaticPackages;
+    private final Set<String> mStaticProcesses;
+    private final List<String> mSecretlyProtected;
+    private final Set<String> mOnePushBlocked = new HashSet<>();
+    private final boolean mOnePushEnabled;
+    private final List<String> mCloudWhiteList = new ArrayList<>();
+    private final Map<String, Integer> mAppProtectMap = new HashMap<>();
+    private final Map<String, Long> mFastBootAppMap = new HashMap<>();
+
+    OemProcessProtectionState(Collection<String> staticPackages,
+            Collection<String> staticProcesses, List<String> secretlyProtected,
+            boolean onePushEnabled, long totalMemoryBytes) {
+        mStaticPackages = new HashSet<>(staticPackages);
+        mStaticProcesses = new HashSet<>(staticProcesses);
+        mSecretlyProtected = new ArrayList<>(secretlyProtected);
+        mOnePushEnabled = onePushEnabled;
+        long memoryGiB = totalMemoryBytes / 0x40000000L;
+        long threshold = memoryGiB < 4 ? 0xc8000L
+                : memoryGiB < 8 ? 0x177000L : 0x1f4000L;
+        mFastBootAppMap.put("com.tencent.mm", threshold);
+        mFastBootAppMap.put("com.tencent.mobileqq", threshold);
+        for (String name : List.of("com.miui.bugreport", "com.miui.virtualsim",
+                "com.miui.touchassistant", "com.xiaomi.joyose", "com.miui.tsmclient",
+                "com.miui.powerkeeper", "com.miui.powerinsight")) {
+            mAppProtectMap.put(name, 3);
+        }
+        mAppProtectMap.put("com.xiaomi.bluetooth", 1);
+        mAppProtectMap.put("com.xiaomi.xmsf", 1);
+    }
+
+    synchronized List<String> getCloudWhiteList() {
+        return new ArrayList<>(mCloudWhiteList);
+    }
+
+    synchronized Integer getAppProtectionLevel(String packageName) {
+        return mAppProtectMap.get(packageName);
+    }
+
+    synchronized Long getFastBootThreshold(String packageName) {
+        return mFastBootAppMap.get(packageName);
+    }
+
+    /** Matches the original four updates in order, including partial state on failure. */
+    void updateCloudData(List<String> whiteList, Map<String, Integer> appProtectMap,
+            List<String> fastBootList, List<String> secretlyProtected) {
+        synchronized (this) {
+            mCloudWhiteList.clear();
+            if (whiteList != null) mCloudWhiteList.addAll(whiteList);
+        }
+        synchronized (this) {
+            mAppProtectMap.clear();
+            if (appProtectMap != null) mAppProtectMap.putAll(appProtectMap);
+        }
+        replaceFastBootList(fastBootList);
+        replaceSecretlyProtected(secretlyProtected);
+    }
+
+    private synchronized void replaceFastBootList(List<String> packages) {
+        if (packages == null || packages.isEmpty()) {
+            mFastBootAppMap.clear();
+        } else if (!mFastBootAppMap.keySet().equals(new HashSet<>(packages))) {
+            Map<String, Long> updated = new HashMap<>();
+            for (String packageName : packages) {
+                // Original unboxes the old value: an unknown package fails before replacement.
+                long threshold = mFastBootAppMap.get(packageName);
+                updated.put(packageName, threshold > 0 ? threshold : 0x1f400000L);
+            }
+            mFastBootAppMap.clear();
+            mFastBootAppMap.putAll(updated);
+        }
+    }
+
+    boolean isInStaticWhiteList(String processName, String packageName) {
+        return mStaticProcesses.contains(processName) || mStaticPackages.contains(packageName);
+    }
+
+    synchronized boolean isSecretlyProtected(String processName) {
+        return mSecretlyProtected.contains(processName);
+    }
+
+    synchronized boolean isOnePushBlocked(String processName) {
+        if (!mOnePushEnabled || processName == null) return false;
+        for (String packageName : mOnePushBlocked) {
+            // Original ProcessPolicy uses substring matching, not package equality.
+            if (processName.contains(packageName)) return true;
+        }
+        return false;
+    }
+
+    synchronized boolean shouldSkipLockedPromotion(String processName) {
+        return mSecretlyProtected.contains(processName) && !isOnePushBlocked(processName);
+    }
+
+    synchronized void replaceSecretlyProtected(List<String> processes) {
+        mSecretlyProtected.clear();
+        // Original null/empty cloud data clears the old list.
+        if (processes != null) mSecretlyProtected.addAll(processes);
+    }
+
+    /** Caller must perform the original live-process promotions for the returned names. */
+    synchronized List<String> setOnePushBlocked(String packageName, boolean blocked) {
+        List<String> affected = new ArrayList<>();
+        if (packageName == null) return affected;
+        if (blocked) {
+            mOnePushBlocked.add(packageName);
+        } else {
+            mOnePushBlocked.remove(packageName);
+        }
+        for (String processName : mSecretlyProtected) {
+            if (processName.contains(packageName)) affected.add(processName);
+        }
+        return affected;
+    }
+}
