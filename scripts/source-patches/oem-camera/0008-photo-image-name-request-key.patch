+package android.hardware.camera2;
+
+import android.hardware.camera2.impl.CameraMetadataNative;
+import android.util.Log;
+
+import java.util.Arrays;
+import java.util.List;
+
+/** Corrects the original camera's discovery of the verified popsicle photo-name request. */
+final class PopsicleCameraMetadataCompat {
+    private static final String TAG = "PopsicleCameraMetadata";
+    private static final String IMAGE_NAME = "xiaomi.snapshot.imageName";
+
+    private PopsicleCameraMetadataCompat() {}
+
+    static void apply(String device, String packageName, String cameraId,
+            CameraMetadataNative metadata) {
+        if (!"popsicle".equals(device) || !"com.android.camera".equals(packageName)
+                || !"5".equals(cameraId)) {
+            return;
+        }
+        int[] advertised = metadata.get(CameraCharacteristics.REQUEST_AVAILABLE_REQUEST_KEYS);
+        if (advertised == null) {
+            return;
+        }
+        List<?> vendorKeys = metadata.getAllVendorKeys(CaptureRequest.Key.class);
+        if (vendorKeys == null) {
+            return;
+        }
+        for (Object entry : vendorKeys) {
+            CaptureRequest.Key<?> key = (CaptureRequest.Key<?>) entry;
+            if (!IMAGE_NAME.equals(key.getName())) {
+                continue;
+            }
+            CameraMetadataNative.Key<?> nativeKey = key.getNativeKey();
+            if (nativeKey.getType() != byte[].class) {
+                Log.w(TAG, "Unexpected vendor type for " + IMAGE_NAME);
+                return;
+            }
+            int tag = CameraMetadataNative.getTag(IMAGE_NAME, nativeKey.getVendorId());
+            for (int existing : advertised) {
+                if (existing == tag) {
+                    return;
+                }
+            }
+            // The OEM HAL consumes this request but omits it from the advertised list.
+            // Only amend this client's metadata copy; never expose all descriptor keys.
+            int[] corrected = Arrays.copyOf(advertised, advertised.length + 1);
+            corrected[advertised.length] = tag;
+            metadata.set(CameraCharacteristics.REQUEST_AVAILABLE_REQUEST_KEYS, corrected);
+            Log.i(TAG, "Advertised " + IMAGE_NAME + " for camera " + cameraId);
+            return;
+        }
+    }
+}
