+
+package com.android.server.camera;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.hardware.display.DisplayManager;
+import android.os.Handler;
+import android.os.SystemProperties;
+import android.util.Slog;
+import android.view.Display;
+
+import com.android.internal.R;
+
+import org.json.JSONException;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/** Original CameraOpt binary entry backed by real WM events and vendor properties. */
+public final class CameraActivitySceneStub {
+    private static final String TAG = "CameraActivityScene";
+    public static final CameraActivitySceneStub sInstance = new CameraActivitySceneStub();
+
+    private final CameraActivityScenePolicy mPolicy = new CameraActivityScenePolicy(
+            new CameraActivityScenePolicy.Properties() {
+                public String get(String key, String fallback) {
+                    return SystemProperties.get(key, fallback);
+                }
+                public void set(String key, String value) {
+                    SystemProperties.set(key, value);
+                }
+            });
+    private volatile Handler mHandler;
+    private Context mContext;
+    private String mRearUniqueId;
+    private boolean mBooted;
+    private ComponentName mLastComponent;
+
+    private CameraActivitySceneStub() {}
+
+    public static CameraActivitySceneStub getInstance() {
+        return sInstance;
+    }
+
+    public static synchronized CameraActivitySceneStub initialize(Context context, Handler handler) {
+        if (sInstance.mHandler == null) {
+            sInstance.mContext = context;
+            sInstance.mRearUniqueId = context.getString(R.string.config_oemRearDisplayUniqueId);
+            // Queue initialization before publishing the handler or accepting WM snapshots.
+            handler.post(sInstance::bootOnHandler);
+            sInstance.mHandler = handler;
+        }
+        return sInstance;
+    }
+
+    public void initSystemBooted() {
+        handler().post(this::bootOnHandler);
+    }
+
+    private void bootOnHandler() {
+        if (mBooted) return;
+        mPolicy.reset();
+        readConfig("/system_ext/etc/camerascene.json");
+        readConfig("/odm/etc/camera/camerascene.json");
+        mBooted = true;
+    }
+
+    private void readConfig(String file) {
+        Path path = Path.of(file);
+        if (!Files.isRegularFile(path)) return;
+        try {
+            mPolicy.loadConfig(Files.readString(path));
+        } catch (IOException | JSONException e) {
+            Slog.e(TAG, "Cannot load camera scene config " + file, e);
+        }
+    }
+
+    private Handler handler() {
+        Handler handler = mHandler;
+        if (handler == null) throw new IllegalStateException("Camera scene service is not initialized");
+        return handler;
+    }
+
+    /** Snapshot supplied under the WM lock; no ActivityRecord retained or property I/O under it. */
+    public void onActivityStateChanged(String packageName, String activityName, int state,
+            boolean isRearDisplay) {
+        handler().post(() -> mPolicy.onActivityState(packageName, activityName, state, isRearDisplay));
+    }
+
+    /** Snapshot of the focused/resumed component, distinct from foreground package changes. */
+    public void onActivityChanged(ComponentName component) {
+        handler().post(() -> {
+            if (component != null && !component.equals(mLastComponent)) {
+                mLastComponent = component;
+                mPolicy.onActivityChanged(component.toString());
+            }
+        });
+    }
+
+    /** Original CameraOpt descriptor: (IILjava/lang/String;Ljava/lang/String;Ljava/lang/String;III)V. */
+    public void notifyActivityStateChange(int pid, int uid, String packageName,
+            String activityName, String processName, int id, int state, int displayId) {
+        handler(); // Fail explicitly if the original caller runs before platform initialization.
+        Display display = mContext.getSystemService(DisplayManager.class).getDisplay(displayId);
+        boolean rear = display != null && isRearDisplay(displayId, display.getType(),
+                display.getUniqueId());
+        onActivityStateChanged(packageName, activityName, state, rear);
+    }
+
+    public boolean isRearDisplay(int id, int type, String uniqueId) {
+        return id != Display.DEFAULT_DISPLAY && type == Display.TYPE_INTERNAL
+                && !mRearUniqueId.isEmpty() && mRearUniqueId.equals(uniqueId);
+    }
+}
