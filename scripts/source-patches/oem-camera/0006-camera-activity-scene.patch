+
+package com.android.server.camera;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** OEM camera scene contract. All state belongs to the service's single handler. */
+final class CameraActivityScenePolicy {
+    static final String VIDEO = "persist.vendor.vcb.video";
+    static final String SNAPSHOT = "persist.vendor.vcb.snapshot";
+    static final String ACTIVITY = "persist.vendor.vcb.activity";
+    static final String FACE = "persist.vendor.miface.registration.scenes";
+    static final String VIDEO_CALL = "persist.vendor.camera.3rdvideocall.scenes";
+    static final String HIGH_BLOB = "persist.vendor.camera.3rdhighResolutionBlob.scenes";
+    static final String LIVE = "persist.vendor.camera.3rdlive.scenes";
+    static final int RESUMED = 2;
+    private static final String WECHAT_VIDEO = "com.tencent.mm.plugin.voip.ui.VideoActivity";
+    private static final String WECHAT_MULTI = "com.tencent.mm.plugin.multitalk.ui.MultiTalkMainUI";
+
+    interface Properties {
+        String get(String key, String defaultValue);
+        void set(String key, String value);
+    }
+
+    private final Properties mProperties;
+    private final Map<String, List<String>> mConfig = new HashMap<>();
+    private boolean mIsVideocallResumed;
+
+    CameraActivityScenePolicy(Properties properties) {
+        mProperties = properties;
+    }
+
+    void reset() {
+        for (String key : new String[]{VIDEO, SNAPSHOT, FACE, VIDEO_CALL, HIGH_BLOB, LIVE}) {
+            mProperties.set(key, "false");
+        }
+        mProperties.set(ACTIVITY, "0");
+        mIsVideocallResumed = false;
+    }
+
+    // Default file first, then ODM: replace individual named lists, not the whole map.
+    // Completed entries survive a later malformed entry, as in the OEM parser.
+    void loadConfig(String content) throws JSONException {
+        if (content.isEmpty() || "default".equals(content)) return;
+        JSONObject root = new JSONObject(content);
+        if (!root.has("configs")) return;
+        JSONArray configs = root.getJSONArray("configs");
+        for (int i = 0; i < configs.length(); i++) {
+            JSONObject config = configs.optJSONObject(i);
+            if (config == null || !config.has("config")) continue;
+            JSONArray values = config.getJSONArray("config");
+            List<String> list = new ArrayList<>();
+            for (int j = 0; j < values.length(); j++) list.add(values.getString(j));
+            mConfig.put(config.optString("name"), list);
+        }
+    }
+
+    void onActivityChanged(String component) {
+        if (component != null && "false".equals(mProperties.get(VIDEO, "false"))
+                && isWechatVideo(component)) {
+            mProperties.set(VIDEO, "true");
+            mIsVideocallResumed = true;
+        }
+    }
+
+    void onActivityState(String packageName, String activityName, int state, boolean rear) {
+        if (packageName == null || activityName == null) return;
+        if (state != RESUMED) {
+            if (state > RESUMED && isWechatVideo(activityName) && mIsVideocallResumed) {
+                mIsVideocallResumed = false;
+            }
+            return;
+        }
+        mIsVideocallResumed = "true".equals(mProperties.get(VIDEO, "false"))
+                && (packageName.contains("com.xiaomi.subscreencenter")
+                    || rear || mIsVideocallResumed);
+        if (isWechatVideo(activityName)) mIsVideocallResumed = true;
+        setIfChanged(VIDEO, mIsVideocallResumed);
+        setIfChanged(SNAPSHOT,
+                activityName.contains("com.tencent.mm.plugin.recordvideo.activity.MMRecordUI"));
+        setIfChanged(FACE,
+                activityName.contains("com.android.settings.faceunlock.MiuiNormalCameraMultiFaceInput"));
+        boolean video = containsAny("videocall_list", activityName);
+        boolean high = !video && containsAny("highresolutionblob_list", activityName);
+        boolean live = !video && !high && containsAny("tplive_list", activityName);
+        setIfChanged(VIDEO_CALL, video);
+        setIfChanged(HIGH_BLOB, high);
+        setIfChanged(LIVE, live);
+    }
+
+    private static boolean isWechatVideo(String activity) {
+        return activity.contains(WECHAT_VIDEO) || activity.contains(WECHAT_MULTI);
+    }
+
+    private boolean containsAny(String listName, String activity) {
+        List<String> list = mConfig.get(listName);
+        if (list != null) {
+            for (String item : list) if (activity.contains(item)) return true;
+        }
+        return false;
+    }
+
+    private void setIfChanged(String key, boolean value) {
+        String next = Boolean.toString(value);
+        if (!next.equals(mProperties.get(key, "false"))) mProperties.set(key, next);
+    }
+}
