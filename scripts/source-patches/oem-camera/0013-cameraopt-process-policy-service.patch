+package com.android.server.am;
+
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.SystemProperties;
+
+import com.android.internal.os.BackgroundThread;
+import com.android.server.LocalServices;
+
+import org.json.JSONException;
+
+import java.io.IOException;
+
+/** AMS-owned process policy, delegated to by the already-published ProcessManager Binder. */
+public final class OemProcessPolicyBridge {
+    private final OemProcessLockTransactions mLocks;
+    private final OemProcessCloudTransactions mCloud;
+    private final OemProcessOnePushTransactions mOnePush;
+
+    private OemProcessPolicyBridge(ActivityManagerService service,
+            OemProcessProtectionState policy) {
+        OemLockedApplicationStore store = new OemLockedApplicationStore(
+                service.mContext.getContentResolver(), BackgroundThread.getHandler());
+        OemProcessLockTarget target = new OemProcessLockTarget(service, store, policy);
+        mLocks = new OemProcessLockTransactions(target);
+        mCloud = new OemProcessCloudTransactions(target);
+        mOnePush = new OemProcessOnePushTransactions(target);
+    }
+
+    static void systemReady(ActivityManagerService service) {
+        if (!service.mContext.getResources().getBoolean(
+                com.android.internal.R.bool.config_enableOemProcessPolicy)) return;
+        try {
+            OemProcessProtectionState policy = OemProcessPolicyConfig.load(
+                    OemProcessPolicyConfig.SYSTEM_CONFIG,
+                    SystemProperties.getBoolean("persist.sys.onepush_update_list", false));
+            LocalServices.addService(OemProcessPolicyBridge.class,
+                    new OemProcessPolicyBridge(service, policy));
+        } catch (IOException | JSONException e) {
+            throw new IllegalStateException("Cannot load required OEM process policy", e);
+        }
+    }
+
+    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        return mLocks.onTransact(code, data, reply, flags)
+                || mCloud.onTransact(code, data, reply, flags)
+                || mOnePush.onTransact(code, data, reply, flags);
+    }
+}
