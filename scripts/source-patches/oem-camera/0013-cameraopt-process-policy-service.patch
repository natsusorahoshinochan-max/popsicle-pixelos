+package com.android.server.am;
+
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import java.util.Objects;
+
+/** Original one-push transaction; the target owns gating, permissions and process effects. */
+public final class OemProcessOnePushTransactions {
+    public interface Target {
+        boolean onePushUpdateWhitelist(String packageName, boolean remove) throws RemoteException;
+    }
+
+    private final Target mTarget;
+
+    public OemProcessOnePushTransactions(Target target) {
+        mTarget = Objects.requireNonNull(target);
+    }
+
+    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        if (code != 36) return false;
+        if (reply == null || (flags & IBinder.FLAG_ONEWAY) != 0) {
+            throw new IllegalArgumentException("One-push updates require a synchronous transaction");
+        }
+        data.enforceInterface("miui.IProcessManager");
+        String packageName = data.readString();
+        boolean remove = data.readInt() != 0;
+        data.enforceNoDataAvail();
+        boolean success = mTarget.onePushUpdateWhitelist(packageName, remove);
+        reply.writeNoException();
+        reply.writeInt(success ? 1 : 0);
+        return true;
+    }
+}
