+package com.android.server.am;
+
+import android.os.BadParcelableException;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/** Original cloud transaction delegated by the existing ProcessManager Binder owner. */
+public final class OemProcessCloudTransactions {
+    private static final String DESCRIPTOR = "miui.IProcessManager";
+
+    /** Complete original wire input, including fields not consumed by ProcessPolicy. */
+    public static final class CloudData {
+        public final List<String> whiteList;
+        public final Map<String, Integer> appProtectMap;
+        public final Map<String, Integer> fgProtectMap;
+        public final List<String> fastBootList;
+        public final Map<String, Integer> cameraMemThresholdMap;
+        public final List<String> secretlyProtected;
+
+        private CloudData(Parcel data) {
+            whiteList = readList(data);
+            appProtectMap = readMap(data);
+            fgProtectMap = readMap(data);
+            fastBootList = readList(data);
+            cameraMemThresholdMap = readMap(data);
+            secretlyProtected = readList(data);
+        }
+    }
+
+    public interface Target {
+        void updateCloudData(CloudData data) throws RemoteException;
+    }
+
+    private final Target mTarget;
+
+    public OemProcessCloudTransactions(Target target) {
+        mTarget = Objects.requireNonNull(target);
+    }
+
+    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        if (code != 8) return false;
+        if (reply == null || (flags & IBinder.FLAG_ONEWAY) != 0) {
+            throw new IllegalArgumentException("Cloud updates require a synchronous transaction");
+        }
+        data.enforceInterface(DESCRIPTOR);
+        // Original Native calls CREATOR directly: there is no outer nullable-object marker.
+        CloudData cloud = new CloudData(data);
+        data.enforceNoDataAvail();
+        mTarget.updateCloudData(cloud);
+        reply.writeNoException();
+        return true;
+    }
+
+    private static List<String> readList(Parcel data) {
+        // Original ProcessCloudData writes a presence int followed by writeList, not strings.
+        return data.readInt() == 0 ? null
+                : data.readArrayList(List.class.getClassLoader(), String.class);
+    }
+
+    private static Map<String, Integer> readMap(Parcel data) {
+        int size = data.readInt();
+        // Even a null string key and its integer value require at least eight bytes.
+        if (size > data.dataAvail() / 8) {
+            throw new BadParcelableException("Truncated process cloud map");
+        }
+        Map<String, Integer> result = null;
+        for (int i = 0; i < size; i++) {
+            String key = data.readString();
+            int value = data.readInt();
+            if (result == null) result = new HashMap<>();
+            result.put(key, value);
+        }
+        return result;
+    }
+}
