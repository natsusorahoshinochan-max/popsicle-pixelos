+// The QTI encoder can explicitly negotiate length-prefixed HEVC output. The
+// stagefright writer accepts Annex-B input and builds its own MP4 NAL lengths.
+static bool hasLengthPrefixedHevc(const sp<AMessage>& format) {
+    AString mime;
+    int32_t lengthSize = 0;
+    return format->findString("mime", &mime) && mime == MEDIA_MIMETYPE_VIDEO_HEVC
+            && format->findInt32("vendor.qti-ext-enc-nal-length-bs.num-bytes", &lengthSize)
+            && lengthSize == 4;
+}
+
+static status_t hevcToAnnexB(const sp<ABuffer>& input, sp<ABuffer>* output) {
+    const uint8_t* data = input->data();
+    const size_t size = input->size();
+    if (size == 0 || data == nullptr) return BAD_VALUE;
+    // Validate the complete access unit before allocating or modifying anything.
+    for (size_t offset = 0; offset < size;) {
+        if (size - offset < 4) return BAD_VALUE;
+        const uint32_t length = (uint32_t(data[offset]) << 24)
+                | (uint32_t(data[offset + 1]) << 16)
+                | (uint32_t(data[offset + 2]) << 8) | data[offset + 3];
+        offset += 4;
+        if (length < 2 || length > size - offset) return BAD_VALUE;
+        offset += length;
+    }
+    sp<ABuffer> converted = new ABuffer(size);
+    if (converted->data() == nullptr) return NO_MEMORY;
+    memcpy(converted->data(), data, size);
+    for (size_t offset = 0; offset < size;) {
+        const uint32_t length = (uint32_t(data[offset]) << 24)
+                | (uint32_t(data[offset + 1]) << 16)
+                | (uint32_t(data[offset + 2]) << 8) | data[offset + 3];
+        memcpy(converted->data() + offset, "\x00\x00\x00\x01", 4);
+        offset += size_t(4) + length;
+    }
+    *output = converted;
+    return OK;
+}
