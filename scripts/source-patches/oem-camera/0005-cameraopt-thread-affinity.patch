+#pragma once
+
+#include <cerrno>
+#include <cstddef>
+#include <sched.h>
+#include <sys/types.h>
+
+namespace android::process {
+
+// Return the actual kernel error; never report an ignored request as successful.
+inline int setSchedAffinity(pid_t tid, const int* cpus, size_t count) {
+    if (tid <= 0 || cpus == nullptr || count == 0) return EINVAL;
+    cpu_set_t mask;
+    CPU_ZERO(&mask);
+    for (size_t i = 0; i < count; ++i) {
+        if (cpus[i] < 0 || cpus[i] >= CPU_SETSIZE) return EINVAL;
+        CPU_SET(cpus[i], &mask);
+    }
+    return sched_setaffinity(tid, sizeof(mask), &mask) == 0 ? 0 : errno;
+}
+
+} // namespace android::process
