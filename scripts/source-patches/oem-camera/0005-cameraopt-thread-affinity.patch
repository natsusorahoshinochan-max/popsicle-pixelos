+void android_os_Process_setSchedAffinity(JNIEnv* env, jobject clazz, jint tid, jintArray cpus) {
+    if (cpus == nullptr) {
+        jniThrowNullPointerException(env, "cpus must not be null");
+        return;
+    }
+    if (env->GetArrayLength(cpus) == 0) {
+        signalExceptionForError(env, EINVAL, tid);
+        return;
+    }
+    ScopedIntArrayRO indices(env, cpus);
+    if (indices.get() == nullptr) return; // Preserve a pending allocation exception.
+    const int error = android::process::setSchedAffinity(tid, indices.get(), indices.size());
+    if (error != 0) signalExceptionForError(env, error, tid);
 }
 
