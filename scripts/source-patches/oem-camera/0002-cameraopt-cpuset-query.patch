+// Keep OEM-only policy numbers local to this reader. They must not expand the
+// upstream policy arrays or change get_sched_policy()/set_sched_policy().
+static int get_camera_cpuset_policy_from_group(const std::string& group, SchedPolicy* policy) {
+    if (group == "audio-app") {
+        *policy = SP_AUDIO_APP;
+    } else if (group.find("camera-daemon") != std::string::npos) {
+        *policy = static_cast<SchedPolicy>(9);
+    } else if (group == "display") {
+        *policy = static_cast<SchedPolicy>(12);
+    } else if (group == "audio") {
+        *policy = static_cast<SchedPolicy>(13);
+    } else if (group == "touch") {
+        *policy = static_cast<SchedPolicy>(14);
+    } else if (group == "l-background") {
+        *policy = static_cast<SchedPolicy>(15);
+    } else {
+        return get_sched_policy_from_group(group, policy);
+    }
+    return 0;
+}
+
+int get_cpuset_policy(pid_t tid, SchedPolicy* policy) {
+    if (tid == 0) {
+        tid = GetThreadId();
+    }
+
+    std::string group;
+    if (cpusets_enabled()) {
+        if (getCGroupSubsys(tid, "cpuset", group) < 0) {
+            LOG(ERROR) << "Failed to find cpuset cgroup for tid " << tid;
+            return -1;
+        }
+        if (!group.empty()) {
+            if (get_camera_cpuset_policy_from_group(group, policy) == 0) {
+                return 0;
+            }
+            group.clear();
+        }
+    }
+    if (cpuctl_enabled() && getCGroupSubsys(tid, "cpu", group) < 0) {
+        LOG(ERROR) << "Failed to find cpu cgroup for tid " << tid;
+        return -1;
+    }
+    return get_camera_cpuset_policy_from_group(group, policy);
+}
