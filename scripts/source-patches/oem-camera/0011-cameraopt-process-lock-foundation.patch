+package com.android.server.am;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** User and default application locks used by the OEM process policy. */
+final class OemLockedApplicationState {
+    private static final int DEFAULT_USER = -100;
+
+    // This object's monitor protects every access. No caller receives a live collection.
+    private final Map<Integer, Set<String>> mLockedApps = new HashMap<>();
+
+    OemLockedApplicationState(Map<Integer, ? extends Collection<String>> restored) {
+        for (Map.Entry<Integer, ? extends Collection<String>> entry : restored.entrySet()) {
+            mLockedApps.put(entry.getKey(), new HashSet<>(entry.getValue()));
+        }
+        // The original systemReady adds these after loading locked_apps, including on reboot.
+        Set<String> defaults = mLockedApps.computeIfAbsent(DEFAULT_USER, user -> new HashSet<>());
+        defaults.add("com.jeejen.family.miui");
+        defaults.add("com.xiaomi.bsgamecenter");
+    }
+
+    synchronized boolean isLocked(String packageName, int userId) {
+        return contains(packageName, userId) || contains(packageName, DEFAULT_USER);
+    }
+
+    synchronized void setLocked(String packageName, int userId, boolean locked) {
+        Set<String> apps = mLockedApps.computeIfAbsent(userId, user -> new HashSet<>());
+        if (locked) {
+            apps.add(packageName);
+        } else {
+            apps.remove(packageName);
+            mLockedApps.get(DEFAULT_USER).remove(packageName);
+        }
+    }
+
+    synchronized List<String> getLockedApplications(int userId) {
+        List<String> result = new ArrayList<>();
+        Set<String> apps = mLockedApps.get(userId);
+        if (apps != null) {
+            result.addAll(apps);
+        }
+        // Preserve the original list concatenation, including a package in both sets.
+        result.addAll(mLockedApps.get(DEFAULT_USER));
+        return result;
+    }
+
+    /** A detached per-user snapshot for the original u/pkgs persistence format. */
+    synchronized Map<Integer, Set<String>> snapshot() {
+        Map<Integer, Set<String>> result = new HashMap<>();
+        for (Map.Entry<Integer, Set<String>> entry : mLockedApps.entrySet()) {
+            result.put(entry.getKey(), new HashSet<>(entry.getValue()));
+        }
+        return result;
+    }
+
+    private boolean contains(String packageName, int userId) {
+        Set<String> apps = mLockedApps.get(userId);
+        return apps != null && apps.contains(packageName);
+    }
+}
