+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.am;
+
+import com.android.internal.annotations.GuardedBy;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Predicate;
+
+import miui.process.ProcessManager;
+
+/** AMS operations behind the original process-lock transactions. */
+final class OemProcessLockTarget implements OemProcessLockTransactions.Target {
+    private final ActivityManagerService mService;
+    private final OemLockedApplicationStore mStore;
+    // The live policy must supply secretly-protected && !one-push-blocked, not a default value.
+    private final Predicate<String> mSkipLockedPromotion;
+
+    OemProcessLockTarget(ActivityManagerService service, OemLockedApplicationStore store,
+            Predicate<String> skipLockedPromotion) {
+        mService = Objects.requireNonNull(service);
+        mStore = Objects.requireNonNull(store);
+        mSkipLockedPromotion = Objects.requireNonNull(skipLockedPromotion);
+    }
+
+    @Override
+    public void updateApplicationLockedState(String packageName, int userId, boolean locked) {
+        OemProcessLockPermission.enforce(mService);
+        // The original first changes memory and posts its settings writer, then promotes.
+        mStore.setLocked(packageName, userId, locked);
+        synchronized (mService) {
+            ProcessRecord app = findProcessLocked(packageName, userId);
+            if (app != null) promoteLockedApp(app);
+        }
+    }
+
+    @Override
+    public List<String> getLockedApplication(int userId) {
+        return mStore.getLockedApplications(userId);
+    }
+
+    @Override
+    public boolean isLockedApplication(String packageName, int userId) {
+        return mStore.isLocked(packageName, userId);
+    }
+
+    @GuardedBy("mService")
+    private ProcessRecord findProcessLocked(String processName, int userId) {
+        ArrayList<ProcessRecord> processes = mService.mProcessList.getLruProcessesLOSP();
+        for (int i = processes.size() - 1; i >= 0; i--) {
+            ProcessRecord app = processes.get(i);
+            if (app.getThread() != null && app.userId == userId
+                    && app.processName.equals(processName)) {
+                return app;
+            }
+        }
+        return null;
+    }
+
+    @GuardedBy("mService")
+    void promoteLockedApp(ProcessRecord app) {
+        if (app.isPersistent() || mSkipLockedPromotion.test(app.processName)) return;
+        boolean locked = mStore.isLocked(app.processName, app.userId);
+        int adj = locked ? ProcessManager.LOCKED_MAX_ADJ : 1001;
+        int state = locked ? ProcessManager.LOCKED_MAX_PROCESS_STATE : 20;
+        int currentAdj = app.getMaxAdj();
+        if (locked ? currentAdj > adj : currentAdj < adj) {
+            mService.mProcessStateController.setMaxAdj(app, adj);
+        }
+        int currentState = IProcessPolicy.getAppMaxProcState(app);
+        if (locked ? currentState > state : currentState < state) {
+            IProcessPolicy.setAppMaxProcState(app, state);
+        }
+    }
+
+    /** Called under AMS's lock; CameraAdjAdjuster retains its own OOM update after this. */
+    @GuardedBy("mService")
+    void setProcessMaxAdjLock(int userId, ProcessRecord app, int maxAdj, int maxProcState) {
+        if (app == null) return;
+        if (maxAdj > ProcessManager.LOCKED_MAX_ADJ
+                && mStore.isLocked(app.getApplicationInfo().packageName, userId)) {
+            maxAdj = ProcessManager.LOCKED_MAX_ADJ;
+            maxProcState = ProcessManager.LOCKED_MAX_PROCESS_STATE;
+        }
+        mService.mProcessStateController.setMaxAdj(app, maxAdj);
+        IProcessPolicy.setAppMaxProcState(app, maxProcState);
+    }
+}
