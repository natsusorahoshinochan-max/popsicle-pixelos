+
+package com.android.server.am;
+
+import android.content.pm.ApplicationInfo;
+import android.os.Binder;
+import android.os.Process;
+
+/** The original ProcessManager mutation permission, using the real AMS PID map. */
+final class OemProcessLockPermission {
+    static void enforce(ActivityManagerService service) {
+        int uid = Binder.getCallingUid();
+        int pid = Binder.getCallingPid();
+        if (uid != Process.SHELL_UID) {
+            if (uid < Process.FIRST_APPLICATION_UID) return;
+            synchronized (service.mPidsSelfLocked) {
+                ProcessRecord app = service.mPidsSelfLocked.get(pid);
+                if (app != null) {
+                    ApplicationInfo info = app.getApplicationInfo();
+                    if (info != null && ((info.flags & (ApplicationInfo.FLAG_SYSTEM
+                            | ApplicationInfo.FLAG_UPDATED_SYSTEM_APP)) != 0
+                            || app.uid == Process.SYSTEM_UID)) {
+                        return;
+                    }
+                }
+            }
+        }
+        throw new SecurityException("ProcessManager.updateApplicationLockedState denied: pid="
+                + pid + ", uid=" + uid);
+    }
+
+    private OemProcessLockPermission() {}
+}
