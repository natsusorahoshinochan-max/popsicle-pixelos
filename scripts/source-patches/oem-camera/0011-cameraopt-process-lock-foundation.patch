+package com.android.server.am;
+
+import android.content.ContentResolver;
+import android.os.Handler;
+import android.provider.Settings;
+import android.util.Slog;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** The OEM locked_apps setting; process priority changes remain owned by AMS. */
+final class OemLockedApplicationStore {
+    static final String SETTING = "locked_apps";
+    private static final String TAG = "OemLockedApplications";
+
+    private final ContentResolver mResolver;
+    private final Handler mWriter;
+    private final OemLockedApplicationState mState;
+
+    /** Create at systemReady with the system resolver and BackgroundThread's handler. */
+    OemLockedApplicationStore(ContentResolver resolver, Handler writer) {
+        mResolver = resolver;
+        mWriter = writer;
+        mState = new OemLockedApplicationState(
+                decode(Settings.System.getString(mResolver, SETTING)));
+    }
+
+    boolean isLocked(String packageName, int userId) {
+        return mState.isLocked(packageName, userId);
+    }
+
+    List<String> getLockedApplications(int userId) {
+        return mState.getLockedApplications(userId);
+    }
+
+    /** Update memory and queue persistence before the caller promotes the live process. */
+    synchronized void setLocked(String packageName, int userId, boolean locked) {
+        mState.setLocked(packageName, userId, locked);
+        if (!mWriter.post(this::persist)) {
+            throw new IllegalStateException("Locked application writer is not accepting work");
+        }
+    }
+
+    private void persist() {
+        // Read at execution time, like the original BackgroundThread callback. All writes
+        // use this one handler, so an older queued update cannot overwrite a later write.
+        final String json = encode(mState.snapshot());
+        if (!Settings.System.putString(mResolver, SETTING, json)) {
+            Slog.e(TAG, "Failed to persist " + SETTING);
+        }
+    }
+
+    static Map<Integer, Set<String>> decode(String json) {
+        Map<Integer, Set<String>> result = new HashMap<>();
+        if (json == null || json.isEmpty()) return result;
+        try {
+            JSONArray users = new JSONArray(json);
+            for (int i = 0; i < users.length(); i++) {
+                JSONObject user = users.getJSONObject(i);
+                int userId = user.getInt("u");
+                JSONArray packages = user.getJSONArray("pkgs");
+                Set<String> names = new HashSet<>();
+                for (int j = 0; j < packages.length(); j++) {
+                    names.add(packages.getString(j));
+                }
+                result.put(userId, names);
+            }
+        } catch (JSONException e) {
+            // The original loader logs malformed data and retains already loaded users.
+            Slog.w(TAG, "Failed to load " + SETTING, e);
+        }
+        return result;
+    }
+
+    static String encode(Map<Integer, Set<String>> users) {
+        JSONArray result = new JSONArray();
+        try {
+            for (Map.Entry<Integer, Set<String>> entry : users.entrySet()) {
+                JSONObject user = new JSONObject();
+                user.put("u", entry.getKey());
+                user.put("pkgs", new JSONArray(entry.getValue()));
+                result.put(user);
+            }
+        } catch (JSONException e) {
+            throw new IllegalStateException("Unable to serialize locked applications", e);
+        }
+        return result.toString();
+    }
+}
