+
+package com.android.server.am;
+
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+import java.util.List;
+import java.util.Objects;
+
+/** Lock transactions delegated by the existing ProcessManager Binder owner. */
+public final class OemProcessLockTransactions {
+    private static final String DESCRIPTOR = "miui.IProcessManager";
+
+    /** The AMS implementation owns caller checks, storage and live process policy updates. */
+    public interface Target {
+        void updateApplicationLockedState(String packageName, int userId, boolean locked)
+                throws RemoteException;
+        List<String> getLockedApplication(int userId) throws RemoteException;
+        boolean isLockedApplication(String packageName, int userId) throws RemoteException;
+    }
+
+    private final Target mTarget;
+
+    public OemProcessLockTransactions(Target target) {
+        mTarget = Objects.requireNonNull(target);
+    }
+
+    /** Returns false for other transactions, including the owner's foreground listeners. */
+    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        if (code != 3 && code != 4 && code != 9) return false;
+        if (reply == null || (flags & IBinder.FLAG_ONEWAY) != 0) {
+            throw new IllegalArgumentException("Process locks require a synchronous transaction");
+        }
+        data.enforceInterface(DESCRIPTOR);
+        switch (code) {
+            case 3: {
+                String packageName = data.readString();
+                int userId = data.readInt();
+                boolean locked = data.readInt() != 0;
+                data.enforceNoDataAvail();
+                mTarget.updateApplicationLockedState(packageName, userId, locked);
+                reply.writeNoException();
+                return true;
+            }
+            case 4: {
+                int userId = data.readInt();
+                data.enforceNoDataAvail();
+                List<String> apps = mTarget.getLockedApplication(userId);
+                reply.writeNoException();
+                int count = apps == null ? -1 : apps.size();
+                reply.writeInt(count);
+                for (int i = 0; i < count; i++) {
+                    reply.writeString(apps.get(i));
+                }
+                return true;
+            }
+            case 9: {
+                String packageName = data.readString();
+                int userId = data.readInt();
+                data.enforceNoDataAvail();
+                boolean locked = mTarget.isLockedApplication(packageName, userId);
+                reply.writeNoException();
+                reply.writeInt(locked ? 1 : 0);
+                return true;
+            }
+            default:
+                throw new AssertionError(code);
+        }
+    }
+}
