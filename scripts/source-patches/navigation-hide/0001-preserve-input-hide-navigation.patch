+package com.android.systemui.navigationbar;
+
+import static android.view.WindowManagerPolicyConstants.NAV_BAR_MODE_GESTURAL;
+
+import android.content.Context;
+import android.content.om.IOverlayManager;
+import android.content.om.OverlayIdentifier;
+import android.content.om.OverlayInfo;
+import android.content.om.OverlayManagerTransaction;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.util.concurrent.Executor;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Supplier;
+
+/** Reconciles the per-user preference with the two preinstalled navigation overlays. */
+final class GestureNavigationVisibilityController {
+    private static final String TAG = "GestureNavVisibility";
+    private static final String REQUEST = "popsicle_hide_gesture_navigation";
+    private static final String APPLIED = "popsicle_hide_gesture_navigation_applied";
+    private static final String[] OVERLAYS = {
+            "org.pixelos.popsicle.navigation.framework",
+            "org.pixelos.popsicle.navigation.launcher"
+    };
+
+    private final IOverlayManager mOverlayManager;
+    private final Executor mExecutor;
+    private final Supplier<Context> mUserContext;
+    private final AtomicInteger mGeneration = new AtomicInteger();
+    private final Object mApplyLock = new Object();
+
+    GestureNavigationVisibilityController(Context context, IOverlayManager overlayManager,
+            Executor executor, Supplier<Context> userContext) {
+        mOverlayManager = overlayManager;
+        mExecutor = executor;
+        mUserContext = userContext;
+        context.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(REQUEST),
+                false, new ContentObserver(new Handler(Looper.getMainLooper())) {
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        onNavigationModeChanged(true);
+                    }
+                }, UserHandle.USER_ALL);
+    }
+
+    void onNavigationModeChanged() {
+        onNavigationModeChanged(false);
+    }
+
+    private void onNavigationModeChanged(boolean explicitRequest) {
+        final Context context = mUserContext.get();
+        final boolean hidden = context.getResources().getInteger(
+                com.android.internal.R.integer.config_navBarInteractionMode)
+                        == NAV_BAR_MODE_GESTURAL
+                && Settings.Secure.getInt(context.getContentResolver(), REQUEST, 0) == 1;
+        // Rollback broadcasts must not retry a failed request or cancel an explicit retry.
+        if (hidden && !explicitRequest
+                && Settings.Secure.getInt(context.getContentResolver(), APPLIED, 0) == -1) {
+            return;
+        }
+        final int generation = mGeneration.incrementAndGet();
+        mExecutor.execute(() -> {
+            synchronized (mApplyLock) {
+                if (generation != mGeneration.get()) {
+                    return;
+                }
+                if (hidden && !explicitRequest
+                        && Settings.Secure.getInt(context.getContentResolver(), APPLIED, 0) == -1) {
+                    return;
+                }
+                apply(context, hidden, generation);
+            }
+        });
+    }
+
+    private void apply(Context context, boolean hidden, int generation) {
+        final int userId = context.getUserId();
+        try {
+            // Restore application insets before restoring the visible handle.
+            if (!hidden && Settings.Secure.getInt(context.getContentResolver(), APPLIED, 0) == 1) {
+                Settings.Secure.putInt(context.getContentResolver(), APPLIED, 0);
+            }
+            final OverlayManagerTransaction.Builder transaction =
+                    new OverlayManagerTransaction.Builder();
+            boolean changed = false;
+            for (String name : OVERLAYS) {
+                final OverlayInfo info = mOverlayManager.getOverlayInfo(name, userId);
+                if (info == null || !info.isMutable) {
+                    throw new IllegalStateException("Missing mutable overlay " + name);
+                }
+                if (info.isEnabled() != hidden) {
+                    transaction.setEnabled(new OverlayIdentifier(name), hidden, userId);
+                    changed = true;
+                }
+            }
+            if (changed) {
+                mOverlayManager.commit(transaction.build());
+            }
+            for (String name : OVERLAYS) {
+                final OverlayInfo info = mOverlayManager.getOverlayInfo(name, userId);
+                if (info == null || info.isEnabled() != hidden) {
+                    throw new IllegalStateException("Overlay did not reach requested state " + name);
+                }
+            }
+            if (generation == mGeneration.get()) {
+                final int state = Settings.Secure.getInt(context.getContentResolver(), APPLIED, 0);
+                if (hidden || state != -1) {
+                    Settings.Secure.putInt(context.getContentResolver(), APPLIED, hidden ? 1 : 0);
+                }
+            }
+        } catch (RemoteException | RuntimeException e) {
+            if (generation != mGeneration.get()) {
+                return;
+            }
+            Log.e(TAG, "Unable to apply navigation visibility for user " + userId, e);
+            Settings.Secure.putInt(context.getContentResolver(), APPLIED, -1);
+            // Only Settings writes the request; a failed task must not cancel a newer retry.
+            // A partial external state must never be reported as hidden.
+            try {
+                final OverlayManagerTransaction.Builder rollback =
+                        new OverlayManagerTransaction.Builder();
+                for (String name : OVERLAYS) {
+                    if (mOverlayManager.getOverlayInfo(name, userId) != null) {
+                        rollback.setEnabled(new OverlayIdentifier(name), false, userId);
+                    }
+                }
+                mOverlayManager.commit(rollback.build());
+            } catch (RemoteException | RuntimeException rollbackError) {
+                Log.e(TAG, "Unable to restore navigation overlays for user " + userId,
+                        rollbackError);
+            }
+        }
+    }
+}
