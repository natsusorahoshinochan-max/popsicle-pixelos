+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.subscreen;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.Intent;
+import android.database.ContentObserver;
+import android.graphics.*;
+import android.media.ExifInterface;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.ParcelFileDescriptor;
+import android.view.MotionEvent;
+import android.view.View;
+import android.widget.*;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.SwitchPreferenceCompat;
+import com.android.settings.SettingsPreferenceFragment;
+import java.io.*;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Small Settings UI; the original rear application owns media, rendering and power. */
+public final class RearPersonalizationSettings extends SettingsPreferenceFragment {
+    private static final Uri ENDPOINT = Uri.parse("content://com.xiaomi.subscreencenter.personalization");
+    private static final int PICK_IMAGE = 61;
+    private static final int PICK_VIDEO = 62;
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private Context app;
+    private Preference media;
+    private Preference status;
+    private SwitchPreferenceCompat always;
+    private SwitchPreferenceCompat longPress;
+    private boolean busy;
+    private boolean refreshPending;
+    private boolean videoReady;
+    private final ContentObserver observer = new ContentObserver(ui) {
+        @Override public void onChange(boolean selfChange) {
+            if (busy) refreshPending = true;
+            else if (isResumed()) request("state", null);
+        }
+    };
+    private int width;
+    private int height;
+    private AlertDialog preview;
+    private VideoView videoView;
+
+    @Override public int getMetricsCategory() { return SettingsEnums.DISPLAY; }
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        app = requireContext().getApplicationContext();
+        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(requireContext());
+        screen.setTitle("背屏");
+        setPreferenceScreen(screen);
+        media = item("展示内容", "保留原背屏显示方式，选择自己的图片或视频", null);
+        item("选择图片", "预览、移动和缩放裁剪", () -> pick("image/*", PICK_IMAGE));
+        item("选择视频", "单段视频静音循环，最长边不超过 4096 像素，最大 256 MiB",
+                () -> pick("video/*", PICK_VIDEO));
+        item("恢复系统原有内容", "移除自选壁纸，保留其他原有背屏内容", () -> {
+            new AlertDialog.Builder(requireContext()).setMessage("恢复背屏原有内容？")
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .setPositiveButton(android.R.string.ok, (d, w) -> request("reset", null)).show();
+        });
+        always = toggle("背屏永不熄灭", "主屏关闭或锁定后继续展示；放入口袋时暂时熄屏。关闭后交回系统控制。", "always_on");
+        longPress = toggle("允许长按编辑", "允许在背屏长按进入壁纸或样式编辑", "long_press");
+        status = item("当前状态", "正在读取", null);
+        item("锁屏展示", "选中的素材会保存在背屏应用中，锁屏后仍可展示。", null);
+    }
+
+    private Preference item(String title, String summary, Runnable action) {
+        Preference preference = new Preference(requireContext());
+        preference.setTitle(title);
+        preference.setSummary(summary);
+        preference.setSelectable(action != null);
+        if (action != null) preference.setOnPreferenceClickListener(p -> { if (!busy) action.run(); return true; });
+        getPreferenceScreen().addPreference(preference);
+        return preference;
+    }
+
+    private SwitchPreferenceCompat toggle(String title, String summary, String key) {
+        SwitchPreferenceCompat preference = new SwitchPreferenceCompat(requireContext());
+        preference.setTitle(title);
+        preference.setSummary(summary);
+        preference.setPersistent(false);
+        preference.setOnPreferenceChangeListener((p, value) -> {
+            Bundle options = new Bundle();
+            options.putBoolean(key, (Boolean) value);
+            request("options", options);
+            return false;
+        });
+        getPreferenceScreen().addPreference(preference);
+        return preference;
+    }
+
+    @Override public void onResume() {
+        super.onResume();
+        app.getContentResolver().registerContentObserver(ENDPOINT, false, observer);
+        if (!busy) request("state", null);
+        else refreshPending = true;
+        if (videoView != null && videoReady) videoView.start();
+    }
+
+    @Override public void onPause() {
+        app.getContentResolver().unregisterContentObserver(observer);
+        super.onPause();
+    }
+
+    private void refreshIfPending() {
+        if (refreshPending && isResumed()) {
+            refreshPending = false;
+            ui.post(() -> { if (isAdded() && isResumed() && !busy) request("state", null); });
+        }
+    }
+
+    private Bundle call(String method, Bundle extras) throws IOException {
+        Bundle result = app.getContentResolver().call(ENDPOINT, method, null, extras);
+        if (result == null) throw new IOException("背屏服务未返回结果");
+        if (result.containsKey("error")) throw new IOException(result.getString("error"));
+        return result;
+    }
+
+    private void request(String method, Bundle extras) {
+        if (busy) return;
+        busy = true;
+        getPreferenceScreen().setEnabled(false);
+        status.setSummary("正在处理");
+        worker.execute(() -> {
+            try { Bundle result = call(method, extras); ui.post(() -> update(result)); }
+            catch (Exception e) { ui.post(() -> failed(e)); }
+        });
+    }
+
+    private void update(Bundle state) {
+        busy = false;
+        if (!isAdded()) return;
+        getPreferenceScreen().setEnabled(true);
+        width = state.getInt("width");
+        height = state.getInt("height");
+        always.setChecked(state.getBoolean("always_on"));
+        // An already-enabled setting must remain possible to turn off.
+        always.setEnabled(state.getBoolean("pocket") || always.isChecked());
+        longPress.setChecked(state.getBoolean("long_press", true));
+        media.setSummary(state.getString("media"));
+        String message = state.getString("status", "");
+        if (!state.getBoolean("pocket")) message = "背屏口袋传感器不可用，无法启用常亮";
+        status.setSummary(message.isEmpty() ? "配置已保存；实际显示由背屏服务处理" : message);
+        refreshIfPending();
+    }
+
+    private void failed(Exception error) {
+        busy = false;
+        if (!isAdded()) return;
+        getPreferenceScreen().setEnabled(true);
+        status.setSummary(error.getMessage() == null ? "操作失败" : error.getMessage());
+        Toast.makeText(requireContext(), status.getSummary(), Toast.LENGTH_LONG).show();
+        refreshIfPending();
+    }
+
+    private void pick(String type, int code) {
+        if (width <= 0 || height <= 0) { failed(new IOException("背屏尚未就绪")); return; }
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT).setType(type)
+                .addCategory(Intent.CATEGORY_OPENABLE)
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        startActivityForResult(intent, code);
+    }
+
+    @Override public void onActivityResult(int request, int result, Intent data) {
+        super.onActivityResult(request, result, data);
+        if (result != Activity.RESULT_OK || data == null || data.getData() == null) return;
+        if (request != PICK_IMAGE && request != PICK_VIDEO) return;
+        Uri uri = data.getData();
+        if (request == PICK_VIDEO) { previewVideo(uri); return; }
+        busy = true;
+        worker.execute(() -> {
+            try {
+                Bundle dimensions = call("state", null);
+                int targetWidth = dimensions.getInt("width");
+                int targetHeight = dimensions.getInt("height");
+                if (targetWidth <= 0 || targetHeight <= 0)
+                    throw new IOException("背屏尺寸尚未就绪，请重试");
+                BitmapFactory.Options options = new BitmapFactory.Options();
+                options.inJustDecodeBounds = true;
+                try (InputStream input = app.getContentResolver().openInputStream(uri)) {
+                    BitmapFactory.decodeStream(input, null, options);
+                }
+                if (options.outWidth <= 0 || options.outHeight <= 0) throw new IOException("无法读取图片");
+                options.inSampleSize = 1;
+                while (Math.max(options.outWidth, options.outHeight) / options.inSampleSize > 2048)
+                    options.inSampleSize *= 2;
+                options.inJustDecodeBounds = false;
+                Bitmap image;
+                try (InputStream input = app.getContentResolver().openInputStream(uri)) {
+                    image = BitmapFactory.decodeStream(input, null, options);
+                }
+                if (image == null) throw new IOException("无法解码图片");
+                int orientation = ExifInterface.ORIENTATION_NORMAL;
+                try (InputStream input = app.getContentResolver().openInputStream(uri)) {
+                    orientation = new ExifInterface(input).getAttributeInt(ExifInterface.TAG_ORIENTATION,
+                            ExifInterface.ORIENTATION_NORMAL);
+                } catch (IOException ignored) { /* Non-EXIF formats use decoded orientation. */ }
+                Matrix matrix = new Matrix();
+                switch (orientation) {
+                    case 2: matrix.setScale(-1, 1); break;
+                    case 3: matrix.setRotate(180); break;
+                    case 4: matrix.setScale(1, -1); break;
+                    case 5: matrix.setRotate(90); matrix.postScale(-1, 1); break;
+                    case 6: matrix.setRotate(90); break;
+                    case 7: matrix.setRotate(270); matrix.postScale(-1, 1); break;
+                    case 8: matrix.setRotate(270); break;
+                    default: break;
+                }
+                Bitmap oriented = Bitmap.createBitmap(image, 0, 0, image.getWidth(), image.getHeight(), matrix, true);
+                if (oriented != image) image.recycle();
+                ui.post(() -> {
+                    busy = false;
+                    if (isAdded()) {
+                        width = targetWidth;
+                        height = targetHeight;
+                        previewImage(oriented);
+                        refreshIfPending();
+                    } else oriented.recycle();
+                });
+            } catch (Exception e) { ui.post(() -> failed(e)); }
+        });
+    }
+
+    private void previewImage(Bitmap bitmap) {
+        CropView crop = new CropView(requireContext(), bitmap, width, height);
+        LinearLayout layout = new LinearLayout(requireContext());
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.addView(crop, new LinearLayout.LayoutParams(-1, (int) (320 * getResources().getDisplayMetrics().density)));
+        SeekBar zoom = new SeekBar(requireContext());
+        zoom.setMax(300);
+        zoom.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override public void onProgressChanged(SeekBar bar, int progress, boolean user) { crop.zoom = 1 + progress / 100f; crop.invalidate(); }
+            @Override public void onStartTrackingTouch(SeekBar bar) {}
+            @Override public void onStopTrackingTouch(SeekBar bar) {}
+        });
+        layout.addView(zoom);
+        preview = new AlertDialog.Builder(requireContext()).setTitle("拖动调整位置，滑动调整大小")
+                .setView(layout).setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton("应用", (d, w) -> {
+                    if (crop.targetWidth <= 0 || crop.targetHeight <= 0) {
+                        failed(new IOException("背屏尺寸无效，请重新选择图片"));
+                        return;
+                    }
+                    Bitmap result = crop.render();
+                    upload(null, result, false);
+                }).create();
+        preview.setOnDismissListener(d -> bitmap.recycle());
+        preview.show();
+    }
+
+    private void previewVideo(Uri uri) {
+        videoReady = false;
+        videoView = new VideoView(requireContext());
+        videoView.setVideoURI(uri);
+        final VideoView player = videoView;
+        preview = new AlertDialog.Builder(requireContext()).setTitle("视频预览 · 静音循环")
+                .setView(player).setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton("应用", (d, w) -> upload(uri, null, true)).create();
+        preview.setOnDismissListener(d -> { player.stopPlayback(); videoView = null; videoReady = false; });
+        player.setOnPreparedListener(media -> {
+            media.setLooping(true);
+            media.setVolume(0, 0);
+            videoReady = true;
+            if (isResumed()) player.start();
+            preview.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(true);
+        });
+        player.setOnErrorListener((media, what, extra) -> {
+            videoReady = false;
+            if (preview != null) preview.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(false);
+            status.setSummary("无法播放此视频，请选择设备支持的格式");
+            return true;
+        });
+        preview.show();
+        preview.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(false);
+    }
+
+    private void upload(Uri uri, Bitmap image, boolean video) {
+        busy = true;
+        getPreferenceScreen().setEnabled(false);
+        status.setSummary("正在保存素材");
+        worker.execute(() -> {
+            File temporary = null;
+            try {
+                if (image != null) {
+                    temporary = File.createTempFile("rear-", ".png", app.getCacheDir());
+                    try (OutputStream output = new FileOutputStream(temporary)) {
+                        if (!image.compress(Bitmap.CompressFormat.PNG, 100, output)) throw new IOException("无法保存图片");
+                    } finally { image.recycle(); }
+                }
+                try (ParcelFileDescriptor file = video ? app.getContentResolver().openFileDescriptor(uri, "r")
+                        : ParcelFileDescriptor.open(temporary, ParcelFileDescriptor.MODE_READ_ONLY)) {
+                    Bundle extras = new Bundle(); extras.putParcelable("file", file); extras.putBoolean("video", video);
+                    Bundle result = call("import", extras);
+                    ui.post(() -> update(result));
+                }
+            } catch (Exception e) { ui.post(() -> failed(e)); }
+            finally { if (temporary != null) temporary.delete(); }
+        });
+    }
+
+    @Override public void onStop() {
+        if (videoView != null) videoView.pause();
+        super.onStop();
+    }
+    @Override public void onDestroy() {
+        if (preview != null) preview.dismiss();
+        worker.shutdown();
+        super.onDestroy();
+    }
+
+    private static final class CropView extends View {
+        final Bitmap image;
+        final int targetWidth, targetHeight;
+        final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+        float zoom = 1, offsetX, offsetY, previousX, previousY;
+        CropView(Context context, Bitmap image, int width, int height) {
+            super(context); this.image = image; targetWidth = width; targetHeight = height;
+        }
+        private void drawImage(Canvas canvas, int width, int height) {
+            float scale = Math.max((float) width / image.getWidth(), (float) height / image.getHeight()) * zoom;
+            float x = (width - image.getWidth() * scale) / 2 + offsetX * width;
+            float y = (height - image.getHeight() * scale) / 2 + offsetY * height;
+            x = Math.max(width - image.getWidth() * scale, Math.min(0, x));
+            y = Math.max(height - image.getHeight() * scale, Math.min(0, y));
+            canvas.drawBitmap(image, null, new RectF(x, y, x + image.getWidth() * scale,
+                    y + image.getHeight() * scale), paint);
+        }
+        @Override protected void onDraw(Canvas canvas) {
+            canvas.drawColor(Color.BLACK);
+            float scale = Math.min((float) getWidth() / targetWidth, (float) getHeight() / targetHeight);
+            canvas.save();
+            canvas.translate((getWidth() - targetWidth * scale) / 2, (getHeight() - targetHeight * scale) / 2);
+            canvas.scale(scale, scale); canvas.clipRect(0, 0, targetWidth, targetHeight);
+            drawImage(canvas, targetWidth, targetHeight); canvas.restore();
+        }
+        @Override public boolean onTouchEvent(MotionEvent event) {
+            if (event.getActionMasked() == MotionEvent.ACTION_MOVE) {
+                float scale = Math.min((float) getWidth() / targetWidth, (float) getHeight() / targetHeight);
+                offsetX += (event.getX() - previousX) / (targetWidth * scale);
+                offsetY += (event.getY() - previousY) / (targetHeight * scale);
+                invalidate();
+            }
+            previousX = event.getX(); previousY = event.getY(); return true;
+        }
+        Bitmap render() {
+            Bitmap result = Bitmap.createBitmap(targetWidth, targetHeight, Bitmap.Config.ARGB_8888);
+            drawImage(new Canvas(result), targetWidth, targetHeight); return result;
+        }
+    }
+}
