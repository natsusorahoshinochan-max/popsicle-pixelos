+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <camera/CameraMetadata.h>
+#include <camera/VendorTagDescriptor.h>
+#include <system/graphics.h>
+
+namespace android::camera3::xiaomi {
+
+inline camera_metadata_ro_entry_t findVendorEntry(const CameraMetadata& info, const char* name) {
+    sp<VendorTagDescriptor> descriptor;
+    auto cache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+    if (cache != nullptr) {
+        cache->getVendorTagDescriptor(info.getVendorId(), &descriptor);
+    }
+    uint32_t tag;
+    if (CameraMetadata::getTagFromName(name, descriptor.get(), &tag) != OK) return {};
+    return info.find(tag);
+}
+
+inline bool containsOutput(camera_metadata_ro_entry_t entry, int32_t format,
+        int32_t width, int32_t height) {
+    if (entry.type != TYPE_INT32 || entry.count % 4 != 0 || width <= 0 || height <= 0) {
+        return false;
+    }
+    for (size_t i = 0; i < entry.count; i += 4) {
+        const int32_t* tuple = entry.data.i32 + i;
+        if (tuple[0] == format && tuple[1] == width && tuple[2] == height &&
+                tuple[3] == ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT) return true;
+    }
+    return false;
+}
+
+inline bool containsVendorOutput(const CameraMetadata& info, int32_t format,
+        int32_t width, int32_t height) {
+    auto entry = findVendorEntry(info, "xiaomi.scaler.availableStreamConfigurations");
+    if (entry.count == 0) {
+        entry = findVendorEntry(info, "com.xiaomi.scaler.availableStreamConfigurations");
+    }
+    return containsOutput(entry, format, width, height);
+}
+
+inline bool preserveDimensions(const CameraMetadata& info, int32_t format,
+        int32_t width, int32_t height, bool isXiaomiCameraClient) {
+    auto role = findVendorEntry(info, "com.xiaomi.cameraid.role.cameraId");
+    const bool isMock = role.type == TYPE_INT32 && role.count == 1 && role.data.i32[0] == 108;
+    // Mock cameras are SYSTEM_CAMERA devices; service permission checks still apply.
+    // Unlike the OEM's unconditional Mock bypass, accept only advertised output tuples.
+    if (isMock && (containsOutput(info.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS),
+                    format, width, height) ||
+            containsOutput(info.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_MAXIMUM_RESOLUTION),
+                    format, width, height))) return true;
+    return (isMock || isXiaomiCameraClient) && containsVendorOutput(info, format, width, height);
+}
+
+} // namespace android::camera3::xiaomi
