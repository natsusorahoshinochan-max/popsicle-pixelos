diff --git a/build/soong/popsicle_policy.go b/build/soong/popsicle_policy.go
new file mode 100644
index 0000000..74d8de6
--- /dev/null
+++ b/build/soong/popsicle_policy.go
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: Apache-2.0
+package selinux
+
+import (
+	"android/soong/android"
+	"github.com/google/blueprint/proptools"
+)
+
+func init() {
+	android.RegisterModuleType("popsicle_oem_policy", popsiclePolicyFactory)
+}
+
+// The source-root raw images are private, byte-verified copies of the official
+// inputs. No generated vendor image or installed vendor policy is a dependency.
+type popsiclePolicyProperties struct {
+	Stock_vendor *string
+	Stock_odm    *string
+	Codec_source *string `android:"path"`
+	Inputs       []struct {
+		Name string
+		Src  string `android:"path"`
+	}
+}
+
+type popsiclePolicy struct {
+	android.ModuleBase
+	properties popsiclePolicyProperties
+}
+
+func popsiclePolicyFactory() android.Module {
+	m := &popsiclePolicy{}
+	m.AddProperties(&m.properties)
+	android.InitAndroidArchModule(m, android.DeviceSupported, android.MultilibCommon)
+	return m
+}
+
+func (m *popsiclePolicy) DepsMutator(ctx android.BottomUpMutatorContext) {
+	ctx.AddHostToolDependencies("popsicle_derive_vendor", "popsicle_erofs_readback", "secilc")
+}
+
+var popsiclePolicyInputNames = []string{
+	"plat", "plat-map", "plat-compat", "system-ext", "system-ext-map",
+	"system-ext-compat", "product", "product-map", "genfs",
+	"plat-hash", "system-ext-hash", "product-hash",
+}
+
+var popsiclePolicyOutputNames = []string{
+	"vendor_sepolicy.cil",
+	"plat_pub_versioned.cil",
+	"strict-inputs.cil",
+	"strict-policy",
+	"plat_sepolicy_vers.txt",
+	"genfs_labels_version.txt",
+	"selinux_denial_metadata",
+	"vendor_file_contexts",
+	"vendor_hwservice_contexts",
+	"vendor_keystore2_key_contexts",
+	"vendor_mac_permissions.xml",
+	"vendor_property_contexts",
+	"vendor_seapp_contexts",
+	"vendor_service_contexts",
+	"vendor_tee_service_contexts",
+	"vndservice_contexts",
+	"odm_sepolicy.cil",
+	"odm_file_contexts",
+	"odm_hwservice_contexts",
+	"odm_mac_permissions.xml",
+	"odm_property_contexts",
+	"odm_seapp_contexts",
+	"odm_service_contexts",
+	"precompiled_sepolicy",
+	"precompiled_sepolicy.plat_sepolicy_and_mapping.sha256",
+	"precompiled_sepolicy.system_ext_sepolicy_and_mapping.sha256",
+	"precompiled_sepolicy.product_sepolicy_and_mapping.sha256",
+}
+
+func (m *popsiclePolicy) GenerateAndroidBuildActions(ctx android.ModuleContext) {
+	if !ctx.Config().VendorConfig("popsicle").Bool("managed_vendor_policy") ||
+		ctx.Config().Eng() || ctx.Config().SelinuxIgnoreNeverallows() {
+		ctx.ModuleErrorf("managed OEM policy requires explicit user/userdebug opt-in and strict neverallows")
+		return
+	}
+	for _, entry := range []struct{ property, value, expected string }{
+		{"stock_vendor", proptools.String(m.properties.Stock_vendor), "vendor/xiaomi/popsicle-private/prebuilt/firmware-a17/vendor.img"},
+		{"stock_odm", proptools.String(m.properties.Stock_odm), "vendor/xiaomi/popsicle-private/prebuilt/firmware-a17/odm.img"},
+	} {
+		if entry.value != entry.expected {
+			ctx.PropertyErrorf(entry.property, "must select the declared official private image")
+			return
+		}
+	}
+	inputs := make(map[string]android.Path)
+	for _, input := range m.properties.Inputs {
+		if !android.InList(input.Name, popsiclePolicyInputNames) || inputs[input.Name] != nil {
+			ctx.PropertyErrorf("inputs", "unknown or duplicate policy input %q", input.Name)
+			return
+		}
+		inputs[input.Name] = android.PathForModuleSrc(ctx, input.Src)
+	}
+	if len(inputs) != len(popsiclePolicyInputNames) {
+		ctx.PropertyErrorf("inputs", "the complete platform, mapping, compat and hash contract is required")
+		return
+	}
+	root := pathForModuleOut(ctx, "policy")
+	workspace := pathForModuleOut(ctx, "work")
+	rule := android.NewRuleBuilder(pctx, ctx)
+	rule.SandboxDisabled()
+	rule.Command().Text("mkdir -p").Text(workspace.String()).Text(pathForModuleOut(ctx).String())
+	variant := "user"
+	if ctx.Config().Debuggable() {
+		variant = "userdebug"
+	}
+	cmd := rule.Command().BuiltTool("popsicle_derive_vendor").Text("policy").
+		FlagWithArg("--build-variant ", variant).
+		Flag("--reader").BuiltTool("popsicle_erofs_readback").
+		FlagWithInput("--stock ", android.PathForSource(ctx, *m.properties.Stock_vendor)).
+		FlagWithArg("--output ", root.String()).
+		FlagWithArg("--policy-input workspace=", workspace.String()).
+		FlagWithInput("--policy-input odm-stock=", android.PathForSource(ctx, *m.properties.Stock_odm)).
+		FlagWithInput("--policy-input secilc=", ctx.Config().HostToolPath(ctx, "secilc")).
+		FlagWithInput("--policy-input m4=", ctx.Config().PrebuiltBuildTool(ctx, "m4")).
+		FlagWithInput("--policy-input macros=", android.PathForSource(ctx, "system/sepolicy/public/te_macros")).
+		FlagWithInput("--policy-input global-macros=", android.PathForSource(ctx, "system/sepolicy/public/global_macros")).
+		FlagWithInput("--policy-input codec-source=", android.PathForModuleSrc(ctx, proptools.String(m.properties.Codec_source)))
+	for _, name := range popsiclePolicyInputNames {
+		cmd.FlagWithInput("--policy-input "+name+"=", inputs[name])
+	}
+	for _, name := range popsiclePolicyOutputNames {
+		out := root.Join(ctx, name)
+		cmd.ImplicitOutput(out)
+		ctx.SetOutputFiles(android.Paths{out}, name)
+	}
+	rule.Build("managed_oem_policy", "Derive and strictly compile complete OEM policy")
+}
+
+// These properties select a proven bundle output without accepting arbitrary
+// replacement CIL. Other products retain their existing generation rules.
+func popsicleVerifiedSource(ctx android.ModuleContext, property string,
+	value proptools.Configurable[string]) android.Path {
+	source := value.GetOrDefault(ctx, "")
+	if source == "" {
+		return nil
+	}
+	name := ctx.ModuleName()
+	if name == "vendor_bug_map" {
+		name = "selinux_denial_metadata"
+	}
+	if !android.InList(name, popsiclePolicyOutputNames) {
+		ctx.PropertyErrorf(property, "unsupported managed OEM policy consumer")
+		return nil
+	}
+	expected := ":popsicle_managed_vendor_policy{" + name + "}"
+	if !ctx.Config().VendorConfig("popsicle").Bool("managed_vendor_policy") || source != expected {
+		ctx.PropertyErrorf(property, "must select the matching verified OEM policy bundle output")
+		return nil
+	}
+	return android.PathForModuleSrc(ctx, source)
+}
