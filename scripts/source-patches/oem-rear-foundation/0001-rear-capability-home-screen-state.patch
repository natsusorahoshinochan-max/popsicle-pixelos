+import android.compat.annotation.UnsupportedAppUsage;
+import android.content.res.Resources;
+
+import com.android.internal.R;
+import com.android.internal.display.OemRearDisplay;
+
+/**
+ * Device-declared rear-assistant capability used by the official App.
+ * @hide
+ */
+public final class DeviceFeature {
+    private DeviceFeature() {}
+
+    @UnsupportedAppUsage
+    public static boolean isSupportRearSmartAssistant() {
