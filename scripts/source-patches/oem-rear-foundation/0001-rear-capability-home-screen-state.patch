+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.wm;
+
+import android.os.Handler;
+import android.os.RemoteCallbackList;
+import android.os.RemoteException;
+import android.util.Slog;
+import android.view.IScreenStateListener;
+
+/** Serializes registrations and real rear screen-off events outside WM/display locks. */
+final class OemScreenStateController {
+    private final Handler mHandler;
+    private final RemoteCallbackList<IScreenStateListener> mListeners = new RemoteCallbackList<>();
+
+    OemScreenStateController(Handler handler) { mHandler = handler; }
+
+    void register(IScreenStateListener listener) {
+        if (listener != null) mHandler.post(() -> mListeners.register(listener));
+    }
+
+    void unregister(IScreenStateListener listener) {
+        if (listener != null) mHandler.post(() -> mListeners.unregister(listener));
+    }
+
+    void screenTurningOff(int displayId) {
+        mHandler.post(() -> {
+            int count = mListeners.beginBroadcast();
+            try {
+                for (int i = 0; i < count; i++) {
+                    try {
+                        mListeners.getBroadcastItem(i).onScreenTurningOff(displayId);
+                    } catch (RemoteException | RuntimeException e) {
+                        Slog.w("OemScreenState", "Screen state listener failed", e);
+                    }
+                }
+            } finally {
+                mListeners.finishBroadcast();
+            }
+        });
+    }
+}
