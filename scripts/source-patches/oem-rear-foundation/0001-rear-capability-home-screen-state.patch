+
+package com.android.internal.display;
+
+import android.content.res.Resources;
+import android.view.Display;
+import android.view.DisplayInfo;
+
+import com.android.internal.R;
+
+/** Device configuration for the dedicated built-in rear display. */
+public final class OemRearDisplay {
+    private OemRearDisplay() {}
+
+    public static boolean isConfigured(Resources resources) {
+        return !resources.getString(R.string.config_oemRearDisplayUniqueId).isEmpty();
+    }
+
+    public static boolean isRearDisplay(Resources resources, DisplayInfo info) {
+        return info != null && info.type == Display.TYPE_INTERNAL
+                && info.displayId != Display.DEFAULT_DISPLAY && isConfigured(resources)
+                && resources.getString(R.string.config_oemRearDisplayUniqueId).equals(info.uniqueId);
+    }
+}
