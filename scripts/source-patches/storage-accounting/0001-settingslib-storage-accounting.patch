+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settingslib.deviceinfo;
+
+import android.app.AppGlobals;
+import android.app.usage.StorageStatsManager;
+import android.os.Environment;
+import android.os.storage.StorageManager;
+
+import java.io.IOException;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Keeps internal-storage totals usable for subtraction from filesystem sizes. */
+public final class StorageAccounting {
+    private StorageAccounting() {}
+
+    public static long getTotalBytes(StorageStatsManager stats, UUID volumeUuid)
+            throws IOException {
+        final long advertisedBytes = stats.getTotalBytes(volumeUuid);
+        return StorageManager.UUID_DEFAULT.equals(volumeUuid)
+                ? getInternalTotalBytes(advertisedBytes) : advertisedBytes;
+    }
+
+    public static long getTotalBytes(StorageStatsManager stats, String volumeUuid)
+            throws IOException {
+        final long advertisedBytes = stats.getTotalBytes(volumeUuid);
+        return Objects.equals(StorageManager.UUID_PRIVATE_INTERNAL, volumeUuid)
+                ? getInternalTotalBytes(advertisedBytes) : advertisedBytes;
+    }
+
+    private static long getInternalTotalBytes(long advertisedBytes) throws IOException {
+        final long dataBytes = Environment.getDataDirectory().getTotalSpace();
+        if (dataBytes <= 0) {
+            throw new IOException("Internal storage filesystem size is unavailable");
+        }
+        if (advertisedBytes >= dataBytes) {
+            return advertisedBytes;
+        }
+
+        // The retail-size API can round below /data. Use vold's actual capacity
+        // for every Settings consumer instead of subtracting unlike totals.
+        final long physicalBytes;
+        try {
+            final StorageManager storage = AppGlobals.getInitialApplication()
+                    .getSystemService(StorageManager.class);
+            physicalBytes = storage.getInternalStorageBlockDeviceSize();
+        } catch (RuntimeException e) {
+            throw new IOException("Cannot obtain internal storage device size", e);
+        }
+        if (physicalBytes < dataBytes) {
+            throw new IOException("Internal storage device is smaller than its filesystem");
+        }
+        return physicalBytes;
+    }
+}
