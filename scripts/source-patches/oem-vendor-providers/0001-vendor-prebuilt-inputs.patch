diff --git a/android/prebuilt.go b/android/prebuilt.go
--- a/android/prebuilt.go
+++ b/android/prebuilt.go
@@ -574,6 +574,18 @@
 // prebuiltProviderMutator sets the PrebuiltInfoProvider.
 func prebuiltProviderMutator(ctx BottomUpMutatorContext) {
 	m := ctx.Module()
+	if m.IsReplacedByPrebuilt() {
+		// Selection precedes module-specific variants. A shared-only prebuilt,
+		// for example, is disabled for the later static variant. Keep that
+		// source variant, without undoing any explicit HideFromMake reason.
+		replaced := false
+		ctx.visitDirectDepsWithTag(PrebuiltDepTag, func(prebuilt Module) {
+			if p := GetEmbeddedPrebuilt(prebuilt); p != nil && p.UsePrebuilt() {
+				replaced = true
+			}
+		})
+		m.base().commonProperties.ReplacedByPrebuilt = replaced
+	}
 
 	info := PrebuiltInfo{}
 
