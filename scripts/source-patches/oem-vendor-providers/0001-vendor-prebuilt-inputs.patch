+func (t dependencyTag) ReplaceSourceWithPrebuilt() bool {
+	// These refer to the source library's own objects and variant metadata,
+	// even when a prebuilt replaces that static library for other consumers.
+	return t != reuseObjTag && t != staticVariantTag
+}
