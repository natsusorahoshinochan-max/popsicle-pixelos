+package miui.process;
+
+import android.compat.annotation.UnsupportedAppUsage;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/** Wire-compatible foreground snapshot used by the official camera and rear display. @hide */
+public final class ForegroundInfo implements Parcelable {
+    @UnsupportedAppUsage
+    public static final int FLAG_FOREGROUND_COLD_START = 1;
+
+    @UnsupportedAppUsage
+    public String mForegroundPackageName;
+    @UnsupportedAppUsage
+    public int mForegroundUid = -1;
+    @UnsupportedAppUsage
+    public int mForegroundPid = -1;
+    @UnsupportedAppUsage
+    public int mForegroundDisplayId = -1;
+    @UnsupportedAppUsage
+    public String mLastForegroundPackageName;
+    @UnsupportedAppUsage
+    public int mLastForegroundUid = -1;
+    @UnsupportedAppUsage
+    public int mLastForegroundPid = -1;
+    @UnsupportedAppUsage
+    public int mLastForegroundDisplayId = -1;
+    @UnsupportedAppUsage
+    public String mMultiWindowForegroundPackageName;
+    @UnsupportedAppUsage
+    public int mMultiWindowForegroundUid = -1;
+    @UnsupportedAppUsage
+    public int mFlags;
+
+    @UnsupportedAppUsage
+    public ForegroundInfo() {}
+
+    @UnsupportedAppUsage
+    public ForegroundInfo(ForegroundInfo other) {
+        mForegroundPackageName = other.mForegroundPackageName;
+        mForegroundUid = other.mForegroundUid;
+        mForegroundPid = other.mForegroundPid;
+        mForegroundDisplayId = other.mForegroundDisplayId;
+        mLastForegroundPackageName = other.mLastForegroundPackageName;
+        mLastForegroundUid = other.mLastForegroundUid;
+        mLastForegroundPid = other.mLastForegroundPid;
+        mLastForegroundDisplayId = other.mLastForegroundDisplayId;
+        mMultiWindowForegroundPackageName = other.mMultiWindowForegroundPackageName;
+        mMultiWindowForegroundUid = other.mMultiWindowForegroundUid;
+        mFlags = other.mFlags;
+    }
+
+    private ForegroundInfo(Parcel in) {
+        mForegroundPackageName = in.readString();
+        mForegroundUid = in.readInt();
+        mForegroundPid = in.readInt();
+        mForegroundDisplayId = in.readInt();
+        mLastForegroundPackageName = in.readString();
+        mLastForegroundUid = in.readInt();
+        mLastForegroundPid = in.readInt();
+        mLastForegroundDisplayId = in.readInt();
+        mMultiWindowForegroundPackageName = in.readString();
+        mMultiWindowForegroundUid = in.readInt();
+        mFlags = in.readInt();
+    }
+
+    @Override
+    public void writeToParcel(Parcel out, int flags) {
+        out.writeString(mForegroundPackageName);
+        out.writeInt(mForegroundUid);
+        out.writeInt(mForegroundPid);
+        out.writeInt(mForegroundDisplayId);
+        out.writeString(mLastForegroundPackageName);
+        out.writeInt(mLastForegroundUid);
+        out.writeInt(mLastForegroundPid);
+        out.writeInt(mLastForegroundDisplayId);
+        out.writeString(mMultiWindowForegroundPackageName);
+        out.writeInt(mMultiWindowForegroundUid);
+        out.writeInt(mFlags);
+    }
+
+    @Override
+    public int describeContents() { return 0; }
+
+    @UnsupportedAppUsage
+    public boolean isColdStart() { return (mFlags & FLAG_FOREGROUND_COLD_START) != 0; }
+
+    @UnsupportedAppUsage
+    public void addFlags(int flags) { mFlags |= flags; }
+
+    @UnsupportedAppUsage
+    public void resetFlags() { mFlags = 0; }
+
+    @UnsupportedAppUsage
+    public static final Creator<ForegroundInfo> CREATOR = new Creator<ForegroundInfo>() {
+        @Override
+        public ForegroundInfo createFromParcel(Parcel in) { return new ForegroundInfo(in); }
+
+        @Override
+        public ForegroundInfo[] newArray(int size) { return new ForegroundInfo[size]; }
+    };
+}
