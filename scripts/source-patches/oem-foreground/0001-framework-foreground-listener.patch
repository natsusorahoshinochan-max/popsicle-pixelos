+
+package miui.process;
+
+import android.compat.annotation.UnsupportedAppUsage;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+
+/** Original oneway callback protocol. @hide */
+public interface IForegroundInfoListener extends IInterface {
+    @UnsupportedAppUsage
+    void onForegroundInfoChanged(ForegroundInfo info) throws RemoteException;
+
+    /** @hide */
+    abstract class Stub extends Binder implements IForegroundInfoListener {
+        private static final String DESCRIPTOR = "miui.process.IForegroundInfoListener";
+
+        @UnsupportedAppUsage
+        public Stub() { attachInterface(this, DESCRIPTOR); }
+
+        @UnsupportedAppUsage
+        public static IForegroundInfoListener asInterface(IBinder binder) {
+            if (binder == null) return null;
+            IInterface local = binder.queryLocalInterface(DESCRIPTOR);
+            return local instanceof IForegroundInfoListener
+                    ? (IForegroundInfoListener) local : new Proxy(binder);
+        }
+
+        @Override
+        public IBinder asBinder() { return this; }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            if (code == INTERFACE_TRANSACTION) {
+                reply.writeString(DESCRIPTOR);
+                return true;
+            }
+            if (code == FIRST_CALL_TRANSACTION) {
+                data.enforceInterface(DESCRIPTOR);
+                ForegroundInfo info = data.readTypedObject(ForegroundInfo.CREATOR);
+                data.enforceNoDataAvail();
+                onForegroundInfoChanged(info);
+                return true;
+            }
+            return super.onTransact(code, data, reply, flags);
+        }
+
+        private static final class Proxy implements IForegroundInfoListener {
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) { mRemote = remote; }
+
+            @Override
+            public IBinder asBinder() { return mRemote; }
+
+            @Override
+            public void onForegroundInfoChanged(ForegroundInfo info) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeTypedObject(info, 0);
+                    if (!mRemote.transact(FIRST_CALL_TRANSACTION, data, null, FLAG_ONEWAY)) {
+                        throw new RemoteException("Foreground callback transaction unsupported");
+                    }
+                } finally {
+                    data.recycle();
+                }
+            }
+        }
+    }
+}
