+ * limitations under the License.
+ */
+
+package miui.process;
+
+import android.compat.annotation.UnsupportedAppUsage;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+/** Narrow original entry point; no process-management operations are emulated. @hide */
+public final class ProcessManager {
+    private ProcessManager() {}
+
+    @UnsupportedAppUsage
+    public static void registerForegroundInfoListener(IForegroundInfoListener listener) {
+        transactListener(10, listener);
+    }
+
+    @UnsupportedAppUsage
+    public static void unregisterForegroundInfoListener(IForegroundInfoListener listener) {
+        transactListener(11, listener);
+    }
+
+    private static void transactListener(int code, IForegroundInfoListener listener) {
+        if (listener == null) return;
+        IBinder service = ServiceManager.getService("ProcessManager");
+        if (service == null) throw new IllegalStateException("ProcessManager unavailable");
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken("miui.IProcessManager");
+            data.writeStrongInterface(listener);
+            if (!service.transact(code, data, reply, 0)) {
+                throw new IllegalStateException("Foreground listener transaction unsupported");
+            }
+            reply.readException();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+}
