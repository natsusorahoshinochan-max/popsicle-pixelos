diff --git a/services/core/java/com/android/server/wm/OemForegroundInfoController.java b/services/core/java/com/android/server/wm/OemForegroundInfoController.java
new file mode 100644
--- /dev/null
+++ b/services/core/java/com/android/server/wm/OemForegroundInfoController.java
@@ -0,0 +1,165 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.wm;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.Parcel;
+import android.os.Process;
+import android.os.RemoteCallbackList;
+import android.os.RemoteException;
+import android.util.Slog;
+
+import com.android.internal.annotations.GuardedBy;
+import com.android.internal.annotations.VisibleForTesting;
+
+import java.util.Objects;
+
+import miui.process.ForegroundInfo;
+import miui.process.IForegroundInfoListener;
+
+/** Supplies the official Apps' foreground listener protocol from real WM state. */
+final class OemForegroundInfoController extends Binder {
+    private static final String TAG = "OemForegroundInfo";
+    private static final String DESCRIPTOR = "miui.IProcessManager";
+    private final Context mContext;
+    private final Handler mHandler;
+    // Registration and delivery share this handler. RemoteCallbackList owns Binder death cleanup.
+    private final RemoteCallbackList<IForegroundInfoListener> mListeners =
+            new RemoteCallbackList<>();
+    @GuardedBy("WindowManagerService.mGlobalLock")
+    private ForegroundInfo mLastInfo = new ForegroundInfo();
+
+    OemForegroundInfoController(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+        attachInterface(null, DESCRIPTOR);
+    }
+
+    @Override
+    public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+            throws RemoteException {
+        if (code == INTERFACE_TRANSACTION) {
+            if (reply != null) reply.writeString(DESCRIPTOR);
+            return true;
+        }
+        if (code != 10 && code != 11) return super.onTransact(code, data, reply, flags);
+        data.enforceInterface(DESCRIPTOR);
+        if (reply == null) {
+            throw new IllegalArgumentException("Listener registration requires a synchronous call");
+        }
+        enforceCaller();
+        IForegroundInfoListener listener =
+                IForegroundInfoListener.Stub.asInterface(data.readStrongBinder());
+        data.enforceNoDataAvail();
+        if (listener != null) {
+            mHandler.post(() -> {
+                if (code == 10) {
+                    mListeners.register(listener);
+                } else {
+                    mListeners.unregister(listener);
+                }
+            });
+        }
+        reply.writeNoException();
+        return true;
+    }
+
+    private void enforceCaller() {
+        final int uid = Binder.getCallingUid();
+        if (uid == Process.SYSTEM_UID || uid == Process.ROOT_UID) return;
+        PackageManager pm = mContext.getPackageManager();
+        if (pm.checkSignatures(uid, Process.SYSTEM_UID) == PackageManager.SIGNATURE_MATCH) {
+            String[] packages = pm.getPackagesForUid(uid);
+            if (packages != null) {
+                for (String name : packages) {
+                    if ("com.android.camera".equals(name)
+                            || "com.xiaomi.subscreencenter".equals(name)) return;
+                }
+            }
+        }
+        throw new SecurityException("Foreground listener requires an approved platform-signed App");
+    }
+
+    /** Called with the WM lock; never retain ActivityRecord or send callbacks under that lock. */
+    void onActivityResumedLocked(ActivityRecord activity, boolean coldStart) {
+        if (activity == null || activity.app == null || !activity.isAttached()
+                || activity.app.getPid() <= 0
+                || activity.mAtmService.getTransitionController().isTransientCollect(activity)) return;
+        final Task focused = activity.mAtmService.mRootWindowContainer
+                .getTopDisplayFocusedRootTask();
+        final ActivityRecord multiWindow = focused != null
+                ? focused.topRunningActivity() : null;
+        ForegroundInfo next = new ForegroundInfo();
+        next.mForegroundPackageName = activity.packageName;
+        next.mForegroundUid = activity.getUid();
+        next.mForegroundPid = activity.app.getPid();
+        next.mForegroundDisplayId = activity.getDisplayId();
+        // This field is the top focused task's Activity even outside split screen in the OEM.
+        if (multiWindow != null) {
+            next.mMultiWindowForegroundPackageName = multiWindow.packageName;
+            next.mMultiWindowForegroundUid = multiWindow.getUid();
+        }
+        if (coldStart) next.addFlags(ForegroundInfo.FLAG_FOREGROUND_COLD_START);
+        enqueueSnapshotLocked(next);
+    }
+
+    /** Recompute after focus, reparent or task removal; sleep alone is not an empty App event. */
+    void onFocusedActivityChangedLocked(ActivityTaskManagerService service) {
+        if (service.mRootWindowContainer == null) return;
+        Task focused = service.mRootWindowContainer.getTopDisplayFocusedRootTask();
+        ActivityRecord resumed = focused != null ? focused.getTopResumedActivity() : null;
+        onActivityResumedLocked(resumed, false);
+    }
+
+    @VisibleForTesting
+    void enqueueSnapshotLocked(ForegroundInfo next) {
+        if (Objects.equals(next.mForegroundPackageName, mLastInfo.mForegroundPackageName)
+                && next.mForegroundUid == mLastInfo.mForegroundUid
+                && next.mForegroundPid == mLastInfo.mForegroundPid
+                && next.mForegroundDisplayId == mLastInfo.mForegroundDisplayId
+                && Objects.equals(next.mMultiWindowForegroundPackageName,
+                        mLastInfo.mMultiWindowForegroundPackageName)
+                && next.mMultiWindowForegroundUid == mLastInfo.mMultiWindowForegroundUid) return;
+        next.mLastForegroundPackageName = mLastInfo.mForegroundPackageName;
+        next.mLastForegroundUid = mLastInfo.mForegroundUid;
+        next.mLastForegroundPid = mLastInfo.mForegroundPid;
+        next.mLastForegroundDisplayId = mLastInfo.mForegroundDisplayId;
+        mLastInfo = new ForegroundInfo(next);
+        final ForegroundInfo snapshot = new ForegroundInfo(next);
+        mHandler.post(() -> dispatch(snapshot));
+    }
+
+    private void dispatch(ForegroundInfo snapshot) {
+        final int count = mListeners.beginBroadcast();
+        try {
+            for (int i = 0; i < count; i++) {
+                try {
+                    // Isolate local listeners as well as remote Parcel recipients.
+                    mListeners.getBroadcastItem(i).onForegroundInfoChanged(
+                            new ForegroundInfo(snapshot));
+                } catch (RemoteException | RuntimeException e) {
+                    Slog.w(TAG, "Foreground listener failed", e);
+                }
+            }
+        } finally {
+            mListeners.finishBroadcast();
+        }
+    }
+}
